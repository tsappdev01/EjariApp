

@page "/zone-paragraphs"

@attribute [Authorize(DIPPermissions.ZoneParagraphs.Default)]
@using DIP.ZoneParagraphs
@using DIP.Localization
@using DIP.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Components.Web
@using Blazorise
@using Blazorise.Components
@using Blazorise.DataGrid
@using Volo.Abp.BlazoriseUI
@using Volo.Abp.BlazoriseUI.Components
@using Volo.Abp.ObjectMapping
@using Volo.Abp.AspNetCore.Components.Messages
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout
@using DIP.Permissions
@using Microsoft.AspNetCore.Components
@using Volo.Abp.AspNetCore.Components.Web
@using Volo.Abp.Http.Client
@inherits DIPComponentBase
@inject IZoneParagraphsAppService ZoneParagraphsAppService
@inject IUiMessageService UiMessageService
@inject IRemoteServiceConfigurationProvider RemoteServiceConfigurationProvider
@inject NavigationManager NavigationManager

@* ************************* PAGE HEADER ************************* *@
<PageHeader Title="@L["ZoneParagraphs"]" BreadcrumbItems="BreadcrumbItems" Toolbar="Toolbar">

</PageHeader>

@* ************************* SEARCH ************************* *@
<Card>
    <CardBody>
        <Form id="ZoneParagraphSearchForm" class="mb-3">
            <Addons>
                <Addon AddonType="AddonType.Body">
                    <TextEdit @bind-Text="@Filter.FilterText"
                              Autofocus="true"
                              Placeholder="@L["Search"]">
                    </TextEdit>
                </Addon>
                <Addon AddonType="AddonType.End">
                    <SubmitButton Form="ZoneParagraphSearchForm" Clicked="GetZoneParagraphsAsync">
                        <Icon Name="IconName.Search" Class="me-1"></Icon>@L["Search"]
                    </SubmitButton>
                </Addon>
            </Addons>
        </Form>
    </CardBody>
</Card>

@* ************************* DATA GRID ************************* *@
<Card>
    <CardBody>
        <DataGrid TItem="ZoneParagraphWithNavigationPropertiesDto"
                  Data="ZoneParagraphList"
                  ReadData="OnDataGridReadAsync"
                  TotalItems="TotalCount"
                  ShowPager="true"
                  Responsive="true"
                  PageSize="PageSize">
            <DataGridColumns>
                <DataGridEntityActionsColumn TItem="ZoneParagraphWithNavigationPropertiesDto" @ref="@EntityActionsColumn">
                    <DisplayTemplate>
                        <EntityActions TItem="ZoneParagraphWithNavigationPropertiesDto" EntityActionsColumn="@EntityActionsColumn">
                            <EntityAction TItem="ZoneParagraphWithNavigationPropertiesDto"
                                          Visible="@CanEditZoneParagraph"
                                          Clicked="async () => await OpenEditZoneParagraphModalAsync(context)"
                                          Text="@L["Edit"]"></EntityAction>
                            <EntityAction TItem="ZoneParagraphWithNavigationPropertiesDto"
                                          Visible="@CanDeleteZoneParagraph"
                                          Clicked="() => DeleteZoneParagraphAsync(context)"
                                          ConfirmationMessage="@(()=> L["DeleteConfirmationMessage"])"
                                          Text="@L["Delete"]"></EntityAction>
                        </EntityActions>
                    </DisplayTemplate>
                </DataGridEntityActionsColumn>
               
              <DataGridColumn TItem="ZoneParagraphWithNavigationPropertiesDto"
                      Field="ZoneParagraph.TitleEn"
                      Caption="@L["TitleEn"]">
              </DataGridColumn>

              <DataGridColumn TItem="ZoneParagraphWithNavigationPropertiesDto"
                      Field="ZoneParagraph.TitleAr"
                      Caption="@L["TitleAr"]">
              </DataGridColumn>

              <DataGridColumn TItem="ZoneParagraphWithNavigationPropertiesDto"
                      Field="ZoneParagraph.SubTilteEn"
                      Caption="@L["SubTilteEn"]">
              </DataGridColumn>

              <DataGridColumn TItem="ZoneParagraphWithNavigationPropertiesDto"
                      Field="ZoneParagraph.SubTitleAr"
                      Caption="@L["SubTitleAr"]">
              </DataGridColumn>

              <DataGridColumn TItem="ZoneParagraphWithNavigationPropertiesDto"
                      Field="ZoneParagraph.DescriptionEn"
                      Caption="@L["DescriptionEn"]">
              </DataGridColumn>

              <DataGridColumn TItem="ZoneParagraphWithNavigationPropertiesDto"
                      Field="ZoneParagraph.DescriptionAr"
                      Caption="@L["DescriptionAr"]">
              </DataGridColumn>

              <DataGridColumn TItem="ZoneParagraphWithNavigationPropertiesDto"
                      Field="ZoneParagraph.Order"
                      Caption="@L["Order"]">
              </DataGridColumn>

              <DataGridColumn TItem="ZoneParagraphWithNavigationPropertiesDto"
                      Field="ZoneParagraph.IsActive"
                      Caption="@L["IsActive"]">
                    <DisplayTemplate>
                        @if (context.ZoneParagraph.IsActive)
                        {
                            <Icon TextColor="TextColor.Success" Name="@IconName.Check" />
                        }
                        else
                        {
                            <Icon TextColor="TextColor.Danger" Name="@IconName.Times" />
                        }
                    </DisplayTemplate>
              </DataGridColumn>


              <DataGridColumn TItem="ZoneParagraphWithNavigationPropertiesDto"
                      Field="Zone.TitleEn"
                      Caption="@L["Zone"]">
              </DataGridColumn>

            </DataGridColumns>
        </DataGrid>
    </CardBody>
</Card>

@* ************************* CREATE MODAL ************************* *@
<Modal @ref="CreateZoneParagraphModal" Closing="@CreateZoneParagraphModal.CancelClosingModalWhenFocusLost">
    <ModalContent Centered="true">
        <Form id="CreateZoneParagraphForm">
            <ModalHeader>
                <ModalTitle>@L["NewZoneParagraph"]</ModalTitle>
                <CloseButton Clicked="CloseCreateZoneParagraphModalAsync" />
            </ModalHeader>
            <ModalBody>
                <Validations @ref="@NewZoneParagraphValidations"
                            Mode="ValidationMode.Auto"
                            Model="@NewZoneParagraph"
                            ValidateOnLoad="false">
                     
                    
                    <Validation>
                        <Field>
                            <FieldLabel>@L["TitleEn"] *</FieldLabel>
                            <TextEdit @bind-Text="@NewZoneParagraph.TitleEn" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["TitleAr"] *</FieldLabel>
                            <TextEdit @bind-Text="@NewZoneParagraph.TitleAr" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["SubTilteEn"]</FieldLabel>
                            <TextEdit @bind-Text="@NewZoneParagraph.SubTilteEn" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["SubTitleAr"]</FieldLabel>
                            <TextEdit @bind-Text="@NewZoneParagraph.SubTitleAr" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["DescriptionEn"]</FieldLabel>
                            <TextEdit @bind-Text="@NewZoneParagraph.DescriptionEn" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["DescriptionAr"]</FieldLabel>
                            <TextEdit @bind-Text="@NewZoneParagraph.DescriptionAr" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["Order"]</FieldLabel>
                            <NumericPicker TValue="int" @bind-Value="@NewZoneParagraph.Order"  Decimals="0">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                             </NumericPicker>
                        </Field>
                     </Validation>


                    <Field>
                        <Check TValue="bool" @bind-Checked="@NewZoneParagraph.IsActive">@L["IsActive"]</Check>
                    </Field>

                    <Field>
                        <FieldLabel>@L["Zone"] *</FieldLabel>
                        <Autocomplete Data="@ZonesCollection"
                                      TItem="LookupDto<Guid>"
                                      TValue="Guid"
                                      TextField="@((item) => item?.DisplayName)"
                                      ValueField="@((item) => item?.Id ?? default)"
                                      SearchChanged="@GetZoneCollectionLookupAsync"
                                      @bind-SelectedValue="@NewZoneParagraph.ZoneId"
                                      Placeholder="&#8212;" />
                    </Field>


                    
                    
                </Validations>
            </ModalBody>
            <ModalFooter>
                <Button Color="Color.Secondary"
                        Clicked="CloseCreateZoneParagraphModalAsync">
                    @L["Cancel"]
                </Button>
                <SubmitButton Form="CreateZoneParagraphForm" Clicked="CreateZoneParagraphAsync" />
            </ModalFooter>
        </Form>
    </ModalContent>
</Modal>

@* ************************* EDIT MODAL ************************* *@
<Modal @ref="EditZoneParagraphModal" Closing="@EditZoneParagraphModal.CancelClosingModalWhenFocusLost">
    <ModalContent Centered="true">
        <Form id="EditZoneParagraphForm">
            <ModalHeader>
                <ModalTitle>@L["Update"]</ModalTitle>
                <CloseButton Clicked="CloseEditZoneParagraphModalAsync" />
            </ModalHeader>
            <ModalBody>
                <Validations @ref="@EditingZoneParagraphValidations"
                            Mode="ValidationMode.Auto"
                            Model="@EditingZoneParagraph"
                            ValidateOnLoad="false">
                     
                    
                    <Validation>
                        <Field>
                            <FieldLabel>@L["TitleEn"] *</FieldLabel>
                            <TextEdit @bind-Text="@EditingZoneParagraph.TitleEn" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["TitleAr"] *</FieldLabel>
                            <TextEdit @bind-Text="@EditingZoneParagraph.TitleAr" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["SubTilteEn"]</FieldLabel>
                            <TextEdit @bind-Text="@EditingZoneParagraph.SubTilteEn" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["SubTitleAr"]</FieldLabel>
                            <TextEdit @bind-Text="@EditingZoneParagraph.SubTitleAr" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["DescriptionEn"]</FieldLabel>
                            <TextEdit @bind-Text="@EditingZoneParagraph.DescriptionEn" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["DescriptionAr"]</FieldLabel>
                            <TextEdit @bind-Text="@EditingZoneParagraph.DescriptionAr" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["Order"]</FieldLabel>
                            <NumericPicker TValue="int" @bind-Value="@EditingZoneParagraph.Order"  Decimals="0">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                             </NumericPicker>
                        </Field>
                     </Validation>


                    <Field>
                        <Check TValue="bool" @bind-Checked="@EditingZoneParagraph.IsActive">@L["IsActive"]</Check>
                    </Field>

                    <Field>
                        <FieldLabel>@L["Zone"] *</FieldLabel>
                        <Autocomplete Data="@ZonesCollection"
                                      TItem="LookupDto<Guid>"
                                      TValue="Guid"
                                      TextField="@((item) => item?.DisplayName)"
                                      ValueField="@((item) => item?.Id ?? default)"
                                      SearchChanged="@GetZoneCollectionLookupAsync"
                                      @bind-SelectedValue="@EditingZoneParagraph.ZoneId"
                                      Placeholder="&#8212;" />
                    </Field>


                    
                    
                </Validations>
            </ModalBody>
            <ModalFooter>
                <Button Color="Color.Secondary"
                        Clicked="CloseEditZoneParagraphModalAsync">
                    @L["Cancel"]
                </Button>
                <SubmitButton Form="CreateZoneParagraphForm" Clicked="UpdateZoneParagraphAsync" />
            </ModalFooter>
        </Form>
    </ModalContent>
</Modal>
