                <CloseButton Clicked="CloseEditCommercialModalAsync" />
            </ModalHeader>
            <ModalBody>
                <Validations @ref="@EditingCommercialValidations"
                            Mode="ValidationMode.Auto"
                            Model="@EditingCommercial"
                            ValidateOnLoad="false">
                     
                    
                    <Validation>
                        <Field>
                            <FieldLabel>@L["TitleEn"] *</FieldLabel>
                            <TextEdit @bind-Text="@EditingCommercial.TitleEn" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["TitleAr"] *</FieldLabel>
                            <TextEdit @bind-Text="@EditingCommercial.TitleAr" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["PlotNo"]</FieldLabel>
                            <TextEdit @bind-Text="@EditingCommercial.PlotNo" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["ActivityEn"]</FieldLabel>
                            <TextEdit @bind-Text="@EditingCommercial.ActivityEn" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["ActivityAr"]</FieldLabel>
                            <TextEdit @bind-Text="@EditingCommercial.ActivityAr" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["Phone"]</FieldLabel>
                            <TextEdit @bind-Text="@EditingCommercial.Phone" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["Fax"]</FieldLabel>
                            <TextEdit @bind-Text="@EditingCommercial.Fax" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["MakaniNo"]</FieldLabel>
                            <TextEdit @bind-Text="@EditingCommercial.MakaniNo" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Field>
                        <Check TValue="bool" @bind-Checked="@EditingCommercial.IsActive">@L["IsActive"]</Check>
                    </Field>

                    <Validation>
                        <Field>
                            <FieldLabel>@L["Order"]</FieldLabel>
                            <NumericPicker TValue="int" @bind-Value="@EditingCommercial.Order"  Decimals="0">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                             </NumericPicker>
                        </Field>
                     </Validation>


                    <Field>
                        <FieldLabel>@L["SubCategory"]</FieldLabel>
                        <Select TValue="Guid" @bind-SelectedValue="@EditingCommercial.SubCategoryId">
                            @foreach (var subCategory in SubCategoriesCollection)
                            {
                                <SelectItem TValue="Guid" Value="@subCategory.Id">
                                    @subCategory.DisplayName
                                </SelectItem>
                            }
                        </Select>
                    </Field>


                    
                    
                </Validations>
            </ModalBody>
            <ModalFooter>
                <Button Color="Color.Secondary"
                        Clicked="CloseEditCommercialModalAsync">
                    @L["Cancel"]
                </Button>
                <SubmitButton Form="CreateCommercialForm" Clicked="UpdateCommercialAsync" />
            </ModalFooter>
        </Form>
    </ModalContent>
</Modal>
