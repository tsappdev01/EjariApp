

@page "/supported-banks"

@attribute [Authorize(DIPPermissions.SupportedBanks.Default)]
@using DIP.SupportedBanks
@using DIP.Localization
@using DIP.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Components.Web
@using Blazorise
@using Blazorise.Components
@using Blazorise.DataGrid
@using Volo.Abp.BlazoriseUI
@using Volo.Abp.BlazoriseUI.Components
@using Volo.Abp.ObjectMapping
@using Volo.Abp.AspNetCore.Components.Messages
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout
@using DIP.Permissions
@using Microsoft.AspNetCore.Components
@using Volo.Abp.AspNetCore.Components.Web
@using Volo.Abp.Http.Client
@inherits DIPComponentBase
@inject ISupportedBanksAppService SupportedBanksAppService
@inject IUiMessageService UiMessageService
@inject IRemoteServiceConfigurationProvider RemoteServiceConfigurationProvider
@inject NavigationManager NavigationManager

@* ************************* PAGE HEADER ************************* *@
<PageHeader Title="@L["SupportedBanks"]" BreadcrumbItems="BreadcrumbItems" Toolbar="Toolbar">

</PageHeader>

@* ************************* SEARCH ************************* *@
<Card>
    <CardBody>
        <Form id="SupportedBankSearchForm" class="mb-3">
            <Addons>
                <Addon AddonType="AddonType.Body">
                    <TextEdit @bind-Text="@Filter.FilterText"
                              Autofocus="true"
                              Placeholder="@L["Search"]">
                    </TextEdit>
                </Addon>
                <Addon AddonType="AddonType.End">
                    <SubmitButton Form="SupportedBankSearchForm" Clicked="GetSupportedBanksAsync">
                        <Icon Name="IconName.Search" Class="me-1"></Icon>@L["Search"]
                    </SubmitButton>
                </Addon>
            </Addons>
        </Form>
    </CardBody>
</Card>

@* ************************* DATA GRID ************************* *@
<Card>
    <CardBody>
        <DataGrid TItem="SupportedBankDto"
                  Data="SupportedBankList"
                  ReadData="OnDataGridReadAsync"
                  TotalItems="TotalCount"
                  ShowPager="true"
                  Responsive="true"
                  PageSize="PageSize">
            <DataGridColumns>
                <DataGridEntityActionsColumn TItem="SupportedBankDto" @ref="@EntityActionsColumn">
                    <DisplayTemplate>
                        <EntityActions TItem="SupportedBankDto" EntityActionsColumn="@EntityActionsColumn">
                            <EntityAction TItem="SupportedBankDto"
                                          Visible="@CanEditSupportedBank"
                                          Clicked="async () => await OpenEditSupportedBankModalAsync(context)"
                                          Text="@L["Edit"]"></EntityAction>
                            <EntityAction TItem="SupportedBankDto"
                                          Visible="@CanDeleteSupportedBank"
                                          Clicked="() => DeleteSupportedBankAsync(context)"
                                          ConfirmationMessage="@(()=> L["DeleteConfirmationMessage"])"
                                          Text="@L["Delete"]"></EntityAction>
                        </EntityActions>
                    </DisplayTemplate>
                </DataGridEntityActionsColumn>
               
              <DataGridColumn TItem="SupportedBankDto"
                      Field="TitleAr"
                      Caption="@L["TitleAr"]">
              </DataGridColumn>

              <DataGridColumn TItem="SupportedBankDto"
                      Field="TitleEn"
                      Caption="@L["TitleEn"]">
              </DataGridColumn>

              <DataGridColumn TItem="SupportedBankDto"
                      Field="IsActive"
                      Caption="@L["IsActive"]">
                    <DisplayTemplate>
                        @if (context.IsActive)
                        {
                            <Icon TextColor="TextColor.Success" Name="@IconName.Check" />
                        }
                        else
                        {
                            <Icon TextColor="TextColor.Danger" Name="@IconName.Times" />
                        }
                    </DisplayTemplate>
              </DataGridColumn>


              <DataGridColumn TItem="SupportedBankDto"
                      Field="Order"
                      Caption="@L["Order"]">
              </DataGridColumn>

            </DataGridColumns>
        </DataGrid>
    </CardBody>
</Card>

@* ************************* CREATE MODAL ************************* *@
<Modal @ref="CreateSupportedBankModal" Closing="@CreateSupportedBankModal.CancelClosingModalWhenFocusLost">
    <ModalContent Centered="true">
        <Form id="CreateSupportedBankForm">
            <ModalHeader>
                <ModalTitle>@L["NewSupportedBank"]</ModalTitle>
                <CloseButton Clicked="CloseCreateSupportedBankModalAsync" />
            </ModalHeader>
            <ModalBody>
                <Validations @ref="@NewSupportedBankValidations"
                            Mode="ValidationMode.Auto"
                            Model="@NewSupportedBank"
                            ValidateOnLoad="false">
                     
                    
                    <Validation>
                        <Field>
                            <FieldLabel>@L["TitleAr"]</FieldLabel>
                            <TextEdit @bind-Text="@NewSupportedBank.TitleAr" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["TitleEn"]</FieldLabel>
                            <TextEdit @bind-Text="@NewSupportedBank.TitleEn" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Field>
                        <Check TValue="bool" @bind-Checked="@NewSupportedBank.IsActive">@L["IsActive"]</Check>
                    </Field>

                    <Validation>
                        <Field>
                            <FieldLabel>@L["Order"]</FieldLabel>
                            <NumericPicker TValue="int" @bind-Value="@NewSupportedBank.Order"  Decimals="0">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                             </NumericPicker>
                        </Field>
                     </Validation>


                    
                    
                </Validations>
            </ModalBody>
            <ModalFooter>
                <Button Color="Color.Secondary"
                        Clicked="CloseCreateSupportedBankModalAsync">
                    @L["Cancel"]
                </Button>
                <SubmitButton Form="CreateSupportedBankForm" Clicked="CreateSupportedBankAsync" />
            </ModalFooter>
        </Form>
    </ModalContent>
</Modal>

@* ************************* EDIT MODAL ************************* *@
<Modal @ref="EditSupportedBankModal" Closing="@EditSupportedBankModal.CancelClosingModalWhenFocusLost">
    <ModalContent Centered="true">
        <Form id="EditSupportedBankForm">
            <ModalHeader>
                <ModalTitle>@L["Update"]</ModalTitle>
                <CloseButton Clicked="CloseEditSupportedBankModalAsync" />
            </ModalHeader>
            <ModalBody>
                <Validations @ref="@EditingSupportedBankValidations"
                            Mode="ValidationMode.Auto"
                            Model="@EditingSupportedBank"
                            ValidateOnLoad="false">
                     
                    
                    <Validation>
                        <Field>
                            <FieldLabel>@L["TitleAr"]</FieldLabel>
                            <TextEdit @bind-Text="@EditingSupportedBank.TitleAr" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["TitleEn"]</FieldLabel>
                            <TextEdit @bind-Text="@EditingSupportedBank.TitleEn" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Field>
                        <Check TValue="bool" @bind-Checked="@EditingSupportedBank.IsActive">@L["IsActive"]</Check>
                    </Field>

                    <Validation>
                        <Field>
                            <FieldLabel>@L["Order"]</FieldLabel>
                            <NumericPicker TValue="int" @bind-Value="@EditingSupportedBank.Order"  Decimals="0">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                             </NumericPicker>
                        </Field>
                     </Validation>


                    
                    
                </Validations>
            </ModalBody>
            <ModalFooter>
                <Button Color="Color.Secondary"
                        Clicked="CloseEditSupportedBankModalAsync">
                    @L["Cancel"]
                </Button>
                <SubmitButton Form="CreateSupportedBankForm" Clicked="UpdateSupportedBankAsync" />
            </ModalFooter>
        </Form>
    </ModalContent>
</Modal>
