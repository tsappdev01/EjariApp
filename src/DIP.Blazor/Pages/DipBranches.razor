

@page "/dip-branches"

@attribute [Authorize(DIPPermissions.DipBranches.Default)]
@using DIP.DipBranches
@using DIP.Localization
@using DIP.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Components.Web
@using Blazorise
@using Blazorise.Components
@using Blazorise.DataGrid
@using Volo.Abp.BlazoriseUI
@using Volo.Abp.BlazoriseUI.Components
@using Volo.Abp.ObjectMapping
@using Volo.Abp.AspNetCore.Components.Messages
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout
@using DIP.Permissions
@using Microsoft.AspNetCore.Components
@using Volo.Abp.AspNetCore.Components.Web
@using Volo.Abp.Http.Client
@inherits DIPComponentBase
@inject IDipBranchesAppService DipBranchesAppService
@inject IUiMessageService UiMessageService
@inject IRemoteServiceConfigurationProvider RemoteServiceConfigurationProvider
@inject NavigationManager NavigationManager

@* ************************* PAGE HEADER ************************* *@
<PageHeader Title="@L["DipBranches"]" BreadcrumbItems="BreadcrumbItems" Toolbar="Toolbar">

</PageHeader>

@* ************************* SEARCH ************************* *@
<Card>
    <CardBody>
        <Form id="DipBranchSearchForm" class="mb-3">
            <Addons>
                <Addon AddonType="AddonType.Body">
                    <TextEdit @bind-Text="@Filter.FilterText"
                              Autofocus="true"
                              Placeholder="@L["Search"]">
                    </TextEdit>
                </Addon>
                <Addon AddonType="AddonType.End">
                    <SubmitButton Form="DipBranchSearchForm" Clicked="GetDipBranchesAsync">
                        <Icon Name="IconName.Search" Class="me-1"></Icon>@L["Search"]
                    </SubmitButton>
                </Addon>
            </Addons>
        </Form>
    </CardBody>
</Card>

@* ************************* DATA GRID ************************* *@
<Card>
    <CardBody>
        <DataGrid TItem="DipBranchDto"
                  Data="DipBranchList"
                  ReadData="OnDataGridReadAsync"
                  TotalItems="TotalCount"
                  ShowPager="true"
                  Responsive="true"
                  PageSize="PageSize">
            <DataGridColumns>
                <DataGridEntityActionsColumn TItem="DipBranchDto" @ref="@EntityActionsColumn">
                    <DisplayTemplate>
                        <EntityActions TItem="DipBranchDto" EntityActionsColumn="@EntityActionsColumn">
                            <EntityAction TItem="DipBranchDto"
                                          Visible="@CanEditDipBranch"
                                          Clicked="async () => await OpenEditDipBranchModalAsync(context)"
                                          Text="@L["Edit"]"></EntityAction>
                            <EntityAction TItem="DipBranchDto"
                                          Visible="@CanDeleteDipBranch"
                                          Clicked="() => DeleteDipBranchAsync(context)"
                                          ConfirmationMessage="@(()=> L["DeleteConfirmationMessage"])"
                                          Text="@L["Delete"]"></EntityAction>
                        </EntityActions>
                    </DisplayTemplate>
                </DataGridEntityActionsColumn>
               
              <DataGridColumn TItem="DipBranchDto"
                      Field="TitleEn"
                      Caption="@L["TitleEn"]">
              </DataGridColumn>

              <DataGridColumn TItem="DipBranchDto"
                      Field="TitleAr"
                      Caption="@L["TitleAr"]">
              </DataGridColumn>

              <DataGridColumn TItem="DipBranchDto"
                      Field="SubTitleEn"
                      Caption="@L["SubTitleEn"]">
              </DataGridColumn>

              <DataGridColumn TItem="DipBranchDto"
                      Field="SubTitleAr"
                      Caption="@L["SubTitleAr"]">
              </DataGridColumn>

              <DataGridColumn TItem="DipBranchDto"
                      Field="Phone"
                      Caption="@L["Phone"]">
              </DataGridColumn>

              <DataGridColumn TItem="DipBranchDto"
                      Field="AlternativePhone"
                      Caption="@L["AlternativePhone"]">
              </DataGridColumn>

              <DataGridColumn TItem="DipBranchDto"
                      Field="Email"
                      Caption="@L["Email"]">
              </DataGridColumn>

              <DataGridColumn TItem="DipBranchDto"
                      Field="AlternativeEmail"
                      Caption="@L["AlternativeEmail"]">
              </DataGridColumn>

              <DataGridColumn TItem="DipBranchDto"
                      Field="Order"
                      Caption="@L["Order"]">
              </DataGridColumn>

              <DataGridColumn TItem="DipBranchDto"
                      Field="IsActive"
                      Caption="@L["IsActive"]">
                    <DisplayTemplate>
                        @if (context.IsActive)
                        {
                            <Icon TextColor="TextColor.Success" Name="@IconName.Check" />
                        }
                        else
                        {
                            <Icon TextColor="TextColor.Danger" Name="@IconName.Times" />
                        }
                    </DisplayTemplate>
              </DataGridColumn>


            </DataGridColumns>
        </DataGrid>
    </CardBody>
</Card>

@* ************************* CREATE MODAL ************************* *@
<Modal @ref="CreateDipBranchModal" Closing="@CreateDipBranchModal.CancelClosingModalWhenFocusLost">
    <ModalContent Centered="true">
        <Form id="CreateDipBranchForm">
            <ModalHeader>
                <ModalTitle>@L["NewDipBranch"]</ModalTitle>
                <CloseButton Clicked="CloseCreateDipBranchModalAsync" />
            </ModalHeader>
            <ModalBody>
                <Validations @ref="@NewDipBranchValidations"
                            Mode="ValidationMode.Auto"
                            Model="@NewDipBranch"
                            ValidateOnLoad="false">
                     
                    
                    <Validation>
                        <Field>
                            <FieldLabel>@L["TitleEn"] *</FieldLabel>
                            <TextEdit @bind-Text="@NewDipBranch.TitleEn" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["TitleAr"] *</FieldLabel>
                            <TextEdit @bind-Text="@NewDipBranch.TitleAr" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["SubTitleEn"]</FieldLabel>
                            <TextEdit @bind-Text="@NewDipBranch.SubTitleEn" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["SubTitleAr"]</FieldLabel>
                            <TextEdit @bind-Text="@NewDipBranch.SubTitleAr" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["Phone"]</FieldLabel>
                            <TextEdit @bind-Text="@NewDipBranch.Phone" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["AlternativePhone"]</FieldLabel>
                            <TextEdit @bind-Text="@NewDipBranch.AlternativePhone" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["Email"]</FieldLabel>
                            <TextEdit @bind-Text="@NewDipBranch.Email"  Role="TextRole.Email">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["AlternativeEmail"]</FieldLabel>
                            <TextEdit @bind-Text="@NewDipBranch.AlternativeEmail"  Role="TextRole.Email">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["Order"]</FieldLabel>
                            <NumericPicker TValue="int" @bind-Value="@NewDipBranch.Order"  Decimals="0">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                             </NumericPicker>
                        </Field>
                     </Validation>


                    <Field>
                        <Check TValue="bool" @bind-Checked="@NewDipBranch.IsActive">@L["IsActive"]</Check>
                    </Field>

                    
                    
                </Validations>
            </ModalBody>
            <ModalFooter>
                <Button Color="Color.Secondary"
                        Clicked="CloseCreateDipBranchModalAsync">
                    @L["Cancel"]
                </Button>
                <SubmitButton Form="CreateDipBranchForm" Clicked="CreateDipBranchAsync" />
            </ModalFooter>
        </Form>
    </ModalContent>
</Modal>

@* ************************* EDIT MODAL ************************* *@
<Modal @ref="EditDipBranchModal" Closing="@EditDipBranchModal.CancelClosingModalWhenFocusLost">
    <ModalContent Centered="true">
        <Form id="EditDipBranchForm">
            <ModalHeader>
                <ModalTitle>@L["Update"]</ModalTitle>
                <CloseButton Clicked="CloseEditDipBranchModalAsync" />
            </ModalHeader>
            <ModalBody>
                <Validations @ref="@EditingDipBranchValidations"
                            Mode="ValidationMode.Auto"
                            Model="@EditingDipBranch"
                            ValidateOnLoad="false">
                     
                    
                    <Validation>
                        <Field>
                            <FieldLabel>@L["TitleEn"] *</FieldLabel>
                            <TextEdit @bind-Text="@EditingDipBranch.TitleEn" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["TitleAr"] *</FieldLabel>
                            <TextEdit @bind-Text="@EditingDipBranch.TitleAr" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["SubTitleEn"]</FieldLabel>
                            <TextEdit @bind-Text="@EditingDipBranch.SubTitleEn" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["SubTitleAr"]</FieldLabel>
                            <TextEdit @bind-Text="@EditingDipBranch.SubTitleAr" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["Phone"]</FieldLabel>
                            <TextEdit @bind-Text="@EditingDipBranch.Phone" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["AlternativePhone"]</FieldLabel>
                            <TextEdit @bind-Text="@EditingDipBranch.AlternativePhone" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["Email"]</FieldLabel>
                            <TextEdit @bind-Text="@EditingDipBranch.Email"  Role="TextRole.Email">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["AlternativeEmail"]</FieldLabel>
                            <TextEdit @bind-Text="@EditingDipBranch.AlternativeEmail"  Role="TextRole.Email">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["Order"]</FieldLabel>
                            <NumericPicker TValue="int" @bind-Value="@EditingDipBranch.Order"  Decimals="0">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                             </NumericPicker>
                        </Field>
                     </Validation>


                    <Field>
                        <Check TValue="bool" @bind-Checked="@EditingDipBranch.IsActive">@L["IsActive"]</Check>
                    </Field>

                    
                    
                </Validations>
            </ModalBody>
            <ModalFooter>
                <Button Color="Color.Secondary"
                        Clicked="CloseEditDipBranchModalAsync">
                    @L["Cancel"]
                </Button>
                <SubmitButton Form="CreateDipBranchForm" Clicked="UpdateDipBranchAsync" />
            </ModalFooter>
        </Form>
    </ModalContent>
</Modal>
