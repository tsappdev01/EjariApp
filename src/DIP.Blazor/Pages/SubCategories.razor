

@page "/sub-categories"

@attribute [Authorize(DIPPermissions.SubCategories.Default)]
@using DIP.SubCategories
@using DIP.Localization
@using DIP.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Components.Web
@using Blazorise
@using Blazorise.Components
@using Blazorise.DataGrid
@using Volo.Abp.BlazoriseUI
@using Volo.Abp.BlazoriseUI.Components
@using Volo.Abp.ObjectMapping
@using Volo.Abp.AspNetCore.Components.Messages
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout
@using DIP.Permissions
@using Microsoft.AspNetCore.Components
@using Volo.Abp.AspNetCore.Components.Web
@using Volo.Abp.Http.Client
@inherits DIPComponentBase
@inject ISubCategoriesAppService SubCategoriesAppService
@inject IUiMessageService UiMessageService
@inject IRemoteServiceConfigurationProvider RemoteServiceConfigurationProvider
@inject NavigationManager NavigationManager

@* ************************* PAGE HEADER ************************* *@
<PageHeader Title="@L["SubCategories"]" BreadcrumbItems="BreadcrumbItems" Toolbar="Toolbar">

</PageHeader>

@* ************************* SEARCH ************************* *@
<Card>
    <CardBody>
        <Form id="SubCategorySearchForm" class="mb-3">
            <Addons>
                <Addon AddonType="AddonType.Body">
                    <TextEdit @bind-Text="@Filter.FilterText"
                              Autofocus="true"
                              Placeholder="@L["Search"]">
                    </TextEdit>
                </Addon>
                <Addon AddonType="AddonType.End">
                    <SubmitButton Form="SubCategorySearchForm" Clicked="GetSubCategoriesAsync">
                        <Icon Name="IconName.Search" Class="me-1"></Icon>@L["Search"]
                    </SubmitButton>
                </Addon>
            </Addons>
        </Form>
    </CardBody>
</Card>

@* ************************* DATA GRID ************************* *@
<Card>
    <CardBody>
        <DataGrid TItem="SubCategoryWithNavigationPropertiesDto"
                  Data="SubCategoryList"
                  ReadData="OnDataGridReadAsync"
                  TotalItems="TotalCount"
                  ShowPager="true"
                  Responsive="true"
                  PageSize="PageSize">
            <DataGridColumns>
                <DataGridEntityActionsColumn TItem="SubCategoryWithNavigationPropertiesDto" @ref="@EntityActionsColumn">
                    <DisplayTemplate>
                        <EntityActions TItem="SubCategoryWithNavigationPropertiesDto" EntityActionsColumn="@EntityActionsColumn">
                            <EntityAction TItem="SubCategoryWithNavigationPropertiesDto"
                                          Visible="@CanEditSubCategory"
                                          Clicked="async () => await OpenEditSubCategoryModalAsync(context)"
                                          Text="@L["Edit"]"></EntityAction>
                            <EntityAction TItem="SubCategoryWithNavigationPropertiesDto"
                                          Visible="@CanDeleteSubCategory"
                                          Clicked="() => DeleteSubCategoryAsync(context)"
                                          ConfirmationMessage="@(()=> L["DeleteConfirmationMessage"])"
                                          Text="@L["Delete"]"></EntityAction>
                        </EntityActions>
                    </DisplayTemplate>
                </DataGridEntityActionsColumn>
               
              <DataGridColumn TItem="SubCategoryWithNavigationPropertiesDto"
                      Field="SubCategory.TitleAr"
                      Caption="@L["TitleAr"]">
              </DataGridColumn>

              <DataGridColumn TItem="SubCategoryWithNavigationPropertiesDto"
                      Field="SubCategory.TitleEn"
                      Caption="@L["TitleEn"]">
              </DataGridColumn>

              <DataGridColumn TItem="SubCategoryWithNavigationPropertiesDto"
                      Field="SubCategory.Order"
                      Caption="@L["Order"]">
              </DataGridColumn>

              <DataGridColumn TItem="SubCategoryWithNavigationPropertiesDto"
                      Field="SubCategory.IsFeature"
                      Caption="@L["IsFeature"]">
                    <DisplayTemplate>
                        @if (context.SubCategory.IsFeature)
                        {
                            <Icon TextColor="TextColor.Success" Name="@IconName.Check" />
                        }
                        else
                        {
                            <Icon TextColor="TextColor.Danger" Name="@IconName.Times" />
                        }
                    </DisplayTemplate>
              </DataGridColumn>


              <DataGridColumn TItem="SubCategoryWithNavigationPropertiesDto"
                      Field="SubCategory.IsActive"
                      Caption="@L["IsActive"]">
                    <DisplayTemplate>
                        @if (context.SubCategory.IsActive)
                        {
                            <Icon TextColor="TextColor.Success" Name="@IconName.Check" />
                        }
                        else
                        {
                            <Icon TextColor="TextColor.Danger" Name="@IconName.Times" />
                        }
                    </DisplayTemplate>
              </DataGridColumn>


              <DataGridColumn TItem="SubCategoryWithNavigationPropertiesDto"
                      Field="Category.TitleEn"
                      Caption="@L["Category"]">
              </DataGridColumn>

            </DataGridColumns>
        </DataGrid>
    </CardBody>
</Card>

@* ************************* CREATE MODAL ************************* *@
<Modal @ref="CreateSubCategoryModal" Closing="@CreateSubCategoryModal.CancelClosingModalWhenFocusLost">
    <ModalContent Centered="true">
        <Form id="CreateSubCategoryForm">
            <ModalHeader>
                <ModalTitle>@L["NewSubCategory"]</ModalTitle>
                <CloseButton Clicked="CloseCreateSubCategoryModalAsync" />
            </ModalHeader>
            <ModalBody>
                <Validations @ref="@NewSubCategoryValidations"
                            Mode="ValidationMode.Auto"
                            Model="@NewSubCategory"
                            ValidateOnLoad="false">
                     
                    
                    <Validation>
                        <Field>
                            <FieldLabel>@L["TitleAr"] *</FieldLabel>
                            <TextEdit @bind-Text="@NewSubCategory.TitleAr" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["TitleEn"] *</FieldLabel>
                            <TextEdit @bind-Text="@NewSubCategory.TitleEn" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["Order"]</FieldLabel>
                            <NumericPicker TValue="int" @bind-Value="@NewSubCategory.Order"  Decimals="0">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                             </NumericPicker>
                        </Field>
                     </Validation>


                    <Field>
                        <Check TValue="bool" @bind-Checked="@NewSubCategory.IsFeature">@L["IsFeature"]</Check>
                    </Field>

                    <Field>
                        <Check TValue="bool" @bind-Checked="@NewSubCategory.IsActive">@L["IsActive"]</Check>
                    </Field>

                    <Field>
                        <FieldLabel>@L["Category"]</FieldLabel>
                        <Select TValue="Guid" @bind-SelectedValue="@NewSubCategory.CategoryId">
                            @foreach (var category in CategoriesCollection)
                            {
                                <SelectItem TValue="Guid" Value="@category.Id">
                                    @category.DisplayName
                                </SelectItem>
                            }
                        </Select>
                    </Field>


                    
                    
                </Validations>
            </ModalBody>
            <ModalFooter>
                <Button Color="Color.Secondary"
                        Clicked="CloseCreateSubCategoryModalAsync">
                    @L["Cancel"]
                </Button>
                <SubmitButton Form="CreateSubCategoryForm" Clicked="CreateSubCategoryAsync" />
            </ModalFooter>
        </Form>
    </ModalContent>
</Modal>

@* ************************* EDIT MODAL ************************* *@
<Modal @ref="EditSubCategoryModal" Closing="@EditSubCategoryModal.CancelClosingModalWhenFocusLost">
    <ModalContent Centered="true">
        <Form id="EditSubCategoryForm">
            <ModalHeader>
                <ModalTitle>@L["Update"]</ModalTitle>
                <CloseButton Clicked="CloseEditSubCategoryModalAsync" />
            </ModalHeader>
            <ModalBody>
                <Validations @ref="@EditingSubCategoryValidations"
                            Mode="ValidationMode.Auto"
                            Model="@EditingSubCategory"
                            ValidateOnLoad="false">
                     
                    
                    <Validation>
                        <Field>
                            <FieldLabel>@L["TitleAr"] *</FieldLabel>
                            <TextEdit @bind-Text="@EditingSubCategory.TitleAr" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["TitleEn"] *</FieldLabel>
                            <TextEdit @bind-Text="@EditingSubCategory.TitleEn" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["Order"]</FieldLabel>
                            <NumericPicker TValue="int" @bind-Value="@EditingSubCategory.Order"  Decimals="0">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                             </NumericPicker>
                        </Field>
                     </Validation>


                    <Field>
                        <Check TValue="bool" @bind-Checked="@EditingSubCategory.IsFeature">@L["IsFeature"]</Check>
                    </Field>

                    <Field>
                        <Check TValue="bool" @bind-Checked="@EditingSubCategory.IsActive">@L["IsActive"]</Check>
                    </Field>

                    <Field>
                        <FieldLabel>@L["Category"]</FieldLabel>
                        <Select TValue="Guid" @bind-SelectedValue="@EditingSubCategory.CategoryId">
                            @foreach (var category in CategoriesCollection)
                            {
                                <SelectItem TValue="Guid" Value="@category.Id">
                                    @category.DisplayName
                                </SelectItem>
                            }
                        </Select>
                    </Field>


                    
                    
                </Validations>
            </ModalBody>
            <ModalFooter>
                <Button Color="Color.Secondary"
                        Clicked="CloseEditSubCategoryModalAsync">
                    @L["Cancel"]
                </Button>
                <SubmitButton Form="CreateSubCategoryForm" Clicked="UpdateSubCategoryAsync" />
            </ModalFooter>
        </Form>
    </ModalContent>
</Modal>
