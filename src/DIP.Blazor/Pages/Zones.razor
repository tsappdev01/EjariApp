                    <Validation>
                        <Field>
                            <FieldLabel>@L["TitleEn"] *</FieldLabel>
                            <TextEdit @bind-Text="@EditingZone.TitleEn" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["TitleAR"] *</FieldLabel>
