

@page "/slider-home-pages"

@attribute [Authorize(DIPPermissions.SliderHomePages.Default)]
@using DIP.SliderHomePages
@using DIP.Localization
@using DIP.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Components.Web
@using Blazorise
@using Blazorise.Components
@using Blazorise.DataGrid
@using Volo.Abp.BlazoriseUI
@using Volo.Abp.BlazoriseUI.Components
@using Volo.Abp.ObjectMapping
@using Volo.Abp.AspNetCore.Components.Messages
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout

@using DIP.Permissions
@using Volo.Abp.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components
@using Volo.Abp.Http.Client
@inherits DIPComponentBase
@inject ISliderHomePagesAppService SliderHomePagesAppService

@inject IUiMessageService UiMessageService
@inject AbpBlazorMessageLocalizerHelper<DIPResource> LH
@inject IRemoteServiceConfigurationProvider RemoteServiceConfigurationProvider
@inject NavigationManager NavigationManager

@* ************************* PAGE HEADER ************************* *@
<PageHeader Title="@L["SliderHomePages"]" BreadcrumbItems="BreadcrumbItems" Toolbar="Toolbar">

</PageHeader>

@* ************************* SEARCH ************************* *@
<Card>
    <CardBody>

        <Row>
            <div class="col-md-8 col-lg-10">
                <div class="mb-3">
                    <Form id="SliderHomePageSearchForm">
                        <Addons>
                            <Addon AddonType="AddonType.Body">
                                <TextEdit @bind-Text="@Filter.FilterText"
                                        Autofocus="true"
                                        Placeholder="@L["Search"]">
                                </TextEdit>
                            </Addon>
                            <Addon AddonType="AddonType.End">
                                <SubmitButton Form="SliderHomePageSearchForm" Clicked="GetSliderHomePagesAsync">
                                    <Icon Name="IconName.Search" Class="me-1"></Icon>@L["Search"]
                                </SubmitButton>
                            </Addon>
                        </Addons>
                    </Form>
                </div>
            </div>
                
                   <div class="col-md-4 col-lg-2">
            <div class="mb-3">
               <Button Color="Color.Primary" Outline Style="width:100%" id="AdvancedFilterSectionToggler"
                         Clicked="@(() => ShowAdvancedFilters = !ShowAdvancedFilters)">@L["Filters"]
                         <i aria-hidden="true" class="fa ms-1 @(!ShowAdvancedFilters ? "fa-angle-down" : "fa-angle-up")"></i>
               </Button>
            </div>
       </div>
        
        <div style="display: @(!ShowAdvancedFilters ? "none" : "block")"  class="mt-3">
            <Row>
                <Column ColumnSize="ColumnSize.Is3">
                    <Field>
                        <FieldLabel>@L["TitleAr"]</FieldLabel>
                        <TextEdit Text="@Filter.TitleAr" TextChanged="@OnTitleArChangedAsync" />                       
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3">
                    <Field>
                        <FieldLabel>@L["TitleEn"]</FieldLabel>
                        <TextEdit Text="@Filter.TitleEn" TextChanged="@OnTitleEnChangedAsync" />                       
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3">
                    <Field>
                        <FieldLabel>@L["DescriptionAr"]</FieldLabel>
                        <TextEdit Text="@Filter.DescriptionAr" TextChanged="@OnDescriptionArChangedAsync" />                       
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3">
                    <Field>
                        <FieldLabel>@L["DescriptionEn"]</FieldLabel>
                        <TextEdit Text="@Filter.DescriptionEn" TextChanged="@OnDescriptionEnChangedAsync" />                       
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3">
                    <Field>
                        <FieldLabel>@L["ButtonTitleAr"]</FieldLabel>
                        <TextEdit Text="@Filter.ButtonTitleAr" TextChanged="@OnButtonTitleArChangedAsync" />                       
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3">
                    <Field>
                        <FieldLabel>@L["ButtonTitleEn"]</FieldLabel>
                        <TextEdit Text="@Filter.ButtonTitleEn" TextChanged="@OnButtonTitleEnChangedAsync" />                       
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3">
                    <Field>
                        <FieldLabel>@L["ButtonUrlEn"]</FieldLabel>
                        <TextEdit Text="@Filter.ButtonUrlEn" TextChanged="@OnButtonUrlEnChangedAsync" />                       
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3">
                    <Field>
                        <FieldLabel>@L["ButtonUrlAr"]</FieldLabel>
                        <TextEdit Text="@Filter.ButtonUrlAr" TextChanged="@OnButtonUrlArChangedAsync" />                       
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3">
                    <Field>
                        <FieldLabel>@L["Image"]</FieldLabel>
                        <TextEdit Text="@Filter.Image" TextChanged="@OnImageChangedAsync" />                       
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3">
                    <Field>
                        <FieldLabel>@L["YoutubeUrl"]</FieldLabel>
                        <TextEdit Text="@Filter.YoutubeUrl" TextChanged="@OnYoutubeUrlChangedAsync" />                       
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3">
                    <Field>
                        <FieldLabel>@L["IsActive"]</FieldLabel>
                        <Select TValue="bool?"
		SelectedValue="@Filter.IsActive"
		SelectedValueChanged="@OnIsActiveChangedAsync">

<SelectItem></SelectItem>
<SelectItem Value="true">@L["Yes"]</SelectItem>
<SelectItem Value="false">@L["No"]</SelectItem>

</Select>                       
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3">
                    <Field>
                        <FieldLabel>@L["MinOrder"]</FieldLabel>
                        <NumericEdit TValue="int?" 
             Value="@Filter.OrderMin"
             ValueChanged="@OnOrderMinChangedAsync" />                       
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3">
                    <Field>
                        <FieldLabel>@L["MaxOrder"]</FieldLabel>
                        <NumericEdit TValue="int?" 
             Value="@Filter.OrderMax"
             ValueChanged="@OnOrderMaxChangedAsync" />                       
                    </Field>
                </Column>
            </Row>

        </div>

        </Row>


    </CardBody>
</Card>

@* ************************* DATA GRID ************************* *@
<Card>
    <CardBody>
        <DataGrid TItem="SliderHomePageDto"
                  Data="SliderHomePageList"
                  
                  
                  
                  
                  ReadData="OnDataGridReadAsync"
                  TotalItems="TotalCount"
                  ShowPager="true"
                  Responsive="true"
                  PageSize="PageSize"
                  Class="datagrid-detail">
            <LoadingTemplate>
                <Row Class="w-100 align-items-center" Style="height: 150px;">
                    <Column>
                       <RadarSpinner />
                    </Column>
                </Row>
            </LoadingTemplate>
            <EmptyTemplate>
                <Row Class="w-100 align-items-center" Style="height: 150px;">
                    <Column>
                        <Heading Size="HeadingSize.Is4" TextAlignment="TextAlignment.Center">@L["NoDataAvailable"]</Heading>
                    </Column>
                </Row>
            </EmptyTemplate>   
            <DataGridColumns>
                
                
                <DataGridEntityActionsColumn TItem="SliderHomePageDto" @ref="@EntityActionsColumn">
                    <DisplayTemplate>
                        <EntityActions TItem="SliderHomePageDto" EntityActionsColumn="@EntityActionsColumn">
                            <EntityAction TItem="SliderHomePageDto"
                                          Visible="@CanEditSliderHomePage"
                                          Clicked="async () => await OpenEditSliderHomePageModalAsync(context)"
                                          Text="@L["Edit"]"></EntityAction>
                            <EntityAction TItem="SliderHomePageDto"
                                          Visible="@CanDeleteSliderHomePage"
                                          Clicked="() => DeleteSliderHomePageAsync(context)"
                                          ConfirmationMessage="@(()=> L["DeleteConfirmationMessage"])"
                                          Text="@L["Delete"]"></EntityAction>

                        </EntityActions>
                    </DisplayTemplate>
                </DataGridEntityActionsColumn>
               
              <DataGridColumn TItem="SliderHomePageDto"
                      Field="TitleAr"
                      Caption="@L["TitleAr"]">
              </DataGridColumn>

              <DataGridColumn TItem="SliderHomePageDto"
                      Field="TitleEn"
                      Caption="@L["TitleEn"]">
              </DataGridColumn>

              <DataGridColumn TItem="SliderHomePageDto"
                      Field="DescriptionAr"
                      Caption="@L["DescriptionAr"]">
              </DataGridColumn>

              <DataGridColumn TItem="SliderHomePageDto"
                      Field="DescriptionEn"
                      Caption="@L["DescriptionEn"]">
              </DataGridColumn>

              <DataGridColumn TItem="SliderHomePageDto"
                      Field="ButtonTitleAr"
                      Caption="@L["ButtonTitleAr"]">
              </DataGridColumn>

              <DataGridColumn TItem="SliderHomePageDto"
                      Field="ButtonTitleEn"
                      Caption="@L["ButtonTitleEn"]">
              </DataGridColumn>

              <DataGridColumn TItem="SliderHomePageDto"
                      Field="ButtonUrlEn"
                      Caption="@L["ButtonUrlEn"]">
              </DataGridColumn>

              <DataGridColumn TItem="SliderHomePageDto"
                      Field="ButtonUrlAr"
                      Caption="@L["ButtonUrlAr"]">
              </DataGridColumn>

              <DataGridColumn TItem="SliderHomePageDto"
                      Field="Image"
                      Caption="@L["Image"]">
              </DataGridColumn>

              <DataGridColumn TItem="SliderHomePageDto"
                      Field="YoutubeUrl"
                      Caption="@L["YoutubeUrl"]">
              </DataGridColumn>

              <DataGridColumn TItem="SliderHomePageDto"
                      Field="IsActive"
                      Caption="@L["IsActive"]">
                    <DisplayTemplate>
                        @if (context.IsActive)
                        {
                            <Icon TextColor="TextColor.Success" Name="@IconName.Check" />
                        }
                        else
                        {
                            <Icon TextColor="TextColor.Danger" Name="@IconName.Times" />
                        }
                    </DisplayTemplate>
              </DataGridColumn>


              <DataGridColumn TItem="SliderHomePageDto"
                      Field="Order"
                      Caption="@L["Order"]">
              </DataGridColumn>

            </DataGridColumns>
            
            
        </DataGrid>
    </CardBody>
</Card>

@* ************************* CREATE MODAL ************************* *@
<Modal @ref="CreateSliderHomePageModal" Closing="@CreateSliderHomePageModal.CancelClosingModalWhenFocusLost">
    <ModalContent Centered="true">

        <Form id="CreateSliderHomePageForm">
            <ModalHeader>
                <ModalTitle>@L["NewSliderHomePage"]</ModalTitle>
                <CloseButton Clicked="CloseCreateSliderHomePageModalAsync" />
            </ModalHeader>
            <ModalBody>
                <Validations @ref="@NewSliderHomePageValidations"
                            Mode="ValidationMode.Auto"
                            Model="@NewSliderHomePage"
                            ValidateOnLoad="false">
                    
                    
                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["TitleAr"] *</FieldLabel>
                            <TextEdit @bind-Text="@NewSliderHomePage.TitleAr"  >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["TitleEn"] *</FieldLabel>
                            <TextEdit @bind-Text="@NewSliderHomePage.TitleEn"  >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["DescriptionAr"] *</FieldLabel>
                            <TextEdit @bind-Text="@NewSliderHomePage.DescriptionAr"  >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["DescriptionEn"] *</FieldLabel>
                            <TextEdit @bind-Text="@NewSliderHomePage.DescriptionEn"  >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["ButtonTitleAr"]</FieldLabel>
                            <TextEdit @bind-Text="@NewSliderHomePage.ButtonTitleAr"  >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["ButtonTitleEn"]</FieldLabel>
                            <TextEdit @bind-Text="@NewSliderHomePage.ButtonTitleEn"  >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["ButtonUrlEn"]</FieldLabel>
                            <TextEdit @bind-Text="@NewSliderHomePage.ButtonUrlEn"  >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["ButtonUrlAr"]</FieldLabel>
                            <TextEdit @bind-Text="@NewSliderHomePage.ButtonUrlAr"  >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["Image"]</FieldLabel>
                            <TextEdit @bind-Text="@NewSliderHomePage.Image"  >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["YoutubeUrl"]</FieldLabel>
                            <TextEdit @bind-Text="@NewSliderHomePage.YoutubeUrl"  >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Field>
                        <Check TValue="bool" @bind-Checked="@NewSliderHomePage.IsActive" >@L["IsActive"]</Check>
                    </Field>

                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["Order"]</FieldLabel>
                            <NumericPicker TValue="int" @bind-Value="@NewSliderHomePage.Order"  Decimals="0" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                             </NumericPicker>
                        </Field>
                     </Validation>


                    
                    
                </Validations>
            </ModalBody>
            <ModalFooter>
                <Button Color="Color.Secondary"
                        Clicked="CloseCreateSliderHomePageModalAsync">
                    @L["Cancel"]
                </Button>
                <SubmitButton Form="CreateSliderHomePageForm" Clicked="CreateSliderHomePageAsync"/>

            </ModalFooter>
        </Form>

    </ModalContent>
</Modal>

@* ************************* EDIT MODAL ************************* *@
