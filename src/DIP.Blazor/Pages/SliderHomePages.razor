                    </Validation>


                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["ButtonUrlAr"]</FieldLabel>
                            <TextEdit @bind-Text="@EditingSliderHomePage.ButtonUrlAr"  >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["Image"]</FieldLabel>
                            <TextEdit @bind-Text="@EditingSliderHomePage.Image"  >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["YoutubeUrl"]</FieldLabel>
                            <TextEdit @bind-Text="@EditingSliderHomePage.YoutubeUrl"  >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Field>
                        <Check TValue="bool" @bind-Checked="@EditingSliderHomePage.IsActive" >@L["IsActive"]</Check>
                    </Field>

                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["Order"]</FieldLabel>
                            <NumericPicker TValue="int" @bind-Value="@EditingSliderHomePage.Order"  Decimals="0" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                             </NumericPicker>
                        </Field>
                     </Validation>


                    
                    
                </Validations>
            </ModalBody>
            <ModalFooter>
                <Button Color="Color.Secondary"
                        Clicked="CloseEditSliderHomePageModalAsync">
                    @L["Cancel"]
                </Button>
                <SubmitButton Form="EditSliderHomePageForm" Clicked="UpdateSliderHomePageAsync" />

            </ModalFooter>
        </Form>

    </ModalContent>
</Modal>

