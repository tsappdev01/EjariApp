                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["MetaTitleAr"]</FieldLabel>
                            <TextEdit @bind-Text="@EditingEService.MetaTitleAr" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["MetaDescriptionEn"]</FieldLabel>
                            <TextEdit @bind-Text="@EditingEService.MetaDescriptionEn" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["MetaDescriptionAr"]</FieldLabel>
                            <TextEdit @bind-Text="@EditingEService.MetaDescriptionAr" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["Order"]</FieldLabel>
                            <NumericPicker TValue="int" @bind-Value="@EditingEService.Order"  Decimals="0">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                             </NumericPicker>
                        </Field>
                     </Validation>


                    <Field>
                        <Check TValue="bool" @bind-Checked="@EditingEService.IsActive">@L["IsActive"]</Check>
                    </Field>

                    
                    
                </Validations>
            </ModalBody>
            <ModalFooter>
                <Button Color="Color.Secondary"
                        Clicked="CloseEditEServiceModalAsync">
                    @L["Cancel"]
                </Button>
                <SubmitButton Form="CreateEServiceForm" Clicked="UpdateEServiceAsync" />
            </ModalFooter>
        </Form>
    </ModalContent>
</Modal>
