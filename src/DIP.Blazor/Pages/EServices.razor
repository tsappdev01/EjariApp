

@page "/e-services"

@attribute [Authorize(DIPPermissions.EServices.Default)]
@using DIP.EServices
@using DIP.Localization
@using DIP.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Components.Web
@using Blazorise
@using Blazorise.Components
@using Blazorise.DataGrid
@using Volo.Abp.BlazoriseUI
@using Volo.Abp.BlazoriseUI.Components
@using Volo.Abp.ObjectMapping
@using Volo.Abp.AspNetCore.Components.Messages
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout
@using DIP.Permissions
@using Microsoft.AspNetCore.Components
@using Volo.Abp.AspNetCore.Components.Web
@using Volo.Abp.Http.Client
@inherits DIPComponentBase
@inject IEServicesAppService EServicesAppService
@inject IUiMessageService UiMessageService
@inject IRemoteServiceConfigurationProvider RemoteServiceConfigurationProvider
@inject NavigationManager NavigationManager

@* ************************* PAGE HEADER ************************* *@
<PageHeader Title="@L["EServices"]" BreadcrumbItems="BreadcrumbItems" Toolbar="Toolbar">

</PageHeader>

@* ************************* SEARCH ************************* *@
<Card>
    <CardBody>
        <Form id="EServiceSearchForm" class="mb-3">
            <Addons>
                <Addon AddonType="AddonType.Body">
                    <TextEdit @bind-Text="@Filter.FilterText"
                              Autofocus="true"
                              Placeholder="@L["Search"]">
                    </TextEdit>
                </Addon>
                <Addon AddonType="AddonType.End">
                    <SubmitButton Form="EServiceSearchForm" Clicked="GetEServicesAsync">
                        <Icon Name="IconName.Search" Class="me-1"></Icon>@L["Search"]
                    </SubmitButton>
                </Addon>
            </Addons>
        </Form>
    </CardBody>
</Card>

@* ************************* DATA GRID ************************* *@
<Card>
    <CardBody>
        <DataGrid TItem="EServiceDto"
                  Data="EServiceList"
                  ReadData="OnDataGridReadAsync"
                  TotalItems="TotalCount"
                  ShowPager="true"
                  Responsive="true"
                  PageSize="PageSize">
            <DataGridColumns>
                <DataGridEntityActionsColumn TItem="EServiceDto" @ref="@EntityActionsColumn">
                    <DisplayTemplate>
                        <EntityActions TItem="EServiceDto" EntityActionsColumn="@EntityActionsColumn">
                            <EntityAction TItem="EServiceDto"
                                          Visible="@CanEditEService"
                                          Clicked="async () => await OpenEditEServiceModalAsync(context)"
                                          Text="@L["Edit"]"></EntityAction>
                            <EntityAction TItem="EServiceDto"
                                          Visible="@CanDeleteEService"
                                          Clicked="() => DeleteEServiceAsync(context)"
                                          ConfirmationMessage="@(()=> L["DeleteConfirmationMessage"])"
                                          Text="@L["Delete"]"></EntityAction>
                        </EntityActions>
                    </DisplayTemplate>
                </DataGridEntityActionsColumn>
               
              <DataGridColumn TItem="EServiceDto"
                      Field="TitleEn"
                      Caption="@L["TitleEn"]">
              </DataGridColumn>

              <DataGridColumn TItem="EServiceDto"
                      Field="TitleAr"
                      Caption="@L["TitleAr"]">
              </DataGridColumn>

              <DataGridColumn TItem="EServiceDto"
                      Field="Slug"
                      Caption="@L["Slug"]">
              </DataGridColumn>

              <DataGridColumn TItem="EServiceDto"
                      Field="DescriptionEn"
                      Caption="@L["DescriptionEn"]">
              </DataGridColumn>

              <DataGridColumn TItem="EServiceDto"
                      Field="DescriptionAr"
                      Caption="@L["DescriptionAr"]">
              </DataGridColumn>

              <DataGridColumn TItem="EServiceDto"
                      Field="Image"
                      Caption="@L["Image"]">
              </DataGridColumn>

              <DataGridColumn TItem="EServiceDto"
                      Field="HeaderImage"
                      Caption="@L["HeaderImage"]">
              </DataGridColumn>

              <DataGridColumn TItem="EServiceDto"
                      Field="MetaTitleEn"
                      Caption="@L["MetaTitleEn"]">
              </DataGridColumn>

              <DataGridColumn TItem="EServiceDto"
                      Field="MetaTitleAr"
                      Caption="@L["MetaTitleAr"]">
              </DataGridColumn>

              <DataGridColumn TItem="EServiceDto"
                      Field="MetaDescriptionEn"
                      Caption="@L["MetaDescriptionEn"]">
              </DataGridColumn>

              <DataGridColumn TItem="EServiceDto"
                      Field="MetaDescriptionAr"
                      Caption="@L["MetaDescriptionAr"]">
              </DataGridColumn>

              <DataGridColumn TItem="EServiceDto"
                      Field="Order"
                      Caption="@L["Order"]">
              </DataGridColumn>

              <DataGridColumn TItem="EServiceDto"
                      Field="IsActive"
                      Caption="@L["IsActive"]">
                    <DisplayTemplate>
                        @if (context.IsActive)
                        {
                            <Icon TextColor="TextColor.Success" Name="@IconName.Check" />
                        }
                        else
                        {
                            <Icon TextColor="TextColor.Danger" Name="@IconName.Times" />
                        }
                    </DisplayTemplate>
              </DataGridColumn>


            </DataGridColumns>
        </DataGrid>
    </CardBody>
</Card>

@* ************************* CREATE MODAL ************************* *@
<Modal @ref="CreateEServiceModal" Closing="@CreateEServiceModal.CancelClosingModalWhenFocusLost">
    <ModalContent Centered="true">
        <Form id="CreateEServiceForm">
            <ModalHeader>
                <ModalTitle>@L["NewEService"]</ModalTitle>
                <CloseButton Clicked="CloseCreateEServiceModalAsync" />
            </ModalHeader>
            <ModalBody>
                <Validations @ref="@NewEServiceValidations"
                            Mode="ValidationMode.Auto"
                            Model="@NewEService"
                            ValidateOnLoad="false">
                     
                    
                    <Validation>
                        <Field>
                            <FieldLabel>@L["TitleEn"] *</FieldLabel>
                            <TextEdit @bind-Text="@NewEService.TitleEn" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["TitleAr"]</FieldLabel>
                            <TextEdit @bind-Text="@NewEService.TitleAr" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["Slug"] *</FieldLabel>
                            <TextEdit @bind-Text="@NewEService.Slug" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["DescriptionEn"]</FieldLabel>
                            <TextEdit @bind-Text="@NewEService.DescriptionEn" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["DescriptionAr"]</FieldLabel>
                            <TextEdit @bind-Text="@NewEService.DescriptionAr" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["Image"]</FieldLabel>
                            <TextEdit @bind-Text="@NewEService.Image" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["HeaderImage"]</FieldLabel>
                            <TextEdit @bind-Text="@NewEService.HeaderImage" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["MetaTitleEn"]</FieldLabel>
                            <TextEdit @bind-Text="@NewEService.MetaTitleEn" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["MetaTitleAr"]</FieldLabel>
                            <TextEdit @bind-Text="@NewEService.MetaTitleAr" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["MetaDescriptionEn"]</FieldLabel>
                            <TextEdit @bind-Text="@NewEService.MetaDescriptionEn" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["MetaDescriptionAr"]</FieldLabel>
                            <TextEdit @bind-Text="@NewEService.MetaDescriptionAr" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["Order"]</FieldLabel>
                            <NumericPicker TValue="int" @bind-Value="@NewEService.Order"  Decimals="0">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                             </NumericPicker>
                        </Field>
                     </Validation>


                    <Field>
                        <Check TValue="bool" @bind-Checked="@NewEService.IsActive">@L["IsActive"]</Check>
                    </Field>

                    
                    
                </Validations>
            </ModalBody>
            <ModalFooter>
                <Button Color="Color.Secondary"
                        Clicked="CloseCreateEServiceModalAsync">
                    @L["Cancel"]
                </Button>
                <SubmitButton Form="CreateEServiceForm" Clicked="CreateEServiceAsync" />
            </ModalFooter>
        </Form>
    </ModalContent>
</Modal>

@* ************************* EDIT MODAL ************************* *@
