                            <TextEdit @bind-Text="@EditingPressRelease.HeaderImage" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["DescriptionAr"]</FieldLabel>
                            <TextEdit @bind-Text="@EditingPressRelease.DescriptionAr" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["DescriptionEn"]</FieldLabel>
                            <TextEdit @bind-Text="@EditingPressRelease.DescriptionEn" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["SummaryEn"] *</FieldLabel>
                            <TextEdit @bind-Text="@EditingPressRelease.SummaryEn" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
