                            <FieldLabel>@L["PlotCategory"] *</FieldLabel>
                            <TextEdit @bind-Text="@EditingFeedBack.PlotCategory" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["ContactPersonName"] *</FieldLabel>
                            <TextEdit @bind-Text="@EditingFeedBack.ContactPersonName" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["EmailId"] *</FieldLabel>
                            <TextEdit @bind-Text="@EditingFeedBack.EmailId"  Role="TextRole.Email">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["MobileNumber"] *</FieldLabel>
                            <TextEdit @bind-Text="@EditingFeedBack.MobileNumber" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["Department"] *</FieldLabel>
                            <TextEdit @bind-Text="@EditingFeedBack.Department" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["CategoryName"] *</FieldLabel>
                            <TextEdit @bind-Text="@EditingFeedBack.CategoryName" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["Description"] *</FieldLabel>
                            <TextEdit @bind-Text="@EditingFeedBack.Description" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    
                    
                </Validations>
            </ModalBody>
            <ModalFooter>
                <Button Color="Color.Secondary"
                        Clicked="CloseEditFeedBackModalAsync">
                    @L["Cancel"]
                </Button>
                <SubmitButton Form="CreateFeedBackForm" Clicked="UpdateFeedBackAsync" />
            </ModalFooter>
        </Form>
    </ModalContent>
</Modal>
