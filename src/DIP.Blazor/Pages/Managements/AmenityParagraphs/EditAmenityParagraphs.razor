@page "/admin/amenity-paragraphs/edit/{id}"
@page "/admin/amenity-paragraphs/create/"
@attribute [Authorize(DIPPermissions.AmenityParagraphs.Default)]
@using DIP.AmenityParagraphs
@using DIP.Blazor.Components
@using DIP.Localization
@using DIP.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Components.Web
@using Blazorise
@using Blazorise.Components
@using Blazorise.DataGrid
@using Volo.Abp.BlazoriseUI
@using Volo.Abp.BlazoriseUI.Components
@using Volo.Abp.ObjectMapping
@using Volo.Abp.AspNetCore.Components.Messages
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout
@using DIP.Permissions
@using Microsoft.AspNetCore.Components
@using Volo.Abp.AspNetCore.Components.Web
@using Volo.Abp.Http.Client
@inherits DIPComponentBase
@inject IAmenityParagraphsAppService AmenityParagraphsAppService
@inject IUiMessageService UiMessageService
@inject IRemoteServiceConfigurationProvider RemoteServiceConfigurationProvider
@inject NavigationManager NavigationManager

@* ************************* PAGE HEADER ************************* *@

<PageHeader Title="@( $"{L[Id.IsNullOrEmpty()? "Create":"Update"]} {L["AmenityParagraphs"]}")" BreadcrumbItems="BreadcrumbItems" Toolbar="Toolbar">

</PageHeader>



@* ************************* CREATE MODAL ************************* *@


<Card>
    @if (Id.IsNullOrEmpty())
    {
        <Form id="CreateAmenityParagraphForm">
            <CardBody>
                <Tabs SelectedTab="@SelectedCreateTab" SelectedTabChanged="@OnSelectedCreateTabChanged">
                    <Items>
                        <Tab Name="create-tab-english">@L["English"]</Tab>
                        <Tab Name="create-tab-arabic">@L["Arabic"]</Tab>
                    </Items>
                    <Content>
                        <Validations @ref="@NewAmenityParagraphValidations"
                                 Mode="ValidationMode.Auto"
                                 Model="@NewAmenityParagraph"
                                 ValidateOnLoad="false">
                            <TabPanel Name="create-tab-english">

                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["TitleEn"]</FieldLabel>
                                        <TextEdit @bind-Text="@NewAmenityParagraph.TitleEn">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>

                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["SubTitleEn"]</FieldLabel>
                                        <TextEdit @bind-Text="@NewAmenityParagraph.SubTitleEn">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>

                                <Field>
                                    <FieldLabel>@L["DescriptionEn"]</FieldLabel>
                                    <CustomRichTextEditor ContentChanged="@CreatingDescriptionEnOnContentChanged"></CustomRichTextEditor>
                                </Field>
                                @if (DescriptionEnValidationError)
                                {
                                    <div class="alert alert-danger">
                                        @L["Message:DescriptionEnRequired"]
                                    </div>
                                }

                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["ButtonUrl"]</FieldLabel>
                                        <TextEdit @bind-Text="@NewAmenityParagraph.ButtonUrl">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>

                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["Order"]</FieldLabel>
                                        <NumericPicker TValue="int" @bind-Value="@NewAmenityParagraph.Order" Decimals="0">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </NumericPicker>
                                    </Field>
                                </Validation>

                                <Field>
                                    <Check TValue="bool" @bind-Checked="@NewAmenityParagraph.IsActive">@L["IsActive"]</Check>
                                </Field>

                                <Field>
                                    <FieldLabel>@L["Amenity"]</FieldLabel>
                                    <Select TValue="Guid" SelectedValue="@NewAmenityParagraph.AmenityId" SelectedValueChanged="@OnSelectedValueChanged">
                                        @foreach (var amenity in AmenitiesCollection)
                                        {
                                            <SelectItem TValue="Guid" Value="@amenity.Id">
                                                @amenity.DisplayName
                                            </SelectItem>
                                        }
                                    </Select>
                                </Field>

     @*                           <Field>
                                    <FieldLabel>@L["Amenity"] *</FieldLabel>
                                    <Autocomplete Data="@AmenitiesCollection"
                                              TItem="LookupDto<Guid>"
                                              TValue="Guid"
                                              TextField="@((item) => item?.DisplayName)"
                                              ValueField="@((item) => item?.Id ?? default)"
                                              SearchChanged="@GetAmenityCollectionLookupAsync"
                                              @bind-SelectedValue="@NewAmenityParagraph.AmenityId"
                                              Placeholder="&#8212;" />
                                </Field>*@

                            </TabPanel>

                            <TabPanel Name="create-tab-arabic">
                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["TitleAr"]</FieldLabel>
                                        <TextEdit @bind-Text="@NewAmenityParagraph.TitleAr">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>

                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["SubTitleAr"]</FieldLabel>
                                        <TextEdit @bind-Text="@NewAmenityParagraph.SubTitleAr">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>

                                <Field>
                                    <FieldLabel>@L["DescriptionAr"]</FieldLabel>
                                    <CustomRichTextEditor ContentChanged="@CreatingDescriptionArOnContentChanged"></CustomRichTextEditor>
                                </Field>
                                @if (DescriptionArValidationError)
                                {
                                    <div class="alert alert-danger">
                                        @L["Message:DescriptionArRequired"]
                                    </div>
                                }
                            </TabPanel>

                        </Validations>

                    </Content>
                </Tabs>
            </CardBody>
            <CardFooter>
                <SubmitButton Form="CreateAmenityParagraphForm" Clicked="Cancel">@L["Cancel"]</SubmitButton>
                <SubmitButton Form="CreateAmenityParagraphForm" Clicked="async()=> await CreateAmenityParagraphAsync()" />
            </CardFooter>


        </Form>

    }
    else
    {

        <Form id="EditAmenityParagraphForm">

            <CardBody>
                <Tabs SelectedTab="@SelectedEditTab" SelectedTabChanged="@OnSelectedEditTabChanged">
                    <Items>
                        <Tab Name="edit-tab-english">@L["English"]</Tab>
                        <Tab Name="edit-tab-arabic">@L["Arabic"]</Tab>
                    </Items>
                    <Content>
                        <Validations @ref="@EditingAmenityParagraphValidations"
                                 Mode="ValidationMode.Auto"
                                 Model="@EditingAmenityParagraph"
                                 ValidateOnLoad="false">
                            <TabPanel Name="edit-tab-english">

                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["TitleEn"]</FieldLabel>
                                        <TextEdit @bind-Text="@EditingAmenityParagraph.TitleEn">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>

                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["SubTitleEn"]</FieldLabel>
                                        <TextEdit @bind-Text="@EditingAmenityParagraph.SubTitleEn">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>

                                <Field>
                                    <FieldLabel>@L["DescriptionEn"]</FieldLabel>
                                    <CustomRichTextEditor InitValue="@EditingAmenityParagraph.DescriptionEn" ContentChanged="@EditingDescriptionEnOnContentChanged"></CustomRichTextEditor>
                                </Field>
                                @if (DescriptionEnValidationError)
                                {
                                    <div class="alert alert-danger">
                                        @L["Message:DescriptionEnRequired"]
                                    </div>
                                }

                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["ButtonUrl"]</FieldLabel>
                                        <TextEdit @bind-Text="@EditingAmenityParagraph.ButtonUrl">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>


                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["Order"]</FieldLabel>
                                        <NumericPicker TValue="int" @bind-Value="@EditingAmenityParagraph.Order" Decimals="0">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </NumericPicker>
                                    </Field>
                                </Validation>


                                <Field>
                                    <Check TValue="bool" @bind-Checked="@EditingAmenityParagraph.IsActive">@L["IsActive"]</Check>
                                </Field>

                                                                <Field>
                                    <FieldLabel>@L["Amenity"]</FieldLabel>
                                    <Select TValue="Guid" SelectedValue="@EditingAmenityParagraph.AmenityId" SelectedValueChanged="@OnSelectedEditValueChanged">
                                        @foreach (var amenity in AmenitiesCollection)
                                        {
                                            <SelectItem TValue="Guid" Value="@amenity.Id">
                                                @amenity.DisplayName
                                            </SelectItem>
                                        }
                                    </Select>
                                </Field>
                            </TabPanel>
                            <TabPanel Name="edit-tab-arabic">


                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["TitleAr"]</FieldLabel>
                                        <TextEdit @bind-Text="@EditingAmenityParagraph.TitleAr">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>

                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["SubTitleAr"]</FieldLabel>
                                        <TextEdit @bind-Text="@EditingAmenityParagraph.SubTitleAr">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>

                                <Field>
                                    <FieldLabel>@L["DescriptionAr"]</FieldLabel>
                                    <CustomRichTextEditor InitValue="@EditingAmenityParagraph.DescriptionAr" ContentChanged="@EditingDescriptionArOnContentChanged"></CustomRichTextEditor>
                                </Field>
                                @if (DescriptionArValidationError)
                                {
                                    <div class="alert alert-danger">
                                        @L["Message:DescriptionArRequired"]
                                    </div>
                                }
                            </TabPanel>
                        </Validations>
                    </Content>
                </Tabs>
            </CardBody>
            <CardFooter>
                <SubmitButton Form="EditAmenityParagraphForm" Clicked="Cancel">@L["Cancel"]</SubmitButton>
                <SubmitButton Form="EditAmenityParagraphForm" Clicked="async()=> await UpdateAmenityParagraphAsync()" />
            </CardFooter>
        </Form>

    }
</Card>

