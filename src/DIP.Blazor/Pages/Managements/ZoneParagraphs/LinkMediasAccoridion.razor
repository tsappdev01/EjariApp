@page "/admin/zone-paragraphs/medias-acccordion/{id}"

@attribute [Authorize(DIPPermissions.Medias.Default)]
@using DIP.Blazor.Components
@using DIP.Blazor.Components.Layout;
@using DIP.Localization
@using DIP.Shared
@using DIP.Helper
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Components.Web
@using Blazorise
@using Blazorise.Components
@using Blazorise.DataGrid
@using Volo.Abp.BlazoriseUI
@using Volo.Abp.BlazoriseUI.Components
@using Volo.Abp.ObjectMapping
@using Volo.Abp.AspNetCore.Components.Messages
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout
@using DIP.Permissions
@using Microsoft.AspNetCore.Components
@using Volo.Abp.AspNetCore.Components.Web
@using Volo.Abp.Http.Client
@inherits DIPComponentBase
@inject IUiMessageService UiMessageService
@inject IRemoteServiceConfigurationProvider RemoteServiceConfigurationProvider
@inject NavigationManager NavigationManager

@* ************************* PAGE HEADER ************************* *@
<PageHeader Title="@( $"{L["Update"]} {L["MediaGalleries"]}")" BreadcrumbItems="BreadcrumbItems" Toolbar="Toolbar">

</PageHeader>

@* ************************* SEARCH ************************* *@


@* ************************* DATA GRID ************************* *@
<Card>
    <Form id="EditZoneParagraphForm">
        <Validations @ref="@EditingZoneParagraphValidations"
                     Mode="ValidationMode.Auto"
                     Model="@ZoneParagraphDto"
                     ValidateOnLoad="false">
            @if (ZoneParagraphDto != null)
            {
                <Card>
                    <CardTitle>@L["ZoneParagraphs"].Value</CardTitle>
                    <CardBody>
                        <Validations @ref="@EditingZoneParagraphValidations"
                                 Mode="ValidationMode.Auto"
                                 Model="@ZoneParagraphDto"
                                 ValidateOnLoad="false">
                            <Validation>
                                <Field>
                                    <FieldLabel>@L["TitleEn"]</FieldLabel>
                                    <TextEdit @bind-Text="@ZoneParagraphDto.TitleEn" Disabled>
                                        <Feedback>
                                            <ValidationError />
                                        </Feedback>
                                    </TextEdit>
                                </Field>
                            </Validation>
                            <Validation>
                                <Field>
                                    <FieldLabel>@L["TitleAr"]</FieldLabel>
                                    <TextEdit @bind-Text="@ZoneParagraphDto.TitleAr" Disabled>
                                        <Feedback>
                                            <ValidationError />
                                        </Feedback>
                                    </TextEdit>
                                </Field>
                            </Validation>
                        </Validations>

                        <Div Class="mb-2">
                            <Button Class="btn-light" Clicked="async ()=>await addNewMediaAsync()"><Icon Name="@IconName.Add" /> @L["Add"] @L["Media"]</Button>
                        </Div>
                        <Accordion>
                            @if (!MediaDtos.IsNullOrEmpty())
                            {
                                foreach (var (item, index) in MediaDtos.WithIndex())
                                {
                                    <Collapse>
                                        <CollapseHeader>
                                            <Heading Size="HeadingSize.Is5">
                                                <AccordionToggle>@L["Media"] @(index + 1)</AccordionToggle>
                                                </Heading>
                                            </CollapseHeader>
                                            <CollapseBody>
                                                <CustomMedia Media="item" MediaDeleted="MediaDelated"></CustomMedia>
                                            </CollapseBody>
                                    </Collapse>
                                }
                            }
                        </Accordion>
                    </CardBody>
                    <CardFooter>
                        <SubmitButton Form="EditZoneParagraphForm" Clicked="Cancel">@L["Cancel"]</SubmitButton>
                        <SubmitButton Form="EditZoneParagraphForm" Clicked="async()=> await UpdateMediaGalleryMediasAsync()" />
                    </CardFooter>
                </Card>
            }
        </Validations>
    </Form>
</Card>