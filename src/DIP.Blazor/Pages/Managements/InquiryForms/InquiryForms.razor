@page "/admin/inquiry-forms"

@attribute [Authorize(DIPPermissions.InquiryForms.Default)]
@using DIP.InquiryForms
@using DIP.Localization
@using DIP.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Components.Web
@using Blazorise
@using Blazorise.Components
@using Blazorise.DataGrid
@using Volo.Abp.BlazoriseUI
@using Volo.Abp.BlazoriseUI.Components
@using Volo.Abp.ObjectMapping
@using Volo.Abp.AspNetCore.Components.Messages
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout
@using DIP.Permissions
@using Microsoft.AspNetCore.Components
@using Volo.Abp.AspNetCore.Components.Web
@using Volo.Abp.Http.Client
@inherits DIPComponentBase
@inject IInquiryFormsAppService InquiryFormsAppService
@inject IUiMessageService UiMessageService
@inject IRemoteServiceConfigurationProvider RemoteServiceConfigurationProvider
@inject NavigationManager NavigationManager

@* ************************* PAGE HEADER ************************* *@
<PageHeader Title="@L["InquiryForms"]" BreadcrumbItems="BreadcrumbItems" Toolbar="Toolbar">

</PageHeader>

@* ************************* SEARCH ************************* *@
<Card>
    <CardBody>
        <Form id="InquiryFormSearchForm" class="mb-3">
            <Addons>
                <Addon AddonType="AddonType.Body">
                    <TextEdit @bind-Text="@Filter.FilterText"
                              Autofocus="true"
                              Placeholder="@L["Search"]">
                    </TextEdit>
                </Addon>
                <Addon AddonType="AddonType.End">
                    <SubmitButton Form="InquiryFormSearchForm" Clicked="GetInquiryFormsAsync">
                        <Icon Name="IconName.Search" Class="me-1"></Icon>@L["Search"]
                    </SubmitButton>
                </Addon>
            </Addons>
        </Form>
    </CardBody>
</Card>

@* ************************* DATA GRID ************************* *@
<Card>
    <CardBody>
        <DataGrid TItem="InquiryFormDto"
                  Data="InquiryFormList"
                  ReadData="OnDataGridReadAsync"
                  TotalItems="TotalCount"
                  ShowPager="true"
                  Responsive="true"
                  PageSize="PageSize">
            <DataGridColumns>
                <DataGridEntityActionsColumn TItem="InquiryFormDto" @ref="@EntityActionsColumn">
                    <DisplayTemplate>
                        <EntityActions TItem="InquiryFormDto" EntityActionsColumn="@EntityActionsColumn">
                            <EntityAction TItem="InquiryFormDto"
                                          Clicked="async () => await OpenDetailsInquiryFormPageAsync(context)"
                                          Text="@L["Details"]"></EntityAction>
                            <EntityAction TItem="InquiryFormDto"
                                          Visible="@CanDeleteInquiryForm"
                                          Clicked="() => DeleteInquiryFormAsync(context)"
                                          ConfirmationMessage="@(()=> L["DeleteConfirmationMessage"])"
                                          Text="@L["Delete"]"></EntityAction>
                        </EntityActions>
                    </DisplayTemplate>
                </DataGridEntityActionsColumn>
               
              <DataGridColumn TItem="InquiryFormDto"
                      Field="CompanyName"
                      Caption="@L["CompanyName"]">
              </DataGridColumn>

              <DataGridColumn TItem="InquiryFormDto"
                      Field="Name"
                      Caption="@L["Name"]">
              </DataGridColumn>

              <DataGridColumn TItem="InquiryFormDto"
                      Field="InquiryType"
                      Caption="@L["InquiryType"]">
              </DataGridColumn>
                <DataGridColumn TItem="InquiryFormDto"
                                Field="CreationTime"
                                Caption="@L["CreationTime"]">
                    <DisplayTemplate>
                        @context.CreationTime.ToShortDateString()
                    </DisplayTemplate>
                </DataGridColumn>
            </DataGridColumns>
        </DataGrid>
    </CardBody>
</Card>
