@page "/admin/time-line-categories/edit/{id}"
@page "/admin/time-line-categories/create"

@attribute [Authorize(DIPPermissions.TimeLineCategories.Default)]
@using DIP.Blazor.Components
@using DIP.TimeLineCategories
@using DIP.Localization
@using DIP.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Components.Web
@using Blazorise
@using Blazorise.Components
@using Blazorise.DataGrid
@using Volo.Abp.BlazoriseUI
@using Volo.Abp.BlazoriseUI.Components
@using Volo.Abp.ObjectMapping
@using Volo.Abp.AspNetCore.Components.Messages
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout
@using DIP.Permissions
@using Microsoft.AspNetCore.Components
@using Volo.Abp.AspNetCore.Components.Web
@using Volo.Abp.Http.Client
@inherits DIPComponentBase
@inject ITimeLineCategoriesAppService TimeLineCategoriesAppService
@inject IUiMessageService UiMessageService
@inject IRemoteServiceConfigurationProvider RemoteServiceConfigurationProvider
@inject NavigationManager NavigationManager

@* ************************* PAGE HEADER ************************* *@


<PageHeader Title="@( $"{L[Id.IsNullOrEmpty()? "Create":"Update"]} {L["TimeLineCategories"]}")" BreadcrumbItems="BreadcrumbItems" Toolbar="Toolbar">

</PageHeader>

<Card>
    @if (Id.IsNullOrEmpty())
    {
        <Form id="CreateTimeLineCategoryForm">
          

                  <CardBody>
                <Tabs SelectedTab="@SelectedCreateTab" SelectedTabChanged="@OnSelectedCreateTabChanged">
                    <Items>
                        <Tab Name="create-tab-english">@L["English"]</Tab>
                        <Tab Name="create-tab-arabic">@L["Arabic"]</Tab>
                    </Items>
                    <Content>
                        <Validations @ref="@NewTimeLineCategoryValidations"
                                 Mode="ValidationMode.Auto"
                                 Model="@NewTimeLineCategory"
                                 ValidateOnLoad="false">
                            <TabPanel Name="create-tab-english">

                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["TitleEn"] *</FieldLabel>
                                        <TextEdit @bind-Text="@NewTimeLineCategory.TitleEn">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>

                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["Order"]</FieldLabel>
                                        <NumericPicker TValue="int" @bind-Value="@NewTimeLineCategory.Order" Decimals="0">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </NumericPicker>
                                    </Field>
                                </Validation>

                                <Field>
                                    <Check TValue="bool" @bind-Checked="@NewTimeLineCategory.IsActive">@L["IsActive"]</Check>
                                </Field>
                            </TabPanel>
                            <TabPanel Name="create-tab-arabic">

                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["TitleAr"] *</FieldLabel>
                                        <TextEdit @bind-Text="@NewTimeLineCategory.TitleAr">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>

                            </TabPanel>
                        </Validations>
                    </Content>
                </Tabs>
            </CardBody>
           
            <CardFooter>
                <SubmitButton Form="CreateTimeLineCategoryForm" Clicked="Cancel">@L["Cancel"]</SubmitButton>
                <SubmitButton Form="CreateTimeLineCategoryForm" Clicked="async()=> await CreateTimeLineCategoryAsync()" />
            </CardFooter>
        </Form>
    }
    else
    {
 <Form id="EditTimeLineCategoryForm">
            <CardBody>
                <Tabs SelectedTab="@SelectedEditTab" SelectedTabChanged="@OnSelectedEditTabChanged">
                    <Items>
                        <Tab Name="edit-tab-english">@L["English"]</Tab>
                        <Tab Name="edit-tab-arabic">@L["Arabic"]</Tab>
                    </Items>
                    <Content>
                    <Validations @ref="@EditingTimeLineCategoryValidations"
                             Mode="ValidationMode.Auto"
                             Model="@EditingTimeLineCategory"
                             ValidateOnLoad="false">
                            <TabPanel Name="edit-tab-english">

                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["TitleEn"] *</FieldLabel>
                                        <TextEdit @bind-Text="@EditingTimeLineCategory.TitleEn">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>

                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["Order"]</FieldLabel>
                                        <NumericPicker TValue="int" @bind-Value="@EditingTimeLineCategory.Order" Decimals="0">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </NumericPicker>
                                    </Field>
                                </Validation>

                                <Field>
                                    <Check TValue="bool" @bind-Checked="@EditingTimeLineCategory.IsActive">@L["IsActive"]</Check>
                                </Field>
                            </TabPanel>
                            <TabPanel Name="edit-tab-arabic">
                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["TitleAr"] *</FieldLabel>
                                        <TextEdit @bind-Text="@EditingTimeLineCategory.TitleAr">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>
                            </TabPanel>
                        </Validations>
                    </Content>
                </Tabs>
            </CardBody>
            <CardFooter>
                <SubmitButton Form="EditTimeLineCategoryForm" Clicked="Cancel">@L["Cancel"]</SubmitButton>
                <SubmitButton Form="EditTimeLineCategoryForm" Clicked="async()=> await UpdateTimeLineCategoryAsync()" />
            </CardFooter>
            </Form>







    
    }

</Card>



