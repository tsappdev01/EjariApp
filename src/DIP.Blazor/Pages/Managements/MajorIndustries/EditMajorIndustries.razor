



@page "/admin/major-industries/edit/{id}"
@page "/admin/major-industries/create"

@attribute [Authorize(DIPPermissions.MajorIndustries.Default)]
@using DIP.MajorIndustries
@using DIP.Localization
@using DIP.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Components.Web
@using Blazorise
@using Blazorise.Components
@using Blazorise.DataGrid
@using Volo.Abp.BlazoriseUI
@using Volo.Abp.BlazoriseUI.Components
@using Volo.Abp.ObjectMapping
@using Volo.Abp.AspNetCore.Components.Messages
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout
@using DIP.Permissions
@using Microsoft.AspNetCore.Components
@using Volo.Abp.AspNetCore.Components.Web
@using Volo.Abp.Http.Client
@inherits DIPComponentBase
@inject IMajorIndustriesAppService MajorIndustriesAppService
@inject IUiMessageService UiMessageService
@inject IRemoteServiceConfigurationProvider RemoteServiceConfigurationProvider
@inject NavigationManager NavigationManager

@* ************************* PAGE HEADER ************************* *@



<PageHeader Title="@( $"{L[Id.IsNullOrEmpty()? "Create":"Update"]} {L["MajorIndustries"]}")" BreadcrumbItems="BreadcrumbItems" Toolbar="Toolbar">

</PageHeader>




@* ************************* CREATE MODAL ************************* *@

<Card>
    @if (Id.IsNullOrEmpty())
    {
        <Form id="CreateMajorIndustryForm">
            <CardBody>
                <Tabs SelectedTab="@SelectedCreateTab" SelectedTabChanged="@OnSelectedCreateTabChanged">
                    <Items>
                        <Tab Name="create-tab-english">@L["English"]</Tab>
                        <Tab Name="create-tab-arabic">@L["Arabic"]</Tab>
                    </Items>
                    <Content>

                        <Validations @ref="@NewMajorIndustryValidations"
                            Mode="ValidationMode.Auto"
                            Model="@NewMajorIndustry"
                            ValidateOnLoad="false">
                            <TabPanel Name="create-tab-english">

                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["TitleEn"]</FieldLabel>
                                        <TextEdit @bind-Text="@NewMajorIndustry.TitleEn">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>

                                <Field>
                                    <FieldLabel>@L["Image"]</FieldLabel>
                                    <Row>
                                        <Column ColumnSize="ColumnSize.Is11">
                                            <FilePicker Multiple Changed="ImageChanged" Upload="OnImageUpload" ShowMode="FilePickerShowMode.List" />
                                            </Column>
                                            <Column ColumnSize="ColumnSize.Is1">
                                            <Button Color="Color.Primary" Clicked="async()=> await RemoveMedia()">@L["Reset"]</Button>
                                            </Column>
                                            </Row>
                                            @if (!MajorIndustryImage.IsNullOrEmpty() && !MajorIndustryImageContent.IsNullOrEmpty())
                                    {
                                        <div style="width:256px;height:256px;background-size: cover; background-image:url(@($"data:{MimeTypes.MimeTypeMap.GetMimeType(MajorIndustryImage)};base64,{Convert.ToBase64String(MajorIndustryImageContent)}"))"></div>
                                    }
                                </Field>
                                @if (ImageValidationError)
                                {
                                    <div class="alert alert-danger">
                                        @L["Message:ImageRequired"]
                                    </div>
                                }

                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["Order"]</FieldLabel>
                                        <NumericPicker TValue="int" @bind-Value="@NewMajorIndustry.Order" Decimals="0">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </NumericPicker>
                                    </Field>
                                </Validation>


                                <Field>
                                    <Check TValue="bool" @bind-Checked="@NewMajorIndustry.IsActive">@L["IsActive"]</Check>
                                </Field>

                                <Field>
                                    <FieldLabel>@L["Zone"]</FieldLabel>
                                    <Select TValue="Guid" @bind-SelectedValue="@NewMajorIndustry.ZoneId">
                                        @foreach (var zone in ZonesCollection)
                                        {
                                            <SelectItem TValue="Guid" Value="@zone.Id">
                                                @zone.DisplayName
                                            </SelectItem>
                                        }
                                    </Select>
                                </Field>
                            </TabPanel>


                            <TabPanel Name="create-tab-arabic">
                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["TitleAr"]</FieldLabel>
                                        <TextEdit @bind-Text="@NewMajorIndustry.TitleAr">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>
                            </TabPanel>











                        </Validations>
                    </Content>
                </Tabs>
            </CardBody>
            <CardFooter>
                <SubmitButton Form="CreateMajorIndustryForm" Clicked="Cancel">@L["Cancel"]</SubmitButton>
                <SubmitButton Form="CreateMajorIndustryForm" Clicked="async()=> await CreateMajorIndustryAsync()" />
            </CardFooter>
        </Form>
    }
    else
    {
        <Form id="EditMajorIndustryForm">
            <CardBody>
                <Tabs SelectedTab="@SelectedEditTab" SelectedTabChanged="@OnSelectedEditTabChanged">
                    <Items>
                        <Tab Name="edit-tab-english">@L["English"]</Tab>
                        <Tab Name="edit-tab-arabic">@L["Arabic"]</Tab>
                    </Items>
                    <Content>
                        <Validations @ref="@EditingMajorIndustryValidations"
                     Mode="ValidationMode.Auto"
                     Model="@EditingMajorIndustry"
                     ValidateOnLoad="false">

                            <TabPanel Name="edit-tab-english">
                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["TitleEn"]</FieldLabel>
                                        <TextEdit @bind-Text="@EditingMajorIndustry.TitleEn">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>


                                <Field>
                                    <FieldLabel>@L["Image"]</FieldLabel>
                                    <Row>
                                        <Column ColumnSize="ColumnSize.Is11">
                                            <FilePicker Multiple Changed="ImageChanged" Upload="OnImageUpload" ShowMode="FilePickerShowMode.List" />
                                            </Column>
                                            <Column ColumnSize="ColumnSize.Is1">
                                            <Button Color="Color.Primary" Clicked="async()=> await RemoveMedia()">@L["Reset"]</Button>
                                            </Column>
                                            </Row>
                                            @if (MajorIndustryImageNewUpload && !MajorIndustryImage.IsNullOrEmpty() && !MajorIndustryImageContent.IsNullOrEmpty())
                                    {
                                        <div style="width:256px;height:256px;background-size: cover; background-image:url(@($"data:{MimeTypes.MimeTypeMap.GetMimeType(MajorIndustryImage)};base64,{Convert.ToBase64String(MajorIndustryImageContent)}"))"></div>
                                    }
                                    else
                                    {
                                        if (!MajorIndustryImage.IsNullOrEmpty())
                                        {
                                            <div style="width:256px;height:256px;background-size: cover; background-image:url(@($"{MimeTypes.MimeTypeMap.GetAttachmentPath()}/majorIndustry/{MajorIndustryImage}"))"></div>
                                        }
                                    }
                                </Field>
                                @if (ImageValidationError)
                                {
                                    <div class="alert alert-danger">
                                        @L["Message:ImageRequired"]
                                    </div>
                                }

                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["Order"]</FieldLabel>
                                        <NumericPicker TValue="int" @bind-Value="@EditingMajorIndustry.Order" Decimals="0">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </NumericPicker>
                                    </Field>
                                </Validation>


                                <Field>
                                    <Check TValue="bool" @bind-Checked="@EditingMajorIndustry.IsActive">@L["IsActive"]</Check>
                                </Field>

                                <Field>
                                    <FieldLabel>@L["Zone"]</FieldLabel>
                                    <Select TValue="Guid" @bind-SelectedValue="@EditingMajorIndustry.ZoneId">
                                        @foreach (var zone in ZonesCollection)
                                        {
                                            <SelectItem TValue="Guid" Value="@zone.Id">
                                                @zone.DisplayName
                                            </SelectItem>
                                        }
                                    </Select>
                                </Field>
                            </TabPanel>


                            <TabPanel Name="edit-tab-arabic">
                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["TitleAr"]</FieldLabel>
                                        <TextEdit @bind-Text="@EditingMajorIndustry.TitleAr">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>
                            </TabPanel>
                        </Validations>
                    </Content>
                </Tabs>
            </CardBody>
            <CardFooter>
                <SubmitButton Form="EditMajorIndustryForm" Clicked="Cancel">@L["Cancel"]</SubmitButton>
                <SubmitButton Form="EditMajorIndustryForm" Clicked="async()=> await UpdateMajorIndustryAsync()" />
            </CardFooter>

        </Form>
    }
</Card>