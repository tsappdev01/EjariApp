

@page "/admin/major-industries"

@attribute [Authorize(DIPPermissions.MajorIndustries.Default)]
@using DIP.MajorIndustries
@using DIP.Localization
@using DIP.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Components.Web
@using Blazorise
@using Blazorise.Components
@using Blazorise.DataGrid
@using Volo.Abp.BlazoriseUI
@using Volo.Abp.BlazoriseUI.Components
@using Volo.Abp.ObjectMapping
@using Volo.Abp.AspNetCore.Components.Messages
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout
@using DIP.Permissions
@using Microsoft.AspNetCore.Components
@using Volo.Abp.AspNetCore.Components.Web
@using Volo.Abp.Http.Client
@inherits DIPComponentBase
@inject IMajorIndustriesAppService MajorIndustriesAppService
@inject IUiMessageService UiMessageService
@inject IRemoteServiceConfigurationProvider RemoteServiceConfigurationProvider
@inject NavigationManager NavigationManager

@* ************************* PAGE HEADER ************************* *@
<PageHeader Title="@L["MajorIndustries"]" BreadcrumbItems="BreadcrumbItems" Toolbar="Toolbar">

</PageHeader>

@* ************************* SEARCH ************************* *@
<Card>
    <CardBody>
        <Form id="MajorIndustrySearchForm" class="mb-3">
            <Addons>
                <Addon AddonType="AddonType.Body">
                    <TextEdit @bind-Text="@Filter.FilterText"
                              Autofocus="true"
                              Placeholder="@L["Search"]">
                    </TextEdit>
                </Addon>
                <Addon AddonType="AddonType.End">
                    <SubmitButton Form="MajorIndustrySearchForm" Clicked="GetMajorIndustriesAsync">
                        <Icon Name="IconName.Search" Class="me-1"></Icon>@L["Search"]
                    </SubmitButton>
                </Addon>
            </Addons>
        </Form>
    </CardBody>
</Card>

@* ************************* DATA GRID ************************* *@
<Card>
    <CardBody>
        <DataGrid TItem="MajorIndustryWithNavigationPropertiesDto"
                  Data="MajorIndustryList"
                  ReadData="OnDataGridReadAsync"
                  TotalItems="TotalCount"
                  ShowPager="true"
                  Responsive="true"
                  PageSize="PageSize">
            <DataGridColumns>
                <DataGridEntityActionsColumn TItem="MajorIndustryWithNavigationPropertiesDto" @ref="@EntityActionsColumn">
                    <DisplayTemplate>
                        <EntityActions TItem="MajorIndustryWithNavigationPropertiesDto" EntityActionsColumn="@EntityActionsColumn">
                            <EntityAction TItem="MajorIndustryWithNavigationPropertiesDto"
                                          Visible="@CanEditMajorIndustry"
                                          Clicked="async () => await EditAsync(context)"
                                          Text="@L["Edit"]"></EntityAction>
                            <EntityAction TItem="MajorIndustryWithNavigationPropertiesDto"
                                          Visible="@CanDeleteMajorIndustry"
                                          Clicked="() => DeleteMajorIndustryAsync(context)"
                                          ConfirmationMessage="@(()=> L["DeleteConfirmationMessage"])"
                                          Text="@L["Delete"]"></EntityAction>
                        </EntityActions>
                    </DisplayTemplate>
                </DataGridEntityActionsColumn>
               
              <DataGridColumn TItem="MajorIndustryWithNavigationPropertiesDto"
                      Field="MajorIndustry.TitleEn"
                      Caption="@L["TitleEn"]">
              </DataGridColumn>

              <DataGridColumn TItem="MajorIndustryWithNavigationPropertiesDto"
                      Field="MajorIndustry.TitleAr"
                      Caption="@L["TitleAr"]">
              </DataGridColumn>

              <DataGridColumn TItem="MajorIndustryWithNavigationPropertiesDto"
                      Field="MajorIndustry.Order"
                      Caption="@L["Order"]">
              </DataGridColumn>

              <DataGridColumn TItem="MajorIndustryWithNavigationPropertiesDto"
                      Field="MajorIndustry.IsActive"
                      Caption="@L["IsActive"]">
                    <DisplayTemplate>
                        @if (context.MajorIndustry.IsActive)
                        {
                            <Icon TextColor="TextColor.Success" Name="@IconName.Check" />
                        }
                        else
                        {
                            <Icon TextColor="TextColor.Danger" Name="@IconName.Times" />
                        }
                    </DisplayTemplate>
              </DataGridColumn>


              <DataGridColumn TItem="MajorIndustryWithNavigationPropertiesDto"
                      Field="Zone.TitleEn"
                      Caption="@L["Zone"]">
              </DataGridColumn>

            </DataGridColumns>
        </DataGrid>
    </CardBody>
</Card>


