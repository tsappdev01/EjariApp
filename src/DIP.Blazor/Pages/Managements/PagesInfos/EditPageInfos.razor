@page "/admin/page-infos/edit/{id}"
@page "/admin/page-infos/create"
@attribute [Authorize(DIPPermissions.PageInfos.Default)]
@using DIP.Blazor.Components
@using DIP.PageInfos
@using DIP.Localization
@using DIP.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Components.Web
@using Blazorise
@using Blazorise.Components
@using Blazorise.DataGrid
@using Volo.Abp.BlazoriseUI
@using Volo.Abp.BlazoriseUI.Components
@using Volo.Abp.ObjectMapping
@using Volo.Abp.AspNetCore.Components.Messages
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout
@using DIP.Permissions
@using Microsoft.AspNetCore.Components
@using Volo.Abp.AspNetCore.Components.Web
@using Volo.Abp.Http.Client
@inherits DIPComponentBase
@inject IPageInfosAppService PageInfosAppService
@inject IUiMessageService UiMessageService
@inject IRemoteServiceConfigurationProvider RemoteServiceConfigurationProvider
@inject NavigationManager NavigationManager

@* ************************* PAGE HEADER ************************* *@


<PageHeader Title="@( $"{L[Id.IsNullOrEmpty()? "Create":"Update"]} {L["PageInfos"]}")" BreadcrumbItems="BreadcrumbItems" Toolbar="Toolbar">

</PageHeader>

@* ************************* SEARCH ************************* *@

<Card>
    @if (Id.IsNullOrEmpty())
    {

        <Form id="CreatePageInfoForm">
            <CardBody>
                <Tabs SelectedTab="@SelectedCreateTab" SelectedTabChanged="@OnSelectedCreateTabChanged">
                    <Items>
                        <Tab Name="create-tab-english">@L["English"]</Tab>
                        <Tab Name="create-tab-arabic">@L["Arabic"]</Tab>
                    </Items>
                    <Content>
                        <Validations @ref="@NewPageInfoValidations"
                                 Mode="ValidationMode.Auto"
                                 Model="@NewPageInfo"
                                 ValidateOnLoad="false">

                            <TabPanel Name="create-tab-english">
                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["TitleEn"]</FieldLabel>
                                        <TextEdit TextExpression="@(()=>NewPageInfo.TitleEn)" TextChanged="@OnTitleEnChanged">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>

                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["Slug"]</FieldLabel>
                                        <TextEdit @bind-Text="@NewPageInfo.Slug">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>

                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["MetaTitleEn"]</FieldLabel>
                                        <TextEdit @bind-Text="@NewPageInfo.MetaTitleEn">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>
                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["PageInfoArticleTilteEn"]</FieldLabel>
                                        <TextEdit @bind-Text="@NewPageInfo.PageInfoArticleTilteEn">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>


                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["PageInfoArticleSubtitleEn"]</FieldLabel>
                                        <TextEdit @bind-Text="@NewPageInfo.PageInfoArticleSubtitleEn">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>

                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["SummaryEn"]</FieldLabel>
                                        <MemoEdit @bind-Text="@NewPageInfo.SummaryEn" Rows="3">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </MemoEdit>

                                        @*<TextEdit @bind-Text="@NewPageInfo.SummaryEn">
                                    <Feedback>
                                    <ValidationError />
                                    </Feedback>
                                    </TextEdit>*@
                                    </Field>
                                </Validation>

                                <Field>
                                    <FieldLabel>@L["DescriptionEn"]</FieldLabel>
                                    <CustomRichTextEditor ContentChanged="@CreatingDescriptionEnOnContentChanged"></CustomRichTextEditor>
                                </Field>

                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["MetaDescriptionEn"]</FieldLabel>
                                        <TextEdit @bind-Text="@NewPageInfo.MetaDescriptionEn">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>

                                <Field>
                                    <FieldLabel>@L["Image"]</FieldLabel>
                                    <Row>
                                        <Column ColumnSize="ColumnSize.Is11">
                                            <FilePicker Multiple Changed="ImageChanged" Upload="OnImageUpload" ShowMode="FilePickerShowMode.List" />
                                        </Column>
                                        <Column ColumnSize="ColumnSize.Is1">
                                            <Button Color="Color.Primary" Clicked="async()=> await RemoveMedia(true)">@L["Reset"]</Button>
                                        </Column>
                                    </Row>
                                    @if (!PageInfoImage.IsNullOrEmpty() && !PageInfoImageContent.IsNullOrEmpty())
                                    {
                                        <div style="width:256px;height:256px;background-size: cover; background-image:url(@($"data:{MimeTypes.MimeTypeMap.GetMimeType(PageInfoImage)};base64,{Convert.ToBase64String(PageInfoImageContent)}"))"></div>
                                    }
                                </Field>

                                <Field>
                                    <FieldLabel>@L["HeaderImage"]</FieldLabel>
                                    <Row>
                                        <Column ColumnSize="ColumnSize.Is11">
                                            <FilePicker Multiple Changed="HeaderImageChanged" Upload="OnHeaderImageUpload" ShowMode="FilePickerShowMode.List" />
                                        </Column>
                                        <Column ColumnSize="ColumnSize.Is1">
                                            <Button Color="Color.Primary" Clicked="async()=> await RemoveMedia(false)">@L["Reset"]</Button>
                                        </Column>
                                    </Row>
                                    @if (!PageInfoHeaderImage.IsNullOrEmpty() && !PageInfoHeaderImageContent.IsNullOrEmpty())
                                    {
                                        <div style="width:256px;height:256px;background-size: cover; background-image:url(@($"data:{MimeTypes.MimeTypeMap.GetMimeType(PageInfoHeaderImage)};base64,{Convert.ToBase64String(PageInfoHeaderImageContent)}"))"></div>
                                    }
                                </Field>
                                @if (HeaderImageValidationError)
                                {
                                    <div class="alert alert-danger">
                                        @L["Message:HeaderImageRequired"]
                                    </div>
                                }

                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["YouTubeUrl"]</FieldLabel>
                                        <TextEdit @bind-Text="@NewPageInfo.YouTubeUrl">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>

                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["Order"]</FieldLabel>
                                        <NumericPicker TValue="int" @bind-Value="@NewPageInfo.Order" Decimals="0">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </NumericPicker>
                                    </Field>
                                </Validation>
                                <Field>
                                    <Check TValue="bool" @bind-Checked="@NewPageInfo.IsActive">@L["IsActive"]</Check>
                                </Field>

                            </TabPanel>

                            <TabPanel Name="create-tab-arabic">

                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["TitleAr"]</FieldLabel>
                                        <TextEdit @bind-Text="@NewPageInfo.TitleAr">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>

                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["MetaTitleAr"]</FieldLabel>
                                        <TextEdit @bind-Text="@NewPageInfo.MetaTitleAr">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>

                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["PageInfoArticleTilteAr"]</FieldLabel>
                                        <TextEdit @bind-Text="@NewPageInfo.PageInfoArticleTilteAr">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>

                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["PageInfoArticleSubtitleAr"]</FieldLabel>
                                        <TextEdit @bind-Text="@NewPageInfo.PageInfoArticleSubtitleAr">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>

                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["SummaryAr"]</FieldLabel>
                                        <MemoEdit @bind-Text="@NewPageInfo.SummaryAr" Rows="3">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </MemoEdit>
                                 @*       <TextEdit @bind-Text="@NewPageInfo.SummaryAr">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>*@
                                    </Field>
                                </Validation>

                                <Field>
                                    <FieldLabel>@L["DescriptionAr"]</FieldLabel>
                                    <CustomRichTextEditor ContentChanged="@CreatingDescriptionArOnContentChanged"></CustomRichTextEditor>
                                </Field>

                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["MetaDescriptionAr"]</FieldLabel>
                                        <TextEdit @bind-Text="@NewPageInfo.MetaDescriptionAr">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>

                            </TabPanel>
                        </Validations>
                    </Content>
                </Tabs>
            </CardBody>
            <CardFooter>
                <SubmitButton Form="CreatePageInfoForm" Clicked="Cancel">@L["Cancel"]</SubmitButton>
                <SubmitButton Form="CreatePageInfoForm" Clicked="async()=> await CreatePageInfoAsync()" />
            </CardFooter>
        </Form>
    }
    else
    {

        <Form id="EditPageInfoForm">
            <CardBody>
                <Tabs SelectedTab="@SelectedEditTab" SelectedTabChanged="@OnSelectedEditTabChanged">
                    <Items>
                        <Tab Name="edit-tab-english">@L["English"]</Tab>
                        <Tab Name="edit-tab-arabic">@L["Arabic"]</Tab>
                    </Items>
                    <Content>

                        <Validations @ref="@EditingPageInfoValidations"
                                 Mode="ValidationMode.Auto"
                                 Model="@EditingPageInfo"
                                 ValidateOnLoad="false">
                            <TabPanel Name="edit-tab-english">

                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["TitleEn"]</FieldLabel>
                                        <TextEdit Text="@EditingPageInfo.TitleEn" TextExpression="@(()=>EditingPageInfo.TitleEn)" TextChanged="@OnTitleEnChanged">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>

                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["Slug"]</FieldLabel>
                                        <TextEdit @bind-Text="@EditingPageInfo.Slug">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>

                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["MetaTitleEn"]</FieldLabel>
                                        <TextEdit @bind-Text="@EditingPageInfo.MetaTitleEn">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>

                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["PageInfoArticleTilteEn"]</FieldLabel>
                                        <TextEdit @bind-Text="@EditingPageInfo.PageInfoArticleTilteEn">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>

                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["PageInfoArticleSubtitleEn"]</FieldLabel>
                                        <TextEdit @bind-Text="@EditingPageInfo.PageInfoArticleSubtitleEn">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>

                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["SummaryEn"]</FieldLabel>
                                         <MemoEdit @bind-Text="@EditingPageInfo.SummaryEn" Rows="3">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </MemoEdit>
                              @*          <TextEdit @bind-Text="@EditingPageInfo.SummaryEn">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>*@
                                    </Field>
                                </Validation>

                                <Field>
                                    <FieldLabel>@L["DescriptionEn"]</FieldLabel>
                                    <CustomRichTextEditor InitValue="@EditingPageInfo.DescriptionEn" ContentChanged="@EditingDescriptionEnOnContentChanged"></CustomRichTextEditor>
                                </Field>

                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["MetaDescriptionEn"]</FieldLabel>
                                        <TextEdit @bind-Text="@EditingPageInfo.MetaDescriptionEn">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>

                                <Field>
                                    <FieldLabel>@L["Image"]</FieldLabel>
                                    <Row>
                                        <Column ColumnSize="ColumnSize.Is11">
                                            <FilePicker Multiple Changed="ImageChanged" Upload="OnImageUpload" ShowMode="FilePickerShowMode.List" />
                                        </Column>
                                        <Column ColumnSize="ColumnSize.Is1">
                                            <Button Color="Color.Primary" Clicked="async()=> await RemoveMedia(true)">@L["Reset"]</Button>
                                        </Column>
                                    </Row>
                                    @if (PageInfoImageNewUpload && !PageInfoImage.IsNullOrEmpty() && !PageInfoImageContent.IsNullOrEmpty())
                                    {
                                        <div style="width:256px;height:256px;background-size: cover; background-image:url(@($"data:{MimeTypes.MimeTypeMap.GetMimeType(PageInfoImage)};base64,{Convert.ToBase64String(PageInfoImageContent)}"))"></div>
                                    }
                                    else
                                    {
                                        if (!PageInfoImage.IsNullOrEmpty())
                                        {
                                            <div style="width:256px;height:256px;background-size: cover; background-image:url(@($"{MimeTypes.MimeTypeMap.GetAttachmentPath()}/pageInfo/{PageInfoImage}"))"></div>
                                        }
                                    }
                                </Field>

                                <Field>
                                    <FieldLabel>@L["HeaderImage"]</FieldLabel>
                                    <Row>
                                        <Column ColumnSize="ColumnSize.Is11">
                                            <FilePicker Multiple Changed="HeaderImageChanged" Upload="OnHeaderImageUpload" ShowMode="FilePickerShowMode.List" />
                                        </Column>
                                        <Column ColumnSize="ColumnSize.Is1">
                                            <Button Color="Color.Primary" Clicked="async()=> await RemoveMedia(false)">@L["Reset"]</Button>
                                        </Column>
                                    </Row>
                                    @if (PageInfoHeaderImageNewUpload && !PageInfoHeaderImage.IsNullOrEmpty() && !PageInfoHeaderImageContent.IsNullOrEmpty())
                                    {
                                        <div style="width:256px;height:256px;background-size: cover; background-image:url(@($"data:{MimeTypes.MimeTypeMap.GetMimeType(PageInfoHeaderImage)};base64,{Convert.ToBase64String(PageInfoHeaderImageContent)}"))"></div>
                                    }
                                    else
                                    {
                                        if (!PageInfoHeaderImage.IsNullOrEmpty())
                                        {
                                            <div style="width:256px;height:256px;background-size: cover; background-image:url(@($"{MimeTypes.MimeTypeMap.GetAttachmentPath()}/pageInfo/{PageInfoHeaderImage}"))"></div>
                                        }
                                    }
                                </Field>
                                @if (HeaderImageValidationError)
                                {
                                    <div class="alert alert-danger">
                                        @L["Message:HeaderImageRequired"]
                                    </div>
                                }

                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["YouTubeUrl"]</FieldLabel>
                                        <TextEdit @bind-Text="@EditingPageInfo.YouTubeUrl">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>

                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["Order"]</FieldLabel>
                                        <NumericPicker TValue="int" @bind-Value="@EditingPageInfo.Order" Decimals="0">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </NumericPicker>
                                    </Field>
                                </Validation>

                                <Field>
                                    <Check TValue="bool" @bind-Checked="@EditingPageInfo.IsActive">@L["IsActive"]</Check>
                                </Field>
                            </TabPanel>

                            <TabPanel Name="edit-tab-arabic">
                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["TitleAr"]</FieldLabel>
                                        <TextEdit @bind-Text="@EditingPageInfo.TitleAr">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>

                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["MetaTitleAr"]</FieldLabel>
                                        <TextEdit @bind-Text="@EditingPageInfo.MetaTitleAr">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>

                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["PageInfoArticleTilteAr"]</FieldLabel>
                                        <TextEdit @bind-Text="@EditingPageInfo.PageInfoArticleTilteAr">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>

                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["PageInfoArticleSubtitleAr"]</FieldLabel>
                                        <TextEdit @bind-Text="@EditingPageInfo.PageInfoArticleSubtitleAr">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>

                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["SummaryAr"]</FieldLabel>
                                        <MemoEdit @bind-Text="@EditingPageInfo.SummaryAr" Rows="3">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </MemoEdit>
                       @*                 <TextEdit @bind-Text="@EditingPageInfo.SummaryAr">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>*@
                                    </Field>
                                </Validation>

                                <Field>
                                    <FieldLabel>@L["DescriptionAr"]</FieldLabel>
                                    <CustomRichTextEditor InitValue="@EditingPageInfo.DescriptionAr" ContentChanged="@EditingDescriptionArOnContentChanged"></CustomRichTextEditor>
                                </Field>

                                <Validation>
                                    <Field>
                                        <FieldLabel>@L["MetaDescriptionAr"]</FieldLabel>
                                        <TextEdit @bind-Text="@EditingPageInfo.MetaDescriptionAr">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>
                            </TabPanel>


                        </Validations>
                    </Content>
                </Tabs>
            </CardBody>
            <CardFooter>
                <SubmitButton Form="EditPageInfoForm" Clicked="Cancel">@L["Cancel"]</SubmitButton>
                <SubmitButton Form="EditPageInfoForm" Clicked="async()=> await UpdatePageInfoAsync()" />
            </CardFooter>

        </Form>
    }

    @* ************************* EDIT MODAL ************************* *@
</Card>
