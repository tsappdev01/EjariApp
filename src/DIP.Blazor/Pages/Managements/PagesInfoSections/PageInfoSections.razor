                <ModalTitle>@L["Update"]</ModalTitle>
                <CloseButton Clicked="CloseEditPageInfoSectionModalAsync" />
            </ModalHeader>
            <ModalBody>
                <Validations @ref="@EditingPageInfoSectionValidations"
                            Mode="ValidationMode.Auto"
