                                </Feedback>
                             </NumericPicker>
                        </Field>
                     </Validation>


                    <Field>
                        <Check TValue="bool" @bind-Checked="@EditingPageInfoSection.IsActive">@L["IsActive"]</Check>
                    </Field>

                    <Field>
                        <FieldLabel>@L["PageInfo"]</FieldLabel>
                        <Select TValue="Guid" @bind-SelectedValue="@EditingPageInfoSection.PageInfoId">
                            @foreach (var pageInfo in PageInfosCollection)
                            {
                                <SelectItem TValue="Guid" Value="@pageInfo.Id">
                                    @pageInfo.DisplayName
                                </SelectItem>
                            }
                        </Select>
                    </Field>


                    
                    
                </Validations>
            </ModalBody>
            <ModalFooter>
                <Button Color="Color.Secondary"
                        Clicked="CloseEditPageInfoSectionModalAsync">
                    @L["Cancel"]
                </Button>
                <SubmitButton Form="CreatePageInfoSectionForm" Clicked="UpdatePageInfoSectionAsync" />
            </ModalFooter>
        </Form>
    </ModalContent>
</Modal>
