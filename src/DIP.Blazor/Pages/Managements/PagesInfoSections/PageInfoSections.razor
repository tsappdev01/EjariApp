                            <FieldLabel>@L["SubTitleAr"]</FieldLabel>
                            <TextEdit @bind-Text="@EditingPageInfoSection.SubTitleAr" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["DescriptionEn"]</FieldLabel>
                            <TextEdit @bind-Text="@EditingPageInfoSection.DescriptionEn" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["DescriptionAr"]</FieldLabel>
                            <TextEdit @bind-Text="@EditingPageInfoSection.DescriptionAr" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation>
                        <Field>
                            <FieldLabel>@L["PageSectionMedia"]</FieldLabel>
                            <TextEdit @bind-Text="@EditingPageInfoSection.PageSectionMedia" >
