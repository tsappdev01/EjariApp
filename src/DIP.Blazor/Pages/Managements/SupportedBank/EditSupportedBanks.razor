

@page "/admin/supported-banks/edit/{id}"
@page "/admin/supported-banks/create"

@attribute [Authorize(DIPPermissions.SupportedBanks.Default)]
@using DIP.SupportedBanks
@using DIP.Localization
@using DIP.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Components.Web
@using Blazorise
@using Blazorise.Components
@using Blazorise.DataGrid
@using Volo.Abp.BlazoriseUI
@using Volo.Abp.BlazoriseUI.Components
@using Volo.Abp.ObjectMapping
@using Volo.Abp.AspNetCore.Components.Messages
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout
@using DIP.Permissions
@using Microsoft.AspNetCore.Components
@using Volo.Abp.AspNetCore.Components.Web
@using Volo.Abp.Http.Client
@inherits DIPComponentBase
@inject ISupportedBanksAppService SupportedBanksAppService
@inject IUiMessageService UiMessageService
@inject IRemoteServiceConfigurationProvider RemoteServiceConfigurationProvider
@inject NavigationManager NavigationManager

@* ************************* PAGE HEADER ************************* *@


<PageHeader Title="@( $"{L[Id.IsNullOrEmpty()? "Create":"Update"]} {L["SupportedBanks"]}")" BreadcrumbItems="BreadcrumbItems" Toolbar="Toolbar">

</PageHeader>

@* ************************* SEARCH ************************* *@

@* ************************* DATA GRID ************************* *@


@* ************************* CREATE MODAL ************************* *@

<Card>

        @if (Id.IsNullOrEmpty())
    {

    <Form id="CreateSupportedBankForm">

        <CardBody>
                <Tabs SelectedTab="@SelectedCreateTab" SelectedTabChanged="@OnSelectedCreateTabChanged">
                    <Items>
                        <Tab Name="create-tab-english">@L["English"]</Tab>
                        <Tab Name="create-tab-arabic">@L["Arabic"]</Tab>
                    </Items>
                    <Content>
           
           
                <Validations @ref="@NewSupportedBankValidations"
                            Mode="ValidationMode.Auto"
                            Model="@NewSupportedBank"
                            ValidateOnLoad="false">
                     
                <TabPanel Name="create-tab-english">
   
                 


                    <Validation>
                        <Field>
                            <FieldLabel>@L["TitleEn"]</FieldLabel>
                            <TextEdit @bind-Text="@NewSupportedBank.TitleEn" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


              

                    <Validation>
                        <Field>
                            <FieldLabel>@L["Order"]</FieldLabel>
                            <NumericPicker TValue="int" @bind-Value="@NewSupportedBank.Order"  Decimals="0">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                             </NumericPicker>
                        </Field>
                     </Validation>
                                <Field>
                                    <Check TValue="bool" @bind-Checked="@NewSupportedBank.IsActive">@L["IsActive"]</Check>
                                </Field>

                    </TabPanel>

                 <TabPanel Name="create-tab-arabic">

                            <Validation>
                                <Field>
                                    <FieldLabel>@L["TitleAr"]</FieldLabel>
                                    <TextEdit @bind-Text="@NewSupportedBank.TitleAr">
                                        <Feedback>
                                            <ValidationError />
                                        </Feedback>
                                    </TextEdit>
                                </Field>
                            </Validation>
                 </TabPanel>
                    
                </Validations>
                    </Content>
                    </Tabs>
                    </CardBody>
        <CardFooter>
            <SubmitButton Form="CreateSubCategoryForm" Clicked="Cancel">@L["Cancel"]</SubmitButton>
            <SubmitButton Form="CreateSubCategoryForm" Clicked="async()=> await CreateSupportedBankAsync()" />
        </CardFooter>
        </Form>
    }
    else

    {
        <Form id="EditSupportedBankForm">
      <CardBody>
                <Tabs SelectedTab="@SelectedEditTab" SelectedTabChanged="@OnSelectedEditTabChanged">
                    <Items>
                        <Tab Name="edit-tab-english">@L["English"]</Tab>
                        <Tab Name="edit-tab-arabic">@L["Arabic"]</Tab>
                    </Items>
                    <Content>
            <Validations @ref="@EditingSupportedBankValidations"
                     Mode="ValidationMode.Auto"
                     Model="@EditingSupportedBank"
                     ValidateOnLoad="false">

                <TabPanel Name="edit-tab-english">

             


                <Validation>
                    <Field>
                        <FieldLabel>@L["TitleEn"]</FieldLabel>
                        <TextEdit @bind-Text="@EditingSupportedBank.TitleEn">
                            <Feedback>
                                <ValidationError />
                            </Feedback>
                        </TextEdit>
                    </Field>
                </Validation>



                <Validation>
                    <Field>
                        <FieldLabel>@L["Order"]</FieldLabel>
                        <NumericPicker TValue="int" @bind-Value="@EditingSupportedBank.Order" Decimals="0">
                            <Feedback>
                                <ValidationError />
                            </Feedback>
                        </NumericPicker>
                    </Field>
                </Validation>

                                <Field>
                                    <Check TValue="bool" @bind-Checked="@EditingSupportedBank.IsActive">@L["IsActive"]</Check>
                                </Field>
                </TabPanel>
                <TabPanel Name="edit-tab-arabic">
                     <Validation>
                                    <Field>
                                        <FieldLabel>@L["TitleAr"]</FieldLabel>
                                        <TextEdit @bind-Text="@EditingSupportedBank.TitleAr">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>
                     </TabPanel>



            </Validations>
            </Content>
            </Tabs>
            </CardBody>
            <CardFooter>
                <SubmitButton Form="EditSubCategoryForm" Clicked="Cancel">@L["Cancel"]</SubmitButton>
                <SubmitButton Form="EditSubCategoryForm" Clicked="async()=> await UpdateSupportedBankAsync()" />
            </CardFooter>
        </Form>
    }

       </Card>
                                       