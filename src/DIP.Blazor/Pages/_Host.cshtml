    <script>
            // Wait until a 'reload' button appears
            new MutationObserver((mutations, observer) => {

                if (document.querySelector('#components-reconnect-modal h5 a')) {
                    // Now every 10 seconds, see if the server appears to be back, and if so, reload
                    async function attemptReload() {
                        await fetch(''); // Check the server really is back
                        location.reload();
                    }
                    observer.disconnect();
                    attemptReload();
                    setInterval(attemptReload, 10000);
                }

            }).observe(document.body, { childList: true, subtree: true });
    </script>

    <script>
            // Wait until a 'reload' button appears
            new MutationObserver((mutations, observer) => {
                if (document.querySelector('#blazor-error-ui')) {

                    const element = document.querySelector('#blazor-error-ui')



                    const dskcellIsDisplayed = window.getComputedStyle(element, null).getPropertyValue("display");


                    if (dskcellIsDisplayed == 'block') {

                        // Now every 10 seconds, see if the server appears to be back, and if so, reload
                        async function attemptReload() {
                            await fetch(''); // Check the server really is back
                            location.reload();
                        }
                        observer.disconnect();
                        attemptReload();
                        setInterval(attemptReload, 10000);
                    }

                }

            }).observe(document.body, { childList: true, subtree: true });
    </script>
    <script>
            downloadFile = function(fileName, contentType, byteArray) {
                const blob = new Blob([byteArray], { type: contentType });
                const link = document.createElement('a');
                link.href = window.URL.createObjectURL(blob);
                link.download = fileName;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                window.URL.revokeObjectURL(link.href);
            };

            // NOC OTP: client-side input + focus (instant on UAT Blazor Server); sync to .NET via JSInvokable
            window.dipNocOtp = window.dipNocOtp || {
                _abort: null,
                _dotnet: null,

                collectInputs: function() {
                    var list = [];
                    for (var i = 0; i < 6; i++) {
                        var el = document.getElementById('otp-input-' + i);
                        if (!el) return null;
                        list.push(el);
                    }
                    return list;
                },

                readDigits: function() {
                    var inputs = this.collectInputs();
                    if (!inputs) return ['', '', '', '', '', ''];
                    return inputs.map(function(el) {
                        var d = String(el.value || '').replace(/\D/g, '').slice(-1);
                        return d.length ? d[0] : '';
                    });
                },

                clearAll: function() {
                    var inputs = this.collectInputs();
                    if (!inputs) return;
                    inputs.forEach(function(el) { el.value = ''; });
                },

                unwire: function() {
                    if (this._abort) {
                        this._abort.abort();
                        this._abort = null;
                    }
                    this._dotnet = null;
                },

                wire: function(dotnetHelper) {
                    var self = this;
                    self.unwire();
                    var inputs = self.collectInputs();
                    if (!inputs || inputs.length !== 6) return false;

                    self._dotnet = dotnetHelper;
                    self._abort = new AbortController();
                    var sig = self._abort.signal;

                    function sync() {
                        if (!self._dotnet) return;
                        var arr = self.readDigits();
                        self._dotnet.invokeMethodAsync('SyncOtpFromClient', arr);
                    }

                    function applyDigitsFrom(rawDigits) {
                        var d = String(rawDigits || '').replace(/\D/g, '').slice(0, 6);
                        for (var i = 0; i < 6; i++) {
                            inputs[i].value = i < d.length ? d[i] : '';
                        }
                        var focusIx = d.length >= 6 ? 5 : Math.min(Math.max(d.length, 0), 5);
                        inputs[focusIx].focus();
                        sync();
                    }

                    inputs.forEach(function(el, idx) {
                        el.addEventListener('input', function() {
                            var raw = String(el.value || '').replace(/\D/g, '');
                            if (raw.length > 1) {
                                applyDigitsFrom(raw);
                                return;
                            }
                            el.value = raw;
                            if (raw.length === 1 && idx < 5) {
                                inputs[idx + 1].focus();
                            }
                            sync();
                        }, { signal: sig });

                        el.addEventListener('keydown', function(e) {
                            if (e.key !== 'Backspace') return;
                            if (el.value && el.value.length > 0) return;
                            e.preventDefault();
                            if (idx > 0) {
                                inputs[idx - 1].focus();
                                inputs[idx - 1].value = '';
                                sync();
                            }
                        }, { signal: sig });

                        el.addEventListener('paste', function(e) {
                            e.preventDefault();
                            var text = (e.clipboardData || window.clipboardData).getData('text') || '';
                            applyDigitsFrom(text);
                        }, { signal: sig });
                    });

                    sync();
                    return true;
                }
            };
    </script>
