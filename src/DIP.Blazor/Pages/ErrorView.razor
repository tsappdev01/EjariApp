@using System.Globalization;
@using DIP.Blazor.Components.Layout;
@using DIP.Blazor.Shared;
@using Volo.Abp.Http;
@using Microsoft.Extensions.Localization;
@using global::Localization.Resources.AbpUi;
@layout CustomLayout;

@inject IStringLocalizer<AbpUiResource> L;
<HeaderLayout>

</HeaderLayout>
<main>
    <div class="page_header_default style_one ">
        <div class="parallax_cover">
            <img src="assets/images/page-header-default.jpg" alt="DIP" class="cover-parallax">
        </div>
        <div class="hero-background-overlay"></div>
        <div class="page_header_content">
            <div class="auto-container">
                <div class="row">
                    <div class="col-md-12">
                        <div class="banner_title_inner">
                            <h1 class="title_page">
                              
                            </h1>
                        </div>
                    </div>
                    <div class="col-lg-12">
                        <div class="breadcrumbs">
                            <ul class="breadcrumb m-auto">
                                <li><a ></a> </li>
                                <li><a></a> </li>
                                <li ></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="container">
        <div class="row">
            <div class="col-lg-10 col-md-11 mx-auto">
                <div class="d-flex flex-column justify-content-center min-vh-100 align-items-center">
                    <div class="card">
                        <div class="card-body p-lg-5">
                            <div class="row">
                                <div class="col-auto d-flex align-items-center">
                                    <i class="bi bi-emoji-frown mb-3 mb-md-0 mx-3 mx-md-4" style="font-size: 12em; color:#6f6259;"></i>
                                </div>
                                <div class="col ps-2 ps-lg-4">
                                    <div class="status-content">
                                        <h2 class="fw-bolder display-1 text-brand">@HttpStatusCode</h2>
                                        <h2 class="mb-0">@Title</h2>
                                        <h5 class="text-muted">@Message</h5>
                                        @* NO SUCH A FIELD FOR THESE *@
                                        @* <p class="mt-3 mb-4">@Details</p> *@

                                        <a type="button" href="@UtilClass.GetHomeUrlByLang()" class="btn theme-btn one w-100">@L["GoHomePage"]</a>

                                        
                     
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
<footer>
    <FooterLayout></FooterLayout>
</footer>
@code {
    [Parameter]
    public int HttpStatusCode { get; set; }

    [Parameter]
    public string Title { get; set; }

    [Parameter]
    public string Message { get; set; }
}
