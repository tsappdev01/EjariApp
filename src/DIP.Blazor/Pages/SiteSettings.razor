@* ************************* PAGE HEADER ************************* *@
<PageHeader Title="@L["SiteSettings"]" BreadcrumbItems="BreadcrumbItems" Toolbar="Toolbar">

</PageHeader>

@* ************************* SEARCH ************************* *@
<Card>
    <CardBody>
        <Form id="SiteSettingSearchForm" class="mb-3">
            <Addons>
                <Addon AddonType="AddonType.Body">
                    <TextEdit @bind-Text="@Filter.FilterText"
                              Autofocus="true"
                              Placeholder="@L["Search"]">
                    </TextEdit>
                </Addon>
                <Addon AddonType="AddonType.End">
                    <SubmitButton Form="SiteSettingSearchForm" Clicked="GetSiteSettingsAsync">
                        <Icon Name="IconName.Search" Class="me-1"></Icon>@L["Search"]
                    </SubmitButton>
                </Addon>
            </Addons>
        </Form>
    </CardBody>
</Card>

@* ************************* DATA GRID ************************* *@
<Card>
    <CardBody>
        <DataGrid TItem="SiteSettingDto"
                  Data="SiteSettingList"
                  ReadData="OnDataGridReadAsync"
                  TotalItems="TotalCount"
                  ShowPager="true"
                  Responsive="true"
                  PageSize="PageSize">
            <DataGridColumns>
                <DataGridEntityActionsColumn TItem="SiteSettingDto" @ref="@EntityActionsColumn">
                    <DisplayTemplate>
                        <EntityActions TItem="SiteSettingDto" EntityActionsColumn="@EntityActionsColumn">
                            <EntityAction TItem="SiteSettingDto"
                                          Visible="@CanEditSiteSetting"
                                          Clicked="async () => await OpenEditSiteSettingModalAsync(context)"
                                          Text="@L["Edit"]"></EntityAction>
                            <EntityAction TItem="SiteSettingDto"
                                          Visible="@CanDeleteSiteSetting"
                                          Clicked="() => DeleteSiteSettingAsync(context)"
                                          ConfirmationMessage="@(()=> L["DeleteConfirmationMessage"])"
                                          Text="@L["Delete"]"></EntityAction>
                        </EntityActions>
                    </DisplayTemplate>
                </DataGridEntityActionsColumn>
               
              <DataGridColumn TItem="SiteSettingDto"
                      Field="FaceBookLink"
                      Caption="@L["FaceBookLink"]">
              </DataGridColumn>

              <DataGridColumn TItem="SiteSettingDto"
                      Field="TwitterLink"
                      Caption="@L["TwitterLink"]">
              </DataGridColumn>

              <DataGridColumn TItem="SiteSettingDto"
                      Field="InstagramLink"
                      Caption="@L["InstagramLink"]">
              </DataGridColumn>

              <DataGridColumn TItem="SiteSettingDto"
                      Field="YouTubeLink"
                      Caption="@L["YouTubeLink"]">
              </DataGridColumn>

              <DataGridColumn TItem="SiteSettingDto"
                      Field="LinkedinLink"
                      Caption="@L["LinkedinLink"]">
              </DataGridColumn>

              <DataGridColumn TItem="SiteSettingDto"
                      Field="FireDepartmentPhone"
                      Caption="@L["FireDepartmentPhone"]">
              </DataGridColumn>

              <DataGridColumn TItem="SiteSettingDto"
                      Field="Emergency1Phone"
                      Caption="@L["Emergency1Phone"]">
              </DataGridColumn>

              <DataGridColumn TItem="SiteSettingDto"
                      Field="Emergency2Phone"
                      Caption="@L["Emergency2Phone"]">
              </DataGridColumn>

              <DataGridColumn TItem="SiteSettingDto"
                      Field="PolicePost"
                      Caption="@L["PolicePost"]">
              </DataGridColumn>

              <DataGridColumn TItem="SiteSettingDto"
                      Field="DipEmail"
                      Caption="@L["DipEmail"]">
              </DataGridColumn>

              <DataGridColumn TItem="SiteSettingDto"
                      Field="Phone"
                      Caption="@L["Phone"]">
              </DataGridColumn>

              <DataGridColumn TItem="SiteSettingDto"
                      Field="POBox"
                      Caption="@L["POBox"]">
              </DataGridColumn>

              <DataGridColumn TItem="SiteSettingDto"
                      Field="OfficeLocationEn"
                      Caption="@L["OfficeLocationEn"]">
              </DataGridColumn>

              <DataGridColumn TItem="SiteSettingDto"
                      Field="OfficeLocationAr"
                      Caption="@L["OfficeLocationAr"]">
              </DataGridColumn>

              <DataGridColumn TItem="SiteSettingDto"
                      Field="SiteLink"
                      Caption="@L["SiteLink"]">
              </DataGridColumn>

              <DataGridColumn TItem="SiteSettingDto"
                      Field="PbLocation"
