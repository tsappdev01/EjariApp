@using DIP.Blazor.Components.Layout;
@using System.Globalization;
@using DIP.Blazor.Shared;
@using DIP.ContactForms;
@using DIP.FeedBacks;
@using DIP.InquiryForms;
@using Volo.Abp.AspNetCore.Components.Messages;
@inherits DIPComponentBase
@layout CustomLayout;

@inject IContactFormsAppService ContactFormsAppService
@inject IInquiryFormsAppService InquiryFormsAppService
@inject IFeedBacksAppService FeedBacksAppService
@inject IUiMessageService UiMessageService

@page "/{lang}/contact-us-ali";

<PageTitle>
    @PageInfoFrontEnd?.MetaTitle
</PageTitle>
<HeadContent>
    <meta name="description" content="@PageInfoFrontEnd?.MetaDescription">
    <link rel="canonical" href="@NavigationManager.Uri" />
    @if (Lang.Contains("en"))
    {
        <link rel="alternate" href="@NavigationManager.Uri" hreflang="en" />
        <link rel="alternate" href="@UtilClass.UpdateUriByLang(NavigationManager.Uri)" hreflang="ar" />
    }
    else
    {
        <link rel="alternate" href="@NavigationManager.Uri" hreflang="ar" />
        <link rel="alternate" href="@UtilClass.UpdateUriByLang(NavigationManager.Uri)" hreflang="en" />
    }
</HeadContent>
<!----page header----->
<div class="page_header_default style_one ">
    <div class="parallax_cover">
        <img src="@PageInfoFrontEnd?.HeaderImage" alt="@PageInfoFrontEnd?.Title" class="cover-parallax">
    </div>
    <div class="hero-background-overlay"></div>
    <div class="page_header_content">
        <div class="auto-container">
            <div class="row">
                <div class="col-md-12">
                    <div class="banner_title_inner">
                        <h1 class="title_page">
                            @PageInfoFrontEnd?.Title
                        </h1>
                    </div>
                </div>
                <div class="col-lg-12">
                    <div class="breadcrumbs">
                        <ul class="breadcrumb m-auto">
                            <li><a href="@UtilClass.GetHomeUrlByLang()">@L["Site:Home"]</a> </li>
                            <li class="active">@PageInfoFrontEnd?.Title</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!----page header----->
<!--===============PAGE CONTENT==============-->
<!--===============PAGE CONTENT==============-->
<div id="content" class="site-content ">

    <!---image-box-section---->
    <section class="image-box-section bg_light_1">
        <!--===============spacing==============-->
        <div class="pd_top_80"></div>
        <!--===============spacing==============-->
        <div class="auto-container">
            <div class="row">

                <div class="col-xl-4 col-lg-4">
                    <div class="theme_btn_all color_one mt-4 mt-md-0">
                        <Button Form="CreateContactForm" class="theme-btn one w-100"  Clicked="async()=> await OpenCreateCategoryModalAsync()">@L["Site:Submit"]</Button>

                        @*<button type="button" class="theme-btn one w-100 contact-toggler">@L["Site:ContactUs"]</button>*@
                    </div>
                </div>

                <div class="col-xl-4 col-lg-4">
                    <div class="theme_btn_all color_one mt-4 mt-md-0">
                        <button type="button" class="theme-btn one w-100 inquiry-toggler">@L["Site:SendInquiry"]</button>
                    </div>
                </div>

                <div class="col-xl-4 col-lg-4">
                    <div class="theme_btn_all color_one mt-4 mt-md-0">
                        <button type="button" class="theme-btn one w-100 feedback-toggler">@L["Site:Feedback"]</button>
                    </div>
                </div>


            </div>
        </div>
        <!--===============spacing==============-->
        <div class="pd_bottom_80"></div>
        <!--===============spacing==============-->
    </section>
    <!---image-box-section-end---->
    <!---image-box-section---->
    <section class="image-box-section">
        <!--===============spacing==============-->
        <div class="pd_top_80"></div>
        <!--===============spacing==============-->
        <div class="auto-container">
            <div class="row">

                <div class="col-xl-8 col-lg-8">
                    <iframe src="@SiteSettingFrontEnd?.PbLocation" width="100%" height="600" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>


                </div>
                <div class="col-xl-4 col-lg-4">

                    <div class="contact-card h-auto">
                        <h5 class="contact-card-title bg-blue-brand title-white">@L["Site:TheOffice"]</h5>
                        <div class="contact-card-body">
                            <ul class="list-unstyled contact-info-list">
                                @if (SiteSettingFrontEnd != null)
                                {
                                    <li><i class="fas fa-map-marker-alt"></i>@SiteSettingFrontEnd.OfficeLocation</li>
                                    <li><i class="fa fa-inbox"></i> @SiteSettingFrontEnd.POBox</li>
                                    <li><i class="fa fa-envelope"></i>@SiteSettingFrontEnd.DipEmail</li>
                                    <li><i class="fa fa-phone"></i>@SiteSettingFrontEnd.Phone</li>
                                    <li><i class="fa fa-globe"></i>@SiteSettingFrontEnd.SiteLink</li>
                                }
                            </ul>
                        </div>
                    </div>

                    <div class="contact-card h-auto">
                        <h5 class="contact-card-title bg-blue-brand title-white">@L["Site:BusinessHours"]</h5>
                        <div class="contact-card-body">
                            <ul class="list-unstyled contact-info-list">
                                @if (SiteSettingFrontEnd != null)
                                {
                                    <li class="justify-content-between"><b>@SiteSettingFrontEnd.WorkDays</b> @SiteSettingFrontEnd.WorkHours</li>
                                    <li class="justify-content-between"><b>@SiteSettingFrontEnd.RamadanWorkDays </b> @SiteSettingFrontEnd.RamadanWorkHours</li>
                                    <li class="justify-content-between"><b>@L["Site:Friday"]</b> @SiteSettingFrontEnd.FridayWorkHours</li>
                                    <li class="justify-content-between"><b>@SiteSettingFrontEnd.ClosedDay1 </b> @L["Site:Closed"]</li>
                                    <li class="justify-content-between"><b>@SiteSettingFrontEnd.ClosedDay2 </b> @L["Site:Closed"]</li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>


            </div>
            @if (!DipBranchesList.IsNullOrEmpty())
            {
                <div class="row contact-cards">
                    @foreach (var dipBranch in DipBranchesList)
                    {
                        <div class="col-md-4">
                            <div class="contact-card">
                                <h5 class="contact-card-title">@dipBranch.Title</h5>
                                <div class="contact-card-body">
                                    <p><b>@dipBranch.SubTitle</b></p>
                                    <ul class="list-unstyled contact-info-list">
                                        @if (!dipBranch.Phone.IsNullOrEmpty())
                                        {
                                            <li><a class="d-flex align-items-center"><i class="fa fa-phone"></i>@dipBranch.Phone</a></li>
                                        }
                                        @if (!dipBranch.AlternativePhone.IsNullOrEmpty())
                                        {
                                            <li><a class="d-flex align-items-center"><i class="fa fa-phone"></i> @dipBranch.AlternativePhone</a></li>
                                        }
                                        @if (!dipBranch.Email.IsNullOrEmpty())
                                        {
                                            <li><a class="d-flex align-items-center"><i class="fa fa-envelope"></i> @dipBranch.Email</a></li>
                                        }
                                        @if (!dipBranch.AlternativeEmail.IsNullOrEmpty())
                                        {
                                            <li><a class="d-flex align-items-center"><i class="fa fa-envelope"></i> @dipBranch.AlternativeEmail</a></li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

        </div>
        <!--===============spacing==============-->
        <div class="pd_bottom_80"></div>
        <!--===============spacing==============-->
    </section>
    <!---image-box-section-end---->
</div>
<!--===============PAGE CONTENT END==============-->
<!--===============PAGE CONTENT END==============-->
<Modal @ref="CreateCategoryModal" Closing="@CreateCategoryModal.CancelClosingModalWhenFocusLost">
   
        <div class="modal_popup modal_popup_contact contact-modal-popup-visible one">
    <div class="modal-popup-inner">
                <div class="close-modal-forms" >
                    <a onclick="@(() => CloseCreateCategoryModalAsync())" >
                    </a>
                </div>
        <div class="modal_box">
            <div class="row">
                <div class="col-lg-12 col-md-12 form_inner">
                    <div class="form_content">

                        <form class="contact-form" method="post" action="https://themepanthers.com/html/creote-html/sendemail.php">
                            <Validations @ref="@NewContactFormValidations"
                                         Mode="ValidationMode.Auto"
                                         Model="@NewContactForm"
                                         ValidateOnLoad="false">
                                <p>
                                    <label>
                                        @L["Site:YourName"]
                                        <br />
                                        <Validation>
                                            <TextEdit @bind-Text="@NewContactForm.FullName" Placeholder="@L["Site:EnterYourName"]">
                                                <Feedback>
                                                    <ValidationError />
                                                </Feedback>
                                            </TextEdit>
                                        </Validation>
                                        <br />
                                        <i class="fa fa-user"></i><br />
                                    </label>
                                </p>
                                <p>
                                    <label>
                                        @L["Site:YourEmail"]<br />
                                        <Validation>
                                            <TextEdit @bind-Text="@NewContactForm.Email" Role="TextRole.Email" Placeholder="@L["Site:EnterYourEmail"]">
                                                <Feedback>
                                                    <ValidationError />
                                                </Feedback>
                                            </TextEdit>
                                        </Validation>
                                        <br />
                                        <i class="fa fa-envelope"></i><br />
                                    </label>
                                </p>
                                <p>
                                    <label>
                                        @L["Site:Subject"]
                                        <br />
                                        <Validation>
                                            <TextEdit @bind-Text="@NewContactForm.Subject" Placeholder="@L["Site:EnterYourSubject"]">
                                            </TextEdit>
                                        </Validation>
                                        <br />
                                        <i class="fa fa-edit"></i><br />
                                    </label>
                                </p>
                                <p>
                                    <label>
                                        @($"{L["Site:YourMessage"]} ({L["Site:Optional"]})")<br />
                                        <Validation>
                                            <MemoEdit Class="wpcf7-form-control wpcf7-textarea" @bind-Text="@NewContactForm.Message" Placeholder="@L["Site:EnterYourMessage"]">
                                            </MemoEdit>
                                        </Validation>

                                        <br />
                                        <i class="fa fa-comment"></i><br />
                                    </label>
                                </p>
                            </Validations>
                            <div class="theme_btn_all color_one mt-4 mt-md-0">
                                <Button Form="CreateContactForm" class="theme-btn one w-100" Disabled="@DisableButton" Clicked="async()=> await CreateContactFormAsync()">@L["Site:Submit"]</Button>
                            </div>
                            <div class="col-xl-12 py-0 px-05 d-flex justify-content-end">
                                <div class="cont-btn mb-0 w-100">
                                </div>
                            </div>
                            @if (DisplayValidation)
                            {
                                <div class="col-xl-12 py-0 px-05 d-flex justify-content-end">
                                    <div style="width: 100%" class="alert alert-danger fade-in" role="alert">
                                        @L["Site:ValidationError"]
                                    </div>
                                </div>
                            }
                            @if (DisplayAlert)
                            {
                                <div class="col-xl-12 py-0 px-05 d-flex justify-content-end">
                                    <div style="width: 100%" class="alert alert-success fade-in" role="alert">
                                        @L["Site:AddedSuccessfuly"]
                                    </div>
                                </div>
                            }
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</Modal>
