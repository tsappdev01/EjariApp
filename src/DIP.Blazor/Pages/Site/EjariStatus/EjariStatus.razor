    <StepProgress Steps="@registrationSteps"
                      CurrentStep="@currentStep"
                      OnStepChanged="HandleStepChanged"
                      AllowClickNavigation="true" />
    <!---newsteller end--->

    <section class="blog_post_section two_column style_three">
        <!--===============spacing==============-->
        <div class="pd_top_80"></div>
        <!--===============spacing==============-->

        <div class="auto-container p-lg-0">

            <div class="row align-items-center">
                <div class="col-lg-12">
                    <div class="title_all_box style_seven dark_color">
                        <div class="title_sections">
                            <div class="title fw-normal text-primary-color">@L["PaymentStatus"]</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-12">
                    <!--===============spacing==============-->
                    <div class="pd_bottom_30"></div>
                    <!--===============spacing==============-->
                </div>

                <div class="col-lg-12 py-3 px-0 payment-steps">
                    <section class="creote-contact-box">
                        <div class="row">
                            <div class="col mb-xl-0">
                                <div class="contact_box_content style_two ">
                                    <div class="contact_box_inner color_one head-info">
                                        <div class="text ">
                                            <h3>@L["ReferenceNumber"]</h3>
                                        </div>
                                    </div>

                                    <div class="contact_box_inner color_one info-text">
                                        <div class="text">
                                            <p>@ReferenceNumber</p>
                                        </div>
                                    </div>

                                </div>
                            </div>
                            <div class="col mb-xl-0">
                                <div class="contact_box_content style_two ">
                                    <div class="contact_box_inner color_one head-info">
                                        <div class="text ">
                                            <h3>@L["Status"]</h3>
                                        </div>
                                    </div>

                                    <div class="contact_box_inner color_one info-text">
                                        <div class="text">
                                            <p>@Status?.Description</p>
                                        </div>
                                    </div>

                                </div>
                            </div>
                     
                        
                       
                        </div>
                
                    </section>
                </div>

                <div class="col-md-12">
                    <!--===============spacing==============-->
                    <div class="pd_top_80"></div>
                    <!--===============spacing==============-->
                </div>
            </div>


        </div>


        <div class="col-md-12">
            <!--===============spacing==============-->
            <div class="pd_bottom_30"></div>
            <!--===============spacing==============-->
        </div>
        @if (getPaymentHistory != null && getPaymentHistory.Count() > 0)
        {
            <div class="auto-container p-0">
                <div class="row p-0">
                    <div class="col-lg-12">
                        <div class="title_all_box style_seven dark_color">
                            <div class="title_sections">
                                <div class="title fw-normal text-primary-color">@L["PaymentHistory"]</div>
                            </div>
                        </div>
                    </div>

                    <!--===============spacing==============-->
                    <div class="pd_bottom_30"></div>
                    <!--===============spacing==============-->

                    <div class="col-lg-12 p-0">
                        <div class="fact-box acctablebox">
                            <table class="rwd-table acctable w-100">
                                <tbody>
                                    <tr>
                                        <th>@L["BillRefNo"]</th>
                                        <th>@L["TransacationRefNo"]</th>
                                        <th>@L["TransacationDate"]</th>
                                        <th>@L["Amount"]</th>
                                        <th>@L["Status"]</th>
                                    </tr>
                               
                                    @foreach (var ph in getPaymentHistory)
                                    {
                                        <tr>
                                            <td data-th="@L["BillRefNo"]" class="fw-bold">@ph.BillRef</td>
                                            <td data-th="@L["TransacationRefNo"]">@ph.TranRefNo</td>
                                            <td data-th="@L["TransacationDate"]e">@ph.TranDate</td>
                                            <td data-th="@L["Amount"]">@ph.TranAmount.ToString("0.00")</td>
                                            <td data-th="@L["Status"]" class="wrapok">@ph.PayStatus</td>
                                        </tr>
                                    }

                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
            </div>
        }

        <div class="col-md-12">
            <!--===============spacing==============-->
            <div class="pd_top_30"></div>
            <!--===============spacing==============-->
        </div>

        @if (fbmodel != null && fbmodel.IsPopup)
        {
            <div class="auto-container col-lg-12 p-lg-0">
                <section class="contact_form_box_all type_one">
                <div class="row contact_form_box_inner justify-content-center py-5">
 
                    <div class="col-8 d-flex align-items-center">
                        <p class="fs-5">
                            @L["YourHonestFeedbackHelpsUs"]
                        </p>
                    </div> 

                    <div class="col-4">
                        <div class="theme_btn_all color_one">
                            <button target="_blank" rel="nofollow"
                                    class="theme-btn one  w-100 feedbacknew-toggler">
                                @L["FeedBack"]
                            </button>
                        </div>
                    </div>

                </div>
            </section>
        </div>
        }
        <div class="col-md-12">
            <!--===============spacing==============-->
            <div class="pd_bottom_30"></div>
            <!--===============spacing==============-->
        </div>
    </section>


</div>         <!--===============PAGE CONTENT END==============-->
@if (fbmodel != null && fbmodel.IsPopup)
{
    <div class="modal_popup modal_popup_feedbacknew one">
        <div class="modal-popup-inner">
            <div class="close-modal"><i class="fa fa-times"></i></div>
            <div class="modal_box">
                <div class="row p-1">
                    <h3 class="bg-blue-brand text-white py-3 px-3 fw-normal rounded_radius-5">@L["OnlineServicesFeedbackForm"]</h3>
                    <div class="col-lg-12 col-md-12 form_inner">
                        <div class="form_content">
                            <p class="fw-bold">@L["Hello"] @Info?.CompanyName</p>
                            <p class="fs-5">@L["PleaseHelpUsToServeYouBetterByTakingACoupleOfMinutes"]</p>

                            <p class="fs-5 fw-normal mt-4">
                                @L["HowSatisfiedWereYouWithOurOnlineServices"]
                            </p>
                            @if (Answers != null)
                            {
                                <div class="row emoji py-4">
                                    @foreach (var answer in Answers)
                                    {
                                        <div class="col-sm-4 text-center" @onclick="async ()=>await ClickAnswer(answer)">
                                            <a class="@(answer.IsClick ? "active" : "")">
                                                <i class="@(answer.Css)" aria-hidden="true"></i>
                                                @answer.Name
                                            </a>
                                        </div>
                                    }

                                </div>
                            }


                            <p class="fs-5">@L["WeWouldLikeToHearYourThoughts"]</p>

                            <p class="fs-5">
                                @L["IfYouHaveSpecificFeedbackPleaseWriteToUs"]
                            </p>

                            <p>
                                <textarea name="message" cols="40" rows="10" class="wpcf7-form-control wpcf7-textarea" @bind="AdditionalComments"
                                          aria-invalid="false" placeholder="@L["AdditionalComments"]"></textarea>


                            </p>

                            <div class="theme_btn_all color_one mt-4 mt-md-0">
                                <button type="submit" class="theme-btn feed w-100 " @onclick="async() => await onSubmit()">@L["Submit"]</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
    