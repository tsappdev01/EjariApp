@using DIP.Blazor.Components.Layout;
@using System.Globalization;
@using DIP.Blazor.Shared;
@inherits DIPComponentBase
@layout CustomLayout;

@page "/{lang}/zones";

<PageTitle>
    @PageInfoFrontEnd?.MetaTitle
</PageTitle>
<HeadContent>
    <meta name="description" content="@PageInfoFrontEnd?.MetaDescription">
    <link rel="canonical" href="@NavigationManager.Uri" />
    @if (Lang.Contains("en"))
    {
        <link rel="alternate" href="@NavigationManager.Uri" hreflang="en" />
        <link rel="alternate" href="@UtilClass.UpdateUriByLang(NavigationManager.Uri)" hreflang="ar" />
    }
    else
    {
        <link rel="alternate" href="@NavigationManager.Uri" hreflang="ar" />
        <link rel="alternate" href="@UtilClass.UpdateUriByLang(NavigationManager.Uri)" hreflang="en" />
    }
</HeadContent>
<!----page header----->
<div class="page_header_default style_one ">
    <div class="parallax_cover">
        <img src="@PageInfoFrontEnd?.HeaderImage" alt="@PageInfoFrontEnd?.Title" class="cover-parallax">
    </div>
    <div class="hero-background-overlay"></div>
    <div class="page_header_content">
        <div class="auto-container">
            <div class="row">
                <div class="col-md-12">
                    <div class="banner_title_inner">
                        <h1 class="title_page">
                            @PageInfoFrontEnd?.Title
                        </h1>
                    </div>
                </div>
                <div class="col-lg-12">
                    <div class="breadcrumbs">
                        <ul class="breadcrumb m-auto">
                            <li><a href="@UtilClass.GetHomeUrlByLang()">@L["Site:Home"]</a> </li>
                            <li class="active">@PageInfoFrontEnd?.Title</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!----page header----->
<!--===============PAGE CONTENT==============-->
<!--===============PAGE CONTENT==============-->
<div id="content" class="site-content ">
    <!---image-box-section---->
    <section class="image-box-section py-lg-5">
        <!--===============spacing==============-->
        <div class="pd_top_80"></div>
        <!--===============spacing==============-->
        <div class="auto-container">
            <div class="row align-items-center mob-order">
                <div class="col-xl-6 col-lg-12">
                    <div class="title_all_box style_one dark_color">
                        <div class="title_sections ">
                            <div class="title text-uppercase text-primary-color mb-4">@PageInfoFrontEnd?.PageInfoArticleTilte<br>@PageInfoFrontEnd?.PageInfoArticleSubtitle</div>
                        </div>
                        <p class="fs-4 lh-base">
                            @PageInfoFrontEnd?.Summary
                        </p>
                    </div>
                </div>
                <div class="col-md-1"></div>
                <div class="col-xl-5 col-lg-12 mb-5 mb-lg-5 mb-xl-0">
                    <div class="image_boxes style_three">
                        <img src="@PageInfoFrontEnd?.Image" class="img-fluid" alt="@PageInfoFrontEnd?.PageInfoArticleTilte">
                        <div class="video_box">
                            <a href="@PageInfoFrontEnd?.YouTubeUrl" class="lightbox-image">
                                <i class="fa fa-play"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!--===============spacing==============-->
        <div class="pd_bottom_80"></div>
        <!--===============spacing==============-->
    </section>
    <!---image-box-section-end---->
    @if (!PageInfoFrontEnd.PageInfoSections.IsNullOrEmpty())
    {
        foreach (var item in PageInfoFrontEnd.PageInfoSections)
        {
            <!---image-box-section---->
            <section class="image-box-section py-lg-5">
                <!--===============spacing==============-->
                <div class="pd_top_80"></div>
                <!--===============spacing==============-->
                <div class="auto-container">
                    <div class="row align-items-center mob-order">
                        <div class="col-xl-6 col-lg-12">
                            <div class="title_all_box style_one dark_color">
                                <div class="title_sections ">
                                    <div class="title text-uppercase text-primary-color mb-4">@item.Title<br>@item.SubTitle</div>
                                </div>
                                <p class="fs-4 lh-base">
                                    @item.Summary
                                </p>
                            </div>
                        </div>
                        <div class="col-md-1"></div>
                        <div class="col-xl-5 col-lg-12 mb-5 mb-lg-5 mb-xl-0">
                            <div class="image_boxes style_three">
                                <img src="@item.PageSectionMedia" class="img-fluid"
                             alt="image">
                                <div class="video_box">
                                    <a href="@item.YoutubeUrl" class="lightbox-image">
                                        <i class="fa fa-play"></i>
                                    </a>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
                <!--===============spacing==============-->
                <div class="pd_bottom_80"></div>
                <!--===============spacing==============-->
            </section>
            <!---image-box-section-end---->
        }
    }
    @if (!ZonesList.IsNullOrEmpty())
    {
        <!---project--->
        <section class="zones-area bg_light_1 py-lg-0" id="projects">
            <!--===============spacing==============-->
            <!-- <div class="pd_top_80"></div> -->
            <!--===============spacing==============-->
            <div class="container-fluid p-lg-5">

                <div class="row">
                    @foreach (var zone in ZonesList)
                    {
                        <div class="col-md-6 col-lg">
                            <a href="@($"/{CultureInfo.CurrentCulture.Name}/zones/{zone.Slug}")">
                                <div class="card zone-card-inner">
                                    <img src="@zone.Image" alt="@zone?.Title" />
                                    <div class="text">
                                        @* <h2 class="zonetitleone">@zone.Title</h2> *@
                                        <h2>@zone.Title</h2>
                                        <p>@zone.Summary</p>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                </div>

            </div>
            <!--===============spacing==============-->
            <!-- <div class="pd_bottom_90"></div> -->
            <!--===============spacing==============-->
        </section>
        <!---project-end--->
    }

</div>
<!--===============PAGE CONTENT END==============-->
<!--===============PAGE CONTENT END==============-->