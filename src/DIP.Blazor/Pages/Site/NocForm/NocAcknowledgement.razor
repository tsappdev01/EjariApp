<Modal @ref="modalRef"
       Closing="OnModalClosing"
       CloseOnEscapeKey="false"
       CloseOnOutsideClick="false">
    <ModalContent Centered>
        <ModalHeader>
            @if (contactSelction)
            {
                <ModalTitle Class="text-center otp-modal-title w-100">Confirm with OTP</ModalTitle>
            }
            else
            {
                <ModalTitle Class="text-center">@(NocApplicationProceed ? "Application Processing" : "Verify OTP")</ModalTitle>
            }
            <button type="button" class="btn-close" @onclick="OnModalCloseManual" aria-label="Close"></button>
        </ModalHeader>
        <ModalBody>
            @if (contactSelction)
            {
                <Div>
                    <div class="otp-modal-alert mb-4" role="status">
                        We'll send the OTP to the email address or mobile number listed in your uploaded tenancy contract
                    </div>
                    <p class="otp-prompt">Please select your preferred option to receive the OTP</p>
                    <div class="otp-role-toggle" role="tablist">
                        <button type="button"
                                class="otp-role-btn @(selectedTab == "Tenant" ? "active" : "")"
                                role="tab"
                                aria-selected="@(selectedTab == "Tenant")"
                                @onclick="@(() => OnSelectedTabChanged("Tenant"))">
                            Tenant
                        </button>
                        @* <button type="button"
                                class="otp-role-btn @(selectedTab == "Landlord" ? "active" : "")"
                                role="tab"
                                aria-selected="@(selectedTab == "Landlord")"
                                @onclick="@(() => OnSelectedTabChanged("Landlord"))">
                            LandLord
                        </button> *@
                    </div>
                    @if (selectedTab == "Tenant")
                    {
                        <p class="otp-party-name">Tenant Name: @(_clsEOGETTenant?.TenantName)</p>
                        <div class="form-section mb-3 custom-form-section">
                            <RadioGroup TValue="string"
                                        Name="OtpContactTenant"
                                        @bind-CheckedValue="@_otpsendDetails">
                                <div class="otp-option-list">
                                    @if (_clsEOGETTenant != null)
                                    {
                                        @foreach (var mobilenumber in (_clsEOGETTenant.TenantMobile ?? string.Empty).Split(","))
                                        {
                                            @if (!string.IsNullOrEmpty(mobilenumber))
                                            {
                                                <div class="otp-option-row">
                                                    <div class="form-check">
                                                        <Radio Value="@(mobilenumber + "%%Mobile")">@(MaskingMethods.MaskUaeNumber(mobilenumber)) (SMS)</Radio>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    }
                                    @if (_clsEOGETTenant != null)
                                    {
                                        @foreach (var emailId in (_clsEOGETTenant.TenantEmail ?? string.Empty).Split(","))
                                        {
                                            @if (!string.IsNullOrEmpty(emailId))
                                            {
                                                <div class="otp-option-row">
                                                    <div class="form-check">
                                                        <Radio Value="@(emailId + "%%Email")">@(MaskingMethods.MaskEmail(emailId)) (Email)</Radio>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    }
                                </div>
                            </RadioGroup>
                        </div>
                    }
                    @* else
                    {
                        <p class="otp-party-name">Landlord Name: @(_clsEOGETTenant?.LandLordName)</p>
                        <div class="form-section mb-3 custom-form-section">
                            <RadioGroup TValue="string"
                                        Name="OtpContactLandlord"
                                        @bind-CheckedValue="@_otpsendDetails">
                                <div class="otp-option-list">
                                    @if (_clsEOGETTenant != null)
                                    {
                                        @foreach (var mobilenumber in _clsEOGETTenant?.LandLordMobile.Split(","))
                                        {
                                            @if (!string.IsNullOrEmpty(mobilenumber))
                                            {
                                                <div class="otp-option-row">
                                                    <div class="form-check">
                                                        <Radio Value="@(mobilenumber + "%%Mobile")">@(MaskingMethods.MaskUaeNumber(mobilenumber)) (SMS)</Radio>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    }
                                    @if (_clsEOGETTenant != null)
                                    {
                                        @foreach (var emailId in _clsEOGETTenant?.LandLordEmail.Split(","))
                                        {
                                            @if (!string.IsNullOrEmpty(emailId))
                                            {
                                                <div class="otp-option-row">
                                                    <div class="form-check">
                                                        <Radio Value="@(emailId + "%%Email")">@(MaskingMethods.MaskEmail(emailId)) (Email)</Radio>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    }
                                </div>
                            </RadioGroup>
                        </div>
                    } *@
                </Div>
                @if (!string.IsNullOrEmpty(OtpErrorMessage))
                {
                    <div class="alert alert-danger w-100 d-flex align-items-center mb-3" role="alert">
                        <div class="text-center w-100">@OtpErrorMessage</div>
                    </div>
                }
                <div class="button-container otp-modal-actions">
                    <button disabled="@(_otpsendDetails.Length == 0 || OtpSending)"
                            class="btn-proceed btn-proceed-otp"
                            type="button"
                            @onclick="HandleTriggerOtp"
                            id="proceedOtpSendBtn">
                        @(OtpSending ? "Sending…" : "Proceed")
                    </button>
                </div>
            }
            else
            {

                @if (OtpVerifyLoading)
                {
                    <div class="alert alert-info d-flex align-items-center mb-4" role="alert">

                        <div style="text-align: center;margin: unset !important;width: 100%;">
                            Your enter OTP has been verifying...
                        </div>
                    </div>

                }
                else if (NocApplicationProceed)
                {
                    <div class="alert alert-info d-flex align-items-center mb-4" role="alert">

                        <div style="text-align: center;margin: unset !important;width: 100%;">
                            Your Noc Application Under processing.
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-info d-flex align-items-center mb-4" role="alert">

                        <div style="text-align: center;margin: unset !important;width: 100%;">
                            Your OTP has been sent to the @(_otpsendDetails.Contains("Mobile") ? "mobile number" : "email Id")
                            <p style="text-align: center;margin: unset !important;">@(_otpsendDetails.Contains("Mobile") ? MaskingMethods.MaskUaeNumber(_otpsentContact) : MaskingMethods.MaskEmail(_otpsentContact))</p>
                        </div>
                    </div>
                }

                <div class="otp-section">
                    @if (!NocApplicationProceed)
                    {
                        <div>
                            <label class="otp-label">OTP Code</label>
                            <div class="otp-inputs">
                                @* OTP: no Blazor @oninput — avoids 1 SignalR RTT per keystroke; dipNocOtp.wire handles focus instantly *@
                                <input type="text"
                                       maxlength="1"
                                       inputmode="numeric"
                                       pattern="[0-9]"
                                       class="otp-input"
                                       id="otp-input-0"
                                       autocomplete="one-time-code"
                                       placeholder="-" />
                                <input type="text"
                                       maxlength="1"
                                       inputmode="numeric"
                                       pattern="[0-9]"
                                       class="otp-input"
                                       id="otp-input-1"
                                       placeholder="-" />
                                <input type="text"
                                       maxlength="1"
                                       inputmode="numeric"
                                       pattern="[0-9]"
                                       class="otp-input"
                                       id="otp-input-2"
                                       placeholder="-" />
                                <input type="text"
                                       maxlength="1"
                                       inputmode="numeric"
                                       pattern="[0-9]"
                                       class="otp-input"
                                       id="otp-input-3"
                                       placeholder="-" />
                                <input type="text"
                                       maxlength="1"
                                       inputmode="numeric"
                                       pattern="[0-9]"
                                       class="otp-input"
                                       id="otp-input-4"
                                       placeholder="-" />
                                <input type="text"
                                       maxlength="1"
                                       inputmode="numeric"
                                       pattern="[0-9]"
                                       class="otp-input"
                                       id="otp-input-5"
                                       placeholder="-" />
                            </div>
                        </div>
                    }
                    @if (OtpVerifyLoading || NocApplicationProceed)
                    {
                        <div class="w-100 text-center">
                            <div class="text-center">
                                <svg class="progress-icon mb-3" width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M40 7.99998V18H38.836M38.836 18C37.5083 14.7162 35.1286 11.9658 32.0699 10.1797C29.0112 8.3936 25.4464 7.6728 21.9341 8.13026C18.4217 8.58771 15.1604 10.1976 12.6613 12.7075C10.1621 15.2175 8.56631 18.4857 8.124 22M38.836 18H30M8 40V30H9.162M9.162 30C10.4916 33.2818 12.8719 36.0301 15.9303 37.8146C18.9887 39.5991 22.5525 40.319 26.0638 39.8617C29.5751 39.4044 32.8356 37.7957 35.3349 35.2874C37.8343 32.7791 39.4313 29.5129 39.876 26M9.162 30H18" stroke="black" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                                <br />
                                Please Wait...
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex justify-content-center">
                            <button type="button"
                                    class="btn-proceed"
                                    disabled="@(OtpSending || Otpcode.Any(x => string.IsNullOrEmpty(x)))"
                                    @onclick="HandleVerificationOtp">Verify</button>
                        </div>
                        <div class="d-flex justify-content-center p-2">
                            <p>
                                Didn't receive code?
                                <span class="otp-resend @(resendOTPEnable && !OtpSending ? "" : "text-muted")"
                                      style="@(resendOTPEnable && !OtpSending ? "" : "cursor: default; text-decoration: none;")"
                                      @onclick="HandleResendOtpClick">
                                    @(OtpSending ? "Sending…" : resendOTPEnable ? "Resend OTP" : $"Resend OTP in {countdown} seconds")
                                </span>
                            </p>
                        </div>
                        <div class="d-flex justify-content-center">
                            <p>
                                <span class="otp-resend @(OtpSending ? "text-muted" : "")"
                                      style="@(OtpSending ? "cursor: default; text-decoration: none;" : "")"
                                      @onclick="HandleChangeOtpOption">Change OTP option</span>
                            </p>
                        </div>
                    }
                </div>
                @if (!string.IsNullOrEmpty(OtpErrorMessage))
                {
                    <div class="alert alert-danger  w-100 d-flex align-items-center mb-4" role="alert">
                        <div class="text-center">
                            @OtpErrorMessage
                        </div>
                    </div>
                }
            }
        </ModalBody>
    </ModalContent>
</Modal>
</div>

</div>