                                        <div class="text">
                                            <p>@Info?.TypeName</p>
                                        </div>
                                    </div>

                                </div>
                            </div>
                            <div class="col mb-xl-0">
                                <div class="contact_box_content style_two ">
                                    <div class="contact_box_inner color_one head-info">
                                        <div class="text ">
                                            <h3>@L["LicenseIDType"]</h3>
                                        </div>
                                    </div>

                                    <div class="contact_box_inner color_one info-text">
                                        <div class="text">
                                            <p>@Info?.TradeLicenseType</p>
                                        </div>
                                    </div>

                                </div>
                            </div>
                            <div class="col">
                                <div class="contact_box_content style_two ">
                                    <div class="contact_box_inner color_one head-info">
                                        <div class="text ">
                                            <h3>@L["LicenseNumber"]</h3>
                                        </div>
                                    </div>

                                    <div class="contact_box_inner color_one info-text">
                                        <div class="text">
                                            <p>@Info?.TradeLicenseNo</p>
                                        </div>
                                    </div>

                                </div>
                            </div>
                            <div class="col mb-xl-0">
                                <div class="contact_box_content style_two ">
                                    <div class="contact_box_inner color_one head-info">
                                        <div class="text ">
                                            <h3>@L["LicenseExpiry"]</h3>
                                        </div>
