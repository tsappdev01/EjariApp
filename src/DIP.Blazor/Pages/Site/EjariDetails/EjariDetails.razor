                    </section>
                </div>

                <div class="col-md-12">
                    <!--===============spacing==============-->
                    <div class="pd_top_80"></div>
                    <!--===============spacing==============-->
                </div>
            </div>


        </div>
    </section>

    <section class="blog_post_section two_column style_three">

        <div class="auto-container">

            <div class="row align-items-center">
                <div class="col-lg-9">
                    <div class="title_all_box style_seven dark_color">
                        <div class="title_sections">
                            <div class="title fw-normal text-primary-color">@L["ProvideDetails"]</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-12">
                    <!--===============spacing==============-->
                    <div class="pd_bottom_30"></div>
                    <!--===============spacing==============-->
                </div>
            </div>

        </div>

        <div class="auto-container">
            <div class="row">
                <div class="col-lg-12 p-0">
                    <section class="contact_form_box_all type_one">
                        <div class="contact_form_box_inner">
                            <div class="contact_form_shortcode">
                                <div role="form" class="wpcf7">

                                    <EditForm EditContext="EditContextEjariDetails" OnValidSubmit="OnSubmit" class="wpcf7-form init row">
                                        <DataAnnotationsValidator></DataAnnotationsValidator>

                                        <div class="col-md-6">
                                            <p><label>@L["NOCType"]</label></p>
                                            <p>
                                                <label class="d-flex">
                                                    <InputRadioGroup @bind-Value="@NocDetailsDto.NocType">
                                                        

                                                        <span class="wpcf7-form-control-wrap your-name radio-bs">
                                                            <InputRadio  Value="1"
                                                                   type="radio" id="individual" class="radio-s"
                                                                   checked />@L["New"]
                                                        </span>
                                                        <span class="wpcf7-form-control-wrap your-name mx-1 radio-bs">
                                                            <InputRadio   Value="2" id="company"
                                                                   class="radio-s" />@L["Renewal"]
                                                        </span>
                                                        <span class="wpcf7-form-control-wrap your-name mx-1 radio-bs">
                                                            <InputRadio Value="3" id="individual_with_license"
                                                                   class="radio-s" />@L["Catering"]
                                                        </span>
                                                    </InputRadioGroup>
                                               
                                                </label>
                                            </p>
                                            <ValidationMessage For="() => NocDetailsDto.NocType" />

                                        </div>
                                        <div class="col-md-6">
                                            <p>
                                                <label>
                                                    @L["NOCFor"]

                                                </label>
                                            </p>
                                            <p>
                                                <span class="wpcf7-form-control-wrap your-name">
                                                    <select name="service-name"
                                                            @bind="@NocDetailsDto.NOCFor"
                                                            class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required bg-white"
                                                            aria-required="true" aria-invalid="false"
                                                            >
                                                        <option selected Value="">@L["NOCFor"]</option>
                                                        @if(Categories != null)
                                                        @foreach (var category in Categories)
                                                        {
                                                            <option Value="@category.Value">
                                                                @category.Text
                                                            </option>
                                                        }
                                                    </select>
                                                </span>
                                            </p>
                                            <ValidationMessage For="() => NocDetailsDto.NOCFor" />

                                        </div>
                                        <div class="col-md-6 mr_bottom_25">
                                            <p><label> @L["ContractType"]</label></p>
                                            <p>
                                                <label class="d-flex">
                                                    <InputRadioGroup @bind-Value="@NocDetailsDto.ContractType">

                                                    <span class="wpcf7-form-control-wrap your-name radio-bs">
                                                        <InputRadio name=""  Value= "1"
                                                                id="individual" class="radio-s"
                                                                />@L["New"]
                                                    </span>
                                                    <span class="wpcf7-form-control-wrap your-name mx-1 radio-bs">
                                                            <InputRadio type="radio" id="company" Value="2"
                                                               class="radio-s" />@L["Renewal"]
                                                    </span>
                                                    </InputRadioGroup>
                                                </label>
                                            </p>
                                            <ValidationMessage For="() => NocDetailsDto.ContractType" />

                                        </div>
                                        <div class="col-md-6 mr_bottom_25">
                                            <p><label> @L["IsSisterCompany"]</label></p>
                                            
                                            <p>
                                                <label class="d-flex">
                                                    <InputRadioGroup @bind-Value="@NocDetailsDto.IsSisterCompany">
                                                    <span class="wpcf7-form-control-wrap your-name radio-bs">
                                                        <InputRadio  
                                                               id="individual" class="radio-s" Value="1"
                                                               checked />@L["No"]
                                                    </span>
                                                    <span class="wpcf7-form-control-wrap your-name mx-1 radio-bs">
                                                        <InputRadio id="company"  Value="2"
                                                               class="radio-s" />@L["Yes"]
                                                    </span>
                                                    </InputRadioGroup>
                                                </label>
                                            </p>
                                            <ValidationMessage For="() => NocDetailsDto.IsSisterCompany" />

                                        </div>
                                        <div class="col-md-4">
                                            <p>
                                                <label>
                                                    @L["BasicRent"]<br>
                                                    <span class="wpcf7-form-control-wrap your-subject">
                                                        <input type="number" step= "0.01"  @bind-value="@NocDetailsDto.BasicRent" 
                                                               name="your-subject"
                                                               class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required"
                                                               aria-required="true" aria-invalid="false"
                                                               placeholder="@L["BasicRent"]">
                                                    </span>

                                                </label>
                                            </p>
                                            <ValidationMessage For="() => NocDetailsDto.BasicRent" />

                                        </div>
                                        <div class="col-md-4">
                                            <p>
                                                <label>
                                                    @L["SecurityDeposit"]<br>
                                                    <span class="wpcf7-form-control-wrap your-subject">
                                                        <input type="number" step= "0.01"  @bind-value="@NocDetailsDto.SecurityDeposit"
                                                               name="your-subject" 
                                                               class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required"
                                                               aria-required="true" aria-invalid="false"
                                                               placeholder="@L["SecurityDeposit"]">
                                                    </span>
                                                </label>
                                            </p>
                                            <ValidationMessage For="() => NocDetailsDto.SecurityDeposit" />
                                        </div>
                                        <div class="col-md-4">
                                            <p>
                                                <label>
                                                    @L["UnitNames(optional)"]<br>
                                                    <span class="wpcf7-form-control-wrap your-subject">
                                                        <input type="text" @bind-value="@NocDetailsDto.UnitsName"
                                                               name="your-subject" 
                                                               class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required"
                                                               aria-required="true" aria-invalid="false"
                                                               placeholder="@L["UnitNames(optional)"]">
                                                    </span>
                                                </label>
                                            </p>
                                    

                                        </div>
                                        <div class="col-md-6">
                                            <p>
                                                <label>
                                                    @L["NOOfUnits"]<br>
                                                    <span class="wpcf7-form-control-wrap your-subject">
                                                        <input type="number"  @bind-value="@NocDetailsDto.NumberOfUnits"
                                                               
                                                               class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required"
                                                               aria-required="true" aria-invalid="false"
                                                               placeholder="@L["NOOfUnits"]">
                                                    </span>
                                                </label>
                                            </p>
                                           <ValidationMessage For="() => NocDetailsDto.NumberOfUnits" />
                                               
                                        </div>
                                        <div class="col-md-6">
                                            <p>
                                                <label>
                                                   @L["BuildingNames(optional)"]<br>
                                                    <span class="wpcf7-form-control-wrap your-subject">
                                                        <input type="text" @bind-value="@NocDetailsDto.BuildingName"
                                                               name="your-subject" 
                                                               class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required"
                                                               aria-required="true" aria-invalid="false"
                                                               placeholder="@L["BuildingNames(optional)"]">
                                                    </span>
                                                </label>
                                            </p>

                                        </div>

                                        <div class="col-md-6">
                                            <p>
                                                <label>
                                                    @L["ContractFromDate"]<br>
                                                    <span class="wpcf7-form-control-wrap your-subject">
                                                        <input type="date"  @bind-value="@NocDetailsDto.ContractFromDate"
                                                               name="your-subject"
                                                               class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required"
                                                               aria-required="true" aria-invalid="false" >
                                                    </span>
                                                </label>
                                            </p>
                                            <ValidationMessage For="() => NocDetailsDto.ContractFromDate" />

                                        </div>
                                        <div class="col-md-6">
                                            <p>
                                                <label>
                                                   @L["ContractEndDate"]<br>
                                                    <span class="wpcf7-form-control-wrap your-subject">
                                                        <input type="date" @bind-value="@NocDetailsDto.ContractEndDate"
                                                               name="your-subject" 
                                                               class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required"
                                                               aria-required="true" aria-invalid="false" placeholder="">
                                                    </span>
                                                </label>
                                            </p>
                                            <ValidationMessage For="() => NocDetailsDto.ContractEndDate" />

                                        </div>

                                        <div class="col-md-12">
                                            <div class="alert alert-warning mb-4">
                                                <p>
                                                    <ul class="mr_top_15">
                                                        <li>
                                                            @L["OnceYouProceedYouNotBeAbleToEditTheDetails"]
                                                        </li>
                                                        <li>
                                                            @L["PleaseNoteApplicationWillBeProcessedOncePaymentIsSuccessful"]
                                                        </li>
                                                        <li>
                                                            @L["ForAnySupportOrQueriesPleaseContact"] <strong class="fw-500">
                                                               @L["800DIPARK"]
                                                            </strong> @L["OR"]<br> @L["SendEmailTo"] <strong class="fw-500">
                                                                businesscentre@dipark.com /
                                                                accounts@dipark.com
                                                            </strong>
                                                        </li>
                                                    </ul>

                                                </p>
                                            </div>
                                        </div>

                                        <div class="col-md-2">
                                            <p>
                                                <input value="@L["SaveToDraft"]" @onclick="async ()=> await SaveAsDraft()"
                                                       class="wpcf7-form-control has-spinner wpcf7-submit fs-6 theme-btn one" >
                                                    @L["SaveToDraft"]
                                                       </input>
                                            </p>
                                        </div>
                                 @*        @if (GoogleReCaptachDto != null)
                                        {
                                            <p>
                                                <Captcha @ref="captchaComponent" SiteKey="@GoogleReCaptachDto.SiteKey" OnSuccess="OnSuccessCaptchaNocDetails" OnExpired="OnExpiredCaptchaNocDetails"></Captcha>
                                                <ValidationMessage For="() => NocDetailsDto.Captcha" />
                                            </p>
                                        } *@
                                        <div class="col-md-2">
                                            <p>
                                                <input type="submit" disabled="@DisableButton" value="@L["ProceedToUploades"]"
                                                       class="wpcf7-form-control has-spinner wpcf7-submit fs-6 px-1 theme-btn one">
                                            </p>
                                        </div>
                                    </EditForm>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </div>
        <!--===============spacing==============-->
        <div class="pd_top_70"></div>
        <!--===============spacing==============-->
    </section>



</div>         <!--===============PAGE CONTENT END==============-->
      