                                                    </Radio>
                                                </div>
                                            </div>
                                        </RadioGroup>
                                    </div>
                                    <!-- #endregion -->
                                    @* <p class="form-row fs-6 fw-normal mb-0 p-1">
                                        <label>
                                            <input name="" type="radio" id="rememberme" value="forever" checked>
                                        </label>
                                        <span>@L["DirectAccountDebit"]</span>

                                    </p> *@

                                    <p class="form-row fs-6 fw-500 p-1">
                                        <label>
                                            <input name="" type="checkbox" value="forever" class="border-0" checked="@isAgree" @oninput="CheckboxChanged">
                                        </label>
                                        <span>
                                            @(L["AgreePayment"] + " " + (@paymentMethodValue == 1
                                                                                        ? "Internet Banking (Direct Bank Debit)"
                                                                                        : "Credit / Debit Card Payment"))
                                        </span>
                                    </p>

                                    <p>
                                        @L["ClickingConfirmV1"]
                                    </p>
                                </div>

                                <div class="row p-lg-3 px-3 mb-3 text-center">
                                    <Alert Color="Color.Warning" @bind-Visible="@IsError">
                                        <AlertMessage>
                                            @(Errormessage)
                                        </AlertMessage>
                                    </Alert>
                                    <div class="row p-lg-3 px-3 mb-3 text-center">
                                        <div class="theme_btn_all color_one col-md-6 p-0 p-lg-3 mt-3 mb-3">
                                            <button @onclick="@(() => CancelSubmit())" rel="nofollow" class="theme-btn two fs-5 w-100">@L["Cancel"]</button>
                                        </div>
                                        @if (Matrix != null)
                                        {
                                            @if (isAgree)
                                            {
                                                @if (paymentMethodValue == 1)
                                                {
                                                    <div class="theme_btn_all color_one col-md-6 p-0 p-lg-3 mt-3 mb-3">
                                                        <a href="@($"{CultureInfo.CurrentCulture.Name}/UaepgsGateway/Disclaimer/{encryptedReferenceNumber}")" rel="nofollow" class="theme-btn two fs-5 w-100">@L["Confirm"]</a>
                                                    </div>
                                                }
                                                else if (paymentMethodValue == 2)
                                                {
                                                    <div class="theme_btn_all color_one col-md-6 p-0 p-lg-3 mt-3 mb-3">
                                                        <button rel="nofollow" class="theme-btn two fs-5 w-100"
                                                                @onclick="HandleDebitCardPayment">
                                                            @L["Confirm"]
                                                        </button>
                                                    </div>
                                                }
                                            }
                                            @if (!isAgree || disableConfirm)
                                            {
                                                <div style="pointer-events: none;" class="theme_btn_all color_one col-md-6 p-0 p-lg-3 mt-3 mb-3">
                                                    <a href="@($"{CultureInfo.CurrentCulture.Name}/UaepgsGateway/Disclaimer/{encryptedReferenceNumber}")" rel="nofollow" class="theme-btn two fs-5 w-100">@L["Confirm"]</a>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!--===============spacing==============-->
                    <div class="pd_top_70"></div>
                    <!--===============spacing==============-->
                </div>
            </div>
        </div>
        <!--===============spacing==============-->
        <div class="pd_top_70"></div>
        <!--===============spacing==============-->
    </section>



</div>
<!--===============PAGE CONTENT END==============-->
<div id="banks" class="modal_popup modal_popup_support one">
