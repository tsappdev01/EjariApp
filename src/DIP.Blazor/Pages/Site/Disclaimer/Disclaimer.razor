@using DIP.Blazor.Components.Layout;
@using System.Globalization;
@using DIP.Blazor.Shared;
@using System.Collections
@inherits DIPComponentBase
@layout CustomLayout;

@page "/{lang}/UaepgsGateway/Disclaimer/{referenceNumber}";


<PageTitle>
    @PageInfoFrontEnd?.MetaTitle
</PageTitle>
<HeadContent>
    <meta name="description" content="@PageInfoFrontEnd?.MetaDescription">
    <link rel="canonical" href="@NavigationManager.Uri" />
    @if (Lang.Contains("en"))
    {
        <link rel="alternate" href="@NavigationManager.Uri" hreflang="en" />
        <link rel="alternate" href="@UtilClass.UpdateUriByLang(NavigationManager.Uri)" hreflang="ar" />
    }
    else
    {
        <link rel="alternate" href="@NavigationManager.Uri" hreflang="ar" />
        <link rel="alternate" href="@UtilClass.UpdateUriByLang(NavigationManager.Uri)" hreflang="en" />
    }
</HeadContent>



<div class="page_header_default style_one ">
    <div class="parallax_cover">
        <img src="@PageInfoFrontEnd?.HeaderImage" alt="@PageInfoFrontEnd?.Title" class="cover-parallax">
    </div>
    <div class="hero-background-overlay"></div>
    <div class="page_header_content">
        <div class="auto-container">
            <div class="row">
                <div class="col-md-12">
                    <div class="banner_title_inner">
                        <h1 class="title_page">
                            @PageInfoFrontEnd?.Title
                        </h1>
                    </div>
                </div>
                <div class="col-lg-12">
                    <div class="breadcrumbs">
                        <ul class="breadcrumb m-auto">
                            <li><a href="@UtilClass.GetHomeUrlByLang()">@L["Site:Home"]</a> </li>
                            <li>@L["Site:Home:EService"] </li>
                            <li class="active">@L["PaymentDisclaimer"]</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


         <!----page header----->
         
         <!--===============PAGE CONTENT==============-->


<div id="content" class="site-content ">
    <!---image-box-section---->
    <section class="image-box-section py-lg-5 bg_light_1">
        <!--===============spacing==============-->
        <div class="pd_top_80"></div>
        <!--===============spacing==============-->
        <div class="auto-container">
            <div class="row">

                <div class="col-xl-12 col-lg-12">
                    <div class="title_all_box style_one dark_color">
                        <div class="title_sections ">
                            <div class="title text-uppercase mb-3 p-0 text-center d-block">@L["DIPDisclaimerService"]</div>
                            <h3 class="fw-500 fs-2 text-center mb-3">@L["UseOfDirectDepitForOnlinePayment"]</h3>
                            <p>
                                @((MarkupString)PageInfoFrontEnd?.Description) @DateTime.Now.ToString("dd-MM-yyyy HH:mm:ss")

                            </p>

                        </div>
                        <div class="row py-3">

                            <div class="theme_btn_all color_one w-50 text-start px-3 px-md-0">
                                <button rel="nofollow" class="theme-btn two p-1" @onclick="async ()=> await  onDeniedClick()">@L["Denied"]</button>
                            </div>

                            <div class="theme_btn_all color_one w-50 text-end px-3 px-md-0">
                                <button rel="nofollow" class="theme-btn one p-1" onclick="document.getElementById('form').submit()" >@L["IAgree"]</button>
                            </div>

                        </div>
                    </div>
                </div>

            </div>
        </div>
        <!--===============spacing==============-->
        <div class="pd_bottom_80"></div>
        <!--===============spacing==============-->
    </section>
    <!---image-box-section-end---->

</div>         <!--===============PAGE CONTENT END==============-->
  <form  name='form' id="form" asp-controller="Home" asp-action="SetLanguage" action='@url' method="post" role="form">
    @foreach (DictionaryEntry culture in transactionData)
    {
         

             <input type='hidden' name='@culture.Key' value='@culture.Value' /> 
    }
</form>

