@using DIP.Blazor.Components.Layout;
@using System.Globalization;
@using DIP.Blazor.Shared;
@using DIP.Helper
@inherits DIPComponentBase
@layout CustomLayout;

@page "/{lang}/about-us/timeline";

<PageTitle>
    @PageInfoFrontEnd?.MetaTitle
</PageTitle>
<HeadContent>
    <meta name="description" content="@PageInfoFrontEnd?.MetaDescription">
    <link rel="canonical" href="@NavigationManager.Uri" />
    @if (Lang.Contains("en"))
    {
        <link rel="alternate" href="@NavigationManager.Uri" hreflang="en" />
        <link rel="alternate" href="@UtilClass.UpdateUriByLang(NavigationManager.Uri)" hreflang="ar" />
    }
    else
    {
        <link rel="alternate" href="@NavigationManager.Uri" hreflang="ar" />
        <link rel="alternate" href="@UtilClass.UpdateUriByLang(NavigationManager.Uri)" hreflang="en" />
    }
</HeadContent>
<!----page header----->
<div class="page_header_default style_one ">
    <div class="parallax_cover">
        <img src="@PageInfoFrontEnd?.HeaderImage" alt="@PageInfoFrontEnd?.Title" class="cover-parallax">
    </div>
    <div class="hero-background-overlay"></div>
    <div class="page_header_content">
        <div class="auto-container">
            <div class="row">
                <div class="col-md-12">
                    <div class="banner_title_inner">
                        <h1 class="title_page">
                            @PageInfoFrontEnd?.Title
                        </h1>
                    </div>
                </div>
                <div class="col-lg-12">
                    <div class="breadcrumbs">
                        <ul class="breadcrumb m-auto">
                            <li><a href="@UtilClass.GetHomeUrlByLang()">@L["Site:Home"]</a> </li>
                            <li>@L["Site:AboutUs"]</li>
                            <li class="active">@PageInfoFrontEnd?.Title</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!----page header----->
<!--===============PAGE CONTENT==============-->
<!--===============PAGE CONTENT==============-->
@if (!TimeLineCategoryList.IsNullOrEmpty())
{

    <div id="content" class="site-content ">
        <!---image-box-section---->
        <section class="image-box-section py-lg-0">
            <!--===============spacing==============-->
            <!--===============spacing==============-->
            <div class="auto-container">
                <div class="row">

                    <div class="col-xl-12 col-lg-12 p-0">

                        <section id="cd-timeline" class="cd-container">
                            @foreach (var (timeLineCategory, index) in TimeLineCategoryList.WithIndex())
                            {
                                <div class="cd-timeline-block">
                                    <div class="cd-timeline-img cd-picture">
                                        <p>@timeLineCategory.Title</p>
                                    </div> <!-- cd-timeline-img -->
                                        @if (!timeLineCategory.TimeLineFrontEndList.IsNullOrEmpty())
                                        {
                                            <div class="cd-timeline-content">

                                                <div class="image_boxes style_three">
                                                    <div id="carouselExampleControls@(index)" class="carousel slide" data-bs-ride="carousel">
                                                        <div class="carousel-inner">
                                                            <div class="carousel-item active">
                                                                <img src="@timeLineCategory.TimeLineFrontEndList[0].Image" class="img-fluid" alt="@timeLineCategory.TimeLineFrontEndList[0].Title">
                                                                <h2>@timeLineCategory.TimeLineFrontEndList[0].Title</h2>
                                                            @if (timeLineCategory.TimeLineFrontEndList[0].TimeLineDate.HasValue)
                                                            {
                                                              @* <span class="cd-date"> @($"{timeLineCategory.TimeLineFrontEndList[0].TimeLineDate.Value.ToString("MMM")} {timeLineCategory.TimeLineFrontEndList[0].TimeLineDate.Value.Day}")</span> *@
                                                            }
                                                            </div>
                                                            @foreach (var timeLine in timeLineCategory.TimeLineFrontEndList.Skip(1))
                                                            {
                                                                <div class="carousel-item">
                                                                    <img src="@timeLine.Image" class="img-fluid" alt="@timeLine.Title">
                                                                    <h2>@timeLine.Title</h2>
                                                                    @if(timeLine.TimeLineDate.HasValue)
                                                                    {
                                                                       @* <span class="cd-date">@($"{timeLine.TimeLineDate.Value.ToString("MMM")} {timeLine.TimeLineDate.Value.Day}")</span> *@
                                                                    }
                                                                </div>
                                                            }
                                                        </div>
                                                    @if (timeLineCategory.TimeLineFrontEndList.Count > 1)
                                                    {
                                                        <button class="carousel-control-prev" type="button"
                                                                data-bs-target="#carouselExampleControls@(index)" data-bs-slide="prev">
                                                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                                            <span class="visually-hidden">@L["Site:Previous"]</span>
                                                        </button>
                                                        <button class="carousel-control-next" type="button"
                                                                data-bs-target="#carouselExampleControls@(index)" data-bs-slide="next">
                                                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                                            <span class="visually-hidden">@L["Site:Next"]</span>
                                                        </button>
                                                    }
                                                     
                                                    </div>
                                                </div>
                                              @*   <span class="cd-date">@timeLineCategory.Title</span> *@
                                            </div> <!-- cd-timeline-content -->
                                        }

                                    </div> <!-- cd-timeline-block -->
                            }
                     

                        </section>

                    </div>

                </div>
            </div>
            <!--===============spacing==============-->
            <!--===============spacing==============-->
        </section>
        <!---image-box-section-end---->

    </div>         <!--===============PAGE CONTENT END==============-->
         <!--===============PAGE CONTENT END==============-->
      

}
<!--===============PAGE CONTENT END==============-->
<!--===============PAGE CONTENT END==============-->