                                                        @*       <Captcha @ref="captchaComponentRegistration" SiteKey="@GoogleReCaptachDto.SiteKey" OnSuccess="OnSuccessCaptchaRegistration" OnExpired="OnExpiredCaptchaRegistration"></Captcha> *@
                                                        <MathCaptcha OnCaptchaVerified="(result) => OnSuccessCaptchaRegistration(result)" />

