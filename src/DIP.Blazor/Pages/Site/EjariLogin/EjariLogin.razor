                                                                <div style="color: red !important;font-size: 16px;font-family: var(--dip-family-two);font-size: 16px;" class="invalid-feedback d-block validation-message">
                                                                    @* Date must be between @MinDate.ToString("dd-MM-yyyy") and @MaxDate.ToString("dd-MM-yyyy"). *@
