                                                                    @* DateEdit with calendar button using Addons *@
                                                                    <Addons>
                                                                        <Addon AddonType="AddonType.Body">
                                                                            <input type="text" value="@RegistrationDto.ExpiryDate.ToString("dd/MM/yyyy")"
