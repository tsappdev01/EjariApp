                        <div class="row">
                            <div class="col-lg-12 p-0">
                                <div class="head-confirm px-3 py-1">
                                    <h3 class="fs-5 text-capitalize fw-500">@L["PaymentDetails"]</h3>
                                </div>
                                <div class="order-num px-3 py-2 d-none">
                                    <p class="fs-6 mb-0">@L["OrderNo"]: <span class="fw-500">DIPNE7528</span></p>
                                </div>
                                <div class="fact-box acctablebox pt-0">
                                    <table class="rwd-table acctable w-100 payment-details-tb">
                                        <tbody>
                                            <tr>
                                                <th class="bg_light_4 text-center fw-500 fs-6">@L["Select"]</th>
                                                <th class="bg_light_4 text-center fw-500 fs-6">@L["Description"]</th>
                                                <th class="bg_light_4 text-center fw-500 fs-6">@L["Amount(AED)"]</th>
                                                <th class="bg_light_4 text-center fw-500 fs-6">@L["VAT(AED)"]</th>
                                                <th class="bg_light_4 text-center fw-500 fs-6">@L["TotalAmount(AED)"]</th>
                                            </tr>


                                            @if (Matrix != null)
                                                @foreach (var m in Matrix)
                                                {

                                                    <tr class="bg_light_1">
                                                        <td data-th="@L["Select"]">
                                                            <span class="wpcf7-form-control-wrap your-name text-center d-flex justify-content-center">
                                                                <input name="" type="checkbox" id="individual" checked disabled
                                                                       @oninput="@((ChangeEventArgs args) => OnRadioChanged(args, m))" class="radio-s">
                                                            </span>
                                                        </td>
                                                        <td data-th="@L["Description"]">@m.Name</td>
                                                        <td data-th="@L["Amount(AED)"]">@m.TaxableAmount</td>
                                                        <td data-th="@L["VAT(AED)"]">@m.VatAmount</td>
                                                        <td data-th="@L["TotalAmount(AED)"]">@m.ChargeAmount</td>
                                                    </tr>

                                                }

                                            <tr class="bg_light_1">
                                                <td colspan="2" class="text-center">
                                                    <span class="fw-500">@L["GrossTotalInAED"]</span>
                                                </td>
                                                <td colspan="3" class="text-center">
                                                    @String.Format(CultureInfo.GetCultureInfo("en-US"), "{0:0.00}", @TotalAmount)
                                                </td>
                                            </tr>



                                        </tbody>
                                    </table>

                                </div>
                                @* PaymentMethodSelector *@

                                <div class="alert alert-warning mb-0">

                                    <h3 class="fs-6 fw-500">@L["PleaseNote"]:</h3>

                                    <p>@L["EjariChargesIncludes"]</p>
                                    <ul class="mr_top_15 font-italic px-4">
                                        <li>
                                            @L["GovernmentFeesOfAEDVATExempted"]
                                        </li>
                                        <li>
                                            @L["ProcessingFeesOfAEDInclusiveVAT"]
                                        </li>

                                    </ul>
                                    <p>
                                        @L["OnceYouProceedYouWillNotBeAbleToEditTheDetails"]
                                    </p>
                                </div>

                                <div class="row py-3 text-center payment-details-btns">
                                    <div class="theme_btn_all color_one col-md-6">
                                        <button onclick="@(() => CancelSubmit())" rel="nofollow" class="theme-btn two fs-5 w-100">@L["Cancel"]</button>
                                    </div>
                                    <div style="@(TotalAmount > 0 ? "" : "pointer-events: none;")" class="theme_btn_all color_one col-md-6">
                                        <button rel="nofollow" class="theme-btn two fs-5 w-100" @onclick="async () => await onPaySubmit()">@L["Pay"]</button>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                    <!--===============spacing==============-->
                    <div class="pd_top_70"></div>
                    <!--===============spacing==============-->
                </div>


            </div>
        </div>
        <!--===============spacing==============-->
        <div class="pd_top_70"></div>
        <!--===============spacing==============-->
    </section>



</div>
<!--===============PAGE CONTENT END==============-->
