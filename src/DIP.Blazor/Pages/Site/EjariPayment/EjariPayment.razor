                                                    <p class="mb-0">Cheque Payment and Bank Transfer are not accepted only Online Payments are accepted for online application</p>
                                                </div>
                                                @* <div class="col-md-4 align-items-center flex-row mb-2">
                                                    <h3 class="fw-500 fs-4 mr-2">@L["BankName"]</h3>
                                                    <p class="mb-0">Emirates NBD Bank</p>
                                                </div>

                                                <div class="col-md-4 align-items-center flex-row mb-2">
