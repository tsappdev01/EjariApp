                    <div class="col-md-12">
                        <!--===============spacing==============-->
                        <div class="pd_bottom_30"></div>
                        <!--===============spacing==============-->
                    </div>
                    @if (getPaymentHistory != null && getPaymentHistory.Count() > 0)
                    {
                        <div class="auto-container">
                            <div class="row p-0">
                                <div class="col-lg-12 p-0">
                                    <div class="title_all_box style_seven dark_color">
                                        <div class="title_sections">
                                            <div class="title fw-normal text-primary-color">@L["PaymentHistory"]</div>
                                        </div>
                                    </div>
                                </div>

                                <!--===============spacing==============-->
                                <div class="pd_bottom_30"></div>
                                <!--===============spacing==============-->

                                <div class="col-lg-12 p-0">
                                    <div class="fact-box acctablebox">
                                        <table class="rwd-table acctable w-100 payment-details-tb">
                                            <tbody>
                                                <tr>
                                                    <th>@L["BillRefNo"]</th>
                                                    <th>@L["TransacationRefNo"]</th>
                                                    <th>@L["TransacationDate"]</th>
                                                    <th>@L["Amount"]</th>
                                                    <th>@L["Status"]</th>
                                                </tr>
                                                @foreach (var ph in getPaymentHistory)
                                                {
                                                    <tr>
                                                        <td data-th="Service Name" class="fw-bold">@ph.BillRef</td>
                                                        <td data-th="Transacation-no">@ph.TranRefNo</td>
                                                        <td data-th="Transacation date">@ph.TranDate</td>
                                                        <td data-th="Amount">@ph.TranAmount.ToString("0.00")</td>
                                                        <td data-th="Comment" class="wrapok">@ph.PayStatus</td>
                                                    </tr>
                                                }

                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                            </div>
                        </div>
                    }
                    <div class="col-lg-12 p-0 mt-3">
                        <section class="contact_form_box_all type_one">
                            <div class="row alert alert-warning justify-content-center py-3">

                                <div class="col-12 d-flex align-items-center">
                                    <p class="fs-5 mb-0">
                                        <ul>
                                            <li>
                                                @L["PleaseNoteApplicationWillBeProcessedOncePaymentIsSuccessful"]
                                            </li>
                                            <li>
                                                @L["ForAnySupportOrQueriesPleaseContact"]<strong class="fw-500">@L["800DIPARK"]</strong> @L["OR"]<br> @L["SendEmailTo"] <strong class="fw-500">businesscentre@dipark.com / accounts@dipark.com</strong>
                                            </li>
                                        </ul>
                                    </p>
                                </div>

                            </div>
                        </section>
                    </div>





                    <div class="col-md-12">
                        <!--===============spacing==============-->
                        <div class="pd_bottom_30"></div>
                        <!--===============spacing==============-->
                    </div>
                </div>

                <div class="col-lg-5 right_side pd_top_10 p-0">
