                    @* <div class="col-md-12">
                        <!--===============spacing==============-->
                        <div class="pd_bottom_30"></div>
                        <!--===============spacing==============-->
                    </div>


                    <div class="col-lg-12 p-0">
                        <div class="title_all_box style_seven dark_color">
                            <div class="title_sections">
                                <div class="title fw-normal text-primary-color">@L["UploadDepositSlip"]</div>
                            </div>
                        </div>
                    </div> *@

                    <div class="col-md-12">
                        <!--===============spacing==============-->
                        <div class="pd_bottom_30"></div>
                        <!--===============spacing==============-->
                    </div>

                    @* <div class="col-lg-12 p-0">
                        <section class="contact_form_box_all type_one">
                            <div class="row contact_form_box_inner remove-margin justify-content-center py-5">

                                <div class="col-md-7 d-flex align-items-center">

                                    <ul>
