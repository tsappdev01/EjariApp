@using DIP.Blazor.Components.Layout;
@using System.Globalization;
@using DIP.Blazor.Shared;
@using DIP.Settings
@inherits DIPComponentBase
@layout CustomLayout;

@inject IDIPSettingAppService DIPSettingAppService
@page "/{lang}/Ejari/GetDocuments";
@page "/Ejari/GetDocuments";
<PageTitle>
    @PageInfoFrontEnd?.MetaTitle
</PageTitle>

<HeadContent>
    <meta name="description" content="@PageInfoFrontEnd?.MetaDescription">
    <link rel="canonical" href="@NavigationManager.Uri" />
    @if (Lang == null)
    {
        <link rel="alternate" href="@NavigationManager.Uri" hreflang="en" />
        <link rel="alternate" href="@UtilClass.UpdateUriByLang(NavigationManager.Uri)" hreflang="ar" />
    }
    else
    {
        @if (Lang.Contains("en"))
        {
            <link rel="alternate" href="@NavigationManager.Uri" hreflang="en" />
            <link rel="alternate" href="@UtilClass.UpdateUriByLang(NavigationManager.Uri)" hreflang="ar" />
        }
        else
        {
            <link rel="alternate" href="@NavigationManager.Uri" hreflang="ar" />
            <link rel="alternate" href="@UtilClass.UpdateUriByLang(NavigationManager.Uri)" hreflang="en" />
        }
    }

</HeadContent>

<div class="page_header_default style_one ">
    <div class="parallax_cover">
        <img src="@PageInfoFrontEnd?.HeaderImage" alt="@PageInfoFrontEnd?.Title" class="cover-parallax">
    </div>
    <div class="hero-background-overlay"></div>
    <div class="page_header_content">
        <div class="auto-container">
            <div class="row">
                <div class="col-md-12">
                    <div class="banner_title_inner">
                        <h1 class="title_page">
                            @L["GetDocuments"]
                        </h1>
                    </div>
                </div>
                <div class="col-lg-12">
                    <div class="breadcrumbs">
                        <ul class="breadcrumb m-auto">
                            <li><a href="@UtilClass.GetHomeUrlByLang()">@L["Site:Home"]</a> </li>
                            <li>@L["Site:Home:Ejari"]</li>
                            <li class="active">@L["GetDocuments"]</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
         <!----page header----->
         <!--===============PAGE CONTENT==============-->
         <div id="content" class="site-content ">

            <!--feature-->
            <section class="feature-section py-lg-5">
               <!--===============spacing==============-->
               <div class="pd_top_20"></div>
               <!--===============spacing==============-->
               <div class="container">
                  <div class="row justify-content-center">

             

                <div class="col-lg-9 col-md-9 col-sm-12 col-xs-12">
                    <div class="login_left_side p-2 p-lg-5 border rounded_radius-5 bg_light_1">

                           <div class="col-sm-12 text-center mb-4">
                            <h2>
                                @L["NOCEjariOnlineDocuments"]</h2>
                           </div>

                           <div class="login_content_box">
                              <div class="login_forms_box my-3">
                                 
                           
                                 <div class="tab-content" id="pills-tabContent">
                                    <div class="tab-pane fade show active" id="pills-home" role="tabpanel" aria-labelledby="pills-home-tab">

                                        @if (@hasForgetError)
                                        {
                                            <div class="alert alert-danger" role="alert">
                                                @RegisterMessageError
                                            </div>
                                         

                                        }

                                     
                                        <EditForm Model="DocumentDto" OnValidSubmit="OnClickDownload" class="login-register-form login">
                                            <DataAnnotationsValidator></DataAnnotationsValidator>
                                          <p class="form-row ">
                                                <label for="username">@L["ReferenceNumberRegistered"]&nbsp;<span class="required">*</span></label>
                                                <input @bind-value="@DocumentDto.ReferenceNumber" autocomplete="off" name="username" id="username"
                                                       aria-required="true" aria-invalid="false">

                                                <ValidationMessage For="@(() => DocumentDto.ReferenceNumber)" />

                                          </p>
                                            <p class="form-row  ">
                                             <label for="password">@L["DocumentId"]&nbsp;<span class="required">*</span></label>


                                                <span class="d-flex">

                                                    <input @bind-value="@DocumentDto.DocumentId" autocomplete="off" type="number"
                                                           aria-required="true" aria-invalid="false">

                                                </span>
                                            
                                                <ValidationMessage For="@(() => DocumentDto.DocumentId)" />

                                          </p>
                                        <br />
                                       
                                                <p class="mb-5">
                                           
                                                    <MathCaptcha OnCaptchaVerified="(result) => OnSuccessCaptchaForget(result)" />

                                                    <ValidationMessage For="@(() => DocumentDto.Captcha)" />
                                                </p>
                                           
                                          <p class="form-row mt-4 mb-2 text-center">
                                                <button type="submit" disabled="@DisableButton" name="login" value="Log in" class="fs-6">@L["Download"]</button>
                                          </p>

                                        </EditForm>
                                    </div>
                                  
                              </div>
                           </div>
                        </div>
                     </div>

                     

                  </div>

               
               </div>
               </div>
               <!--===============spacing==============-->
               <!--===============spacing==============-->
            </section>
            <!---feature end-->


         </div>
         <!--===============PAGE CONTENT END==============-->
      