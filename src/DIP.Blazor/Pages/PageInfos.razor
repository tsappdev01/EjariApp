

@page "/page-infos"

@attribute [Authorize(DIPPermissions.PageInfos.Default)]
@using DIP.PageInfos
@using DIP.Localization
@using DIP.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Components.Web
@using Blazorise
@using Blazorise.Components
@using Blazorise.DataGrid
@using Volo.Abp.BlazoriseUI
@using Volo.Abp.BlazoriseUI.Components
@using Volo.Abp.ObjectMapping
@using Volo.Abp.AspNetCore.Components.Messages
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout
@using DIP.Permissions
@using Microsoft.AspNetCore.Components
@using Volo.Abp.AspNetCore.Components.Web
@using Volo.Abp.Http.Client
@inherits DIPComponentBase
@inject IPageInfosAppService PageInfosAppService
@inject IUiMessageService UiMessageService
@inject IRemoteServiceConfigurationProvider RemoteServiceConfigurationProvider
@inject NavigationManager NavigationManager

@* ************************* PAGE HEADER ************************* *@
<PageHeader Title="@L["PageInfos"]" BreadcrumbItems="BreadcrumbItems" Toolbar="Toolbar">

</PageHeader>

@* ************************* SEARCH ************************* *@
<Card>
    <CardBody>
        <Form id="PageInfoSearchForm" class="mb-3">
            <Addons>
                <Addon AddonType="AddonType.Body">
                    <TextEdit @bind-Text="@Filter.FilterText"
                              Autofocus="true"
                              Placeholder="@L["Search"]">
                    </TextEdit>
                </Addon>
                <Addon AddonType="AddonType.End">
                    <SubmitButton Form="PageInfoSearchForm" Clicked="GetPageInfosAsync">
                        <Icon Name="IconName.Search" Class="me-1"></Icon>@L["Search"]
                    </SubmitButton>
                </Addon>
            </Addons>
        </Form>
    </CardBody>
</Card>

@* ************************* DATA GRID ************************* *@
<Card>
    <CardBody>
        <DataGrid TItem="PageInfoDto"
                  Data="PageInfoList"
                  ReadData="OnDataGridReadAsync"
                  TotalItems="TotalCount"
                  ShowPager="true"
                  Responsive="true"
                  PageSize="PageSize">
            <DataGridColumns>
                <DataGridEntityActionsColumn TItem="PageInfoDto" @ref="@EntityActionsColumn">
                    <DisplayTemplate>
                        <EntityActions TItem="PageInfoDto" EntityActionsColumn="@EntityActionsColumn">
                            <EntityAction TItem="PageInfoDto"
                                          Visible="@CanEditPageInfo"
                                          Clicked="async () => await OpenEditPageInfoModalAsync(context)"
                                          Text="@L["Edit"]"></EntityAction>
                            <EntityAction TItem="PageInfoDto"
                                          Visible="@CanDeletePageInfo"
                                          Clicked="() => DeletePageInfoAsync(context)"
                                          ConfirmationMessage="@(()=> L["DeleteConfirmationMessage"])"
                                          Text="@L["Delete"]"></EntityAction>
                        </EntityActions>
                    </DisplayTemplate>
                </DataGridEntityActionsColumn>
               
              <DataGridColumn TItem="PageInfoDto"
                      Field="TitleAr"
                      Caption="@L["TitleAr"]">
              </DataGridColumn>

              <DataGridColumn TItem="PageInfoDto"
                      Field="TitleEn"
                      Caption="@L["TitleEn"]">
              </DataGridColumn>

              <DataGridColumn TItem="PageInfoDto"
                      Field="MetaTitleAr"
                      Caption="@L["MetaTitleAr"]">
              </DataGridColumn>

              <DataGridColumn TItem="PageInfoDto"
                      Field="MetaTitleEn"
                      Caption="@L["MetaTitleEn"]">
              </DataGridColumn>

              <DataGridColumn TItem="PageInfoDto"
                      Field="MetaDescriptionEn"
                      Caption="@L["MetaDescriptionEn"]">
              </DataGridColumn>

              <DataGridColumn TItem="PageInfoDto"
                      Field="MetaDescriptionAr"
                      Caption="@L["MetaDescriptionAr"]">
              </DataGridColumn>

              <DataGridColumn TItem="PageInfoDto"
                      Field="Slug"
                      Caption="@L["Slug"]">
              </DataGridColumn>

              <DataGridColumn TItem="PageInfoDto"
                      Field="Image"
                      Caption="@L["Image"]">
              </DataGridColumn>

              <DataGridColumn TItem="PageInfoDto"
                      Field="HeaderImage"
                      Caption="@L["HeaderImage"]">
              </DataGridColumn>

              <DataGridColumn TItem="PageInfoDto"
                      Field="YouTubeUrl"
                      Caption="@L["YouTubeUrl"]">
              </DataGridColumn>

              <DataGridColumn TItem="PageInfoDto"
                      Field="PageInfoArticleTilteEn"
                      Caption="@L["PageInfoArticleTilteEn"]">
              </DataGridColumn>

              <DataGridColumn TItem="PageInfoDto"
                      Field="PageInfoArticleTilteAr"
                      Caption="@L["PageInfoArticleTilteAr"]">
              </DataGridColumn>

              <DataGridColumn TItem="PageInfoDto"
                      Field="PageInfoArticleSubtitleEn"
                      Caption="@L["PageInfoArticleSubtitleEn"]">
              </DataGridColumn>

              <DataGridColumn TItem="PageInfoDto"
                      Field="PageInfoArticleSubtitleAr"
                      Caption="@L["PageInfoArticleSubtitleAr"]">
              </DataGridColumn>

              <DataGridColumn TItem="PageInfoDto"
                      Field="DescriptionAr"
                      Caption="@L["DescriptionAr"]">
              </DataGridColumn>

              <DataGridColumn TItem="PageInfoDto"
                      Field="DescriptionEn"
                      Caption="@L["DescriptionEn"]">
              </DataGridColumn>

              <DataGridColumn TItem="PageInfoDto"
                      Field="SummaryEn"
                      Caption="@L["SummaryEn"]">
              </DataGridColumn>

              <DataGridColumn TItem="PageInfoDto"
                      Field="SummaryAr"
                      Caption="@L["SummaryAr"]">
              </DataGridColumn>

              <DataGridColumn TItem="PageInfoDto"
                      Field="Order"
                      Caption="@L["Order"]">
              </DataGridColumn>

              <DataGridColumn TItem="PageInfoDto"
                      Field="IsActive"
                      Caption="@L["IsActive"]">
                    <DisplayTemplate>
                        @if (context.IsActive)
                        {
                            <Icon TextColor="TextColor.Success" Name="@IconName.Check" />
                        }
                        else
                        {
                            <Icon TextColor="TextColor.Danger" Name="@IconName.Times" />
                        }
                    </DisplayTemplate>
              </DataGridColumn>


            </DataGridColumns>
        </DataGrid>
    </CardBody>
</Card>

@* ************************* CREATE MODAL ************************* *@
