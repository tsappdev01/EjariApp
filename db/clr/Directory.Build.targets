<Project>
  <!-- SQL CLR assemblies: .NET Framework 4.8, same identity (1.0.0.0, unsigned) as the originals so
       ALTER ASSEMBLY can replace them in place. -->
  <PropertyGroup Condition="'$(IsClrAssembly)' == 'true'">
    <Version>1.0.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsClrAssembly)' == 'true'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Data" />
    <Reference Include="System.Core" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared\AesUrl.cs" Link="Shared\AesUrl.cs" />
  </ItemGroup>
  <!-- Writes obj/.../ClrKeys.g.cs from CLR_AES_KEY / CLR_AES_IV, failing the build
       if either is missing or the wrong length. -->
  <UsingTask TaskName="GenerateClrKeys" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Key ParameterType="System.String" Required="false" />
      <IV ParameterType="System.String" Required="false" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        byte[] key = null, iv = null;
        try { key = System.Convert.FromBase64String(Key ?? ""); iv = System.Convert.FromBase64String(IV ?? ""); }
        catch (System.FormatException) { }
        if (key == null || key.Length != 32 || iv == null || iv.Length != 16)
        {
            Log.LogError("CLR_AES_KEY must be base64 of 32 bytes and CLR_AES_IV base64 of 16 bytes. " +
                         "Set them as environment variables (or pass -p:ClrAesKey=... -p:ClrAesIV=...). See db/clr/README.md.");
            return false;
        }
        var text = "// <auto-generated/> Generated from CLR_AES_KEY / CLR_AES_IV. Do not commit.\n" +
                   "namespace DubaiInvestment.PMS.Clr\n{\n    internal static class ClrKeys\n    {\n" +
                   "        internal static readonly byte[] Key = System.Convert.FromBase64String(\"" + Key + "\");\n" +
                   "        internal static readonly byte[] IV = System.Convert.FromBase64String(\"" + IV + "\");\n" +
                   "    }\n}\n";
        System.IO.Directory.CreateDirectory(System.IO.Path.GetDirectoryName(OutputFile));
        if (!System.IO.File.Exists(OutputFile) || System.IO.File.ReadAllText(OutputFile) != text)
            System.IO.File.WriteAllText(OutputFile, text);
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- Writes bin/.../deploy.sql: trusts the assembly's hash, creates or replaces it
       as SAFE, then creates its functions from functions.sql if they are absent. -->
  <UsingTask TaskName="GenerateClrDeploySql" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <AssemblyPath ParameterType="System.String" Required="true" />
      <AssemblyName ParameterType="System.String" Required="true" />
      <FunctionsFile ParameterType="System.String" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        var bytes = System.IO.File.ReadAllBytes(AssemblyPath);
        string hash, hex;
        using (var sha = System.Security.Cryptography.SHA512.Create())
            hash = "0x" + System.BitConverter.ToString(sha.ComputeHash(bytes)).Replace("-", "");
        hex = "0x" + System.BitConverter.ToString(bytes).Replace("-", "");
        var n = AssemblyName;
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("-- Generated by the db/clr build for [" + n + "]. The binary embeds the AES key: do not commit or share.");
        sb.AppendLine("SET ANSI_NULLS ON;");
        sb.AppendLine("SET QUOTED_IDENTIFIER ON;");
        sb.AppendLine("GO");
        sb.AppendLine("IF NOT EXISTS (SELECT 1 FROM sys.trusted_assemblies WHERE hash = " + hash + ")");
        sb.AppendLine("    EXEC sys.sp_add_trusted_assembly @hash = " + hash + ", @description = N'" + n + " 1.0.0.0 (SAFE)';");
        sb.AppendLine("GO");
        sb.AppendLine("-- Re-verifies every table whose persisted values depend on a replaced assembly.");
        sb.AppendLine("-- CHECKTABLE recomputes them with the installed binary and clears the table's");
        sb.AppendLine("-- has_unchecked_assembly_data flag only if every value matches. It cannot run");
        sb.AppendLine("-- inside a transaction here (it would not see the uncommitted assembly), hence");
        sb.AppendLine("-- the restore-on-failure below instead of a rollback.");
        sb.AppendLine("CREATE OR ALTER PROCEDURE #VerifyUncheckedAssemblyData");
        sb.AppendLine("AS");
        sb.AppendLine("BEGIN");
        sb.AppendLine("    DECLARE @t nvarchar(600);");
        sb.AppendLine("    DECLARE c CURSOR LOCAL FAST_FORWARD FOR");
        sb.AppendLine("        SELECT QUOTENAME(SCHEMA_NAME(schema_id)) + N'.' + QUOTENAME(name) FROM sys.tables WHERE has_unchecked_assembly_data = 1;");
        sb.AppendLine("    OPEN c;");
        sb.AppendLine("    FETCH NEXT FROM c INTO @t;");
        sb.AppendLine("    WHILE @@FETCH_STATUS = 0");
        sb.AppendLine("    BEGIN");
        sb.AppendLine("        PRINT N'Verifying ' + @t;");
        sb.AppendLine("        DBCC CHECKTABLE (@t) WITH EXTENDED_LOGICAL_CHECKS, NO_INFOMSGS;");
        sb.AppendLine("        FETCH NEXT FROM c INTO @t;");
        sb.AppendLine("    END");
        sb.AppendLine("    CLOSE c;");
        sb.AppendLine("    DEALLOCATE c;");
        sb.AppendLine("END");
        sb.AppendLine("GO");
        sb.AppendLine("-- Create the assembly, or replace it in place. If any stored value that depends");
        sb.AppendLine("-- on it differs from what the new binary computes (a wrong key, for instance),");
        sb.AppendLine("-- the previous binary is put back and the script fails.");
        sb.AppendLine("SET XACT_ABORT OFF;");
        sb.AppendLine("DECLARE @old varbinary(max), @oldPermission nvarchar(20), @sql nvarchar(200);");
        sb.AppendLine("IF NOT EXISTS (SELECT 1 FROM sys.assemblies WHERE name = N'" + n + "')");
        sb.AppendLine("BEGIN");
        sb.AppendLine("    CREATE ASSEMBLY [" + n + "] FROM " + hex + " WITH PERMISSION_SET = SAFE;");
        sb.AppendLine("    PRINT N'" + n + " created.';");
        sb.AppendLine("END");
        sb.AppendLine("ELSE IF EXISTS (SELECT 1 FROM sys.assembly_files f JOIN sys.assemblies a ON a.assembly_id = f.assembly_id");
        sb.AppendLine("                WHERE a.name = N'" + n + "' AND f.file_id = 1 AND f.content = " + hex + ")");
        sb.AppendLine("    PRINT N'" + n + " is already this build.';");
        sb.AppendLine("ELSE");
        sb.AppendLine("BEGIN");
        sb.AppendLine("    SELECT @old = f.content,");
        sb.AppendLine("           @oldPermission = CASE a.permission_set WHEN 1 THEN N'SAFE' WHEN 2 THEN N'EXTERNAL_ACCESS' ELSE N'UNSAFE' END");
        sb.AppendLine("    FROM sys.assembly_files f JOIN sys.assemblies a ON a.assembly_id = f.assembly_id");
        sb.AppendLine("    WHERE a.name = N'" + n + "' AND f.file_id = 1;");
        sb.AppendLine("    BEGIN TRY");
        sb.AppendLine("        -- UNCHECKED DATA: persisted computed columns (MaintainEORegistrations.EncryptedRefNo) depend on it.");
        sb.AppendLine("        ALTER ASSEMBLY [" + n + "] FROM " + hex + " WITH PERMISSION_SET = SAFE, UNCHECKED DATA;");
        sb.AppendLine("    END TRY");
        sb.AppendLine("    BEGIN CATCH");
        sb.AppendLine("        -- 6288 only reports that dependent data is now unchecked; it is verified next.");
        sb.AppendLine("        IF ERROR_NUMBER() <> 6288 THROW;");
        sb.AppendLine("    END CATCH;");
        sb.AppendLine("    EXEC #VerifyUncheckedAssemblyData;");
        sb.AppendLine("    IF EXISTS (SELECT 1 FROM sys.tables WHERE has_unchecked_assembly_data = 1)");
        sb.AppendLine("    BEGIN");
        sb.AppendLine("        PRINT N'Verification failed: restoring the previous " + n + ".';");
        sb.AppendLine("        SET @sql = N'ALTER ASSEMBLY [" + n + "] FROM @bits WITH PERMISSION_SET = ' + @oldPermission + N', UNCHECKED DATA';");
        sb.AppendLine("        BEGIN TRY");
        sb.AppendLine("            EXEC sys.sp_executesql @sql, N'@bits varbinary(max)', @bits = @old;");
        sb.AppendLine("        END TRY");
        sb.AppendLine("        BEGIN CATCH");
        sb.AppendLine("            IF ERROR_NUMBER() <> 6288 THROW;");
        sb.AppendLine("        END CATCH;");
        sb.AppendLine("        EXEC #VerifyUncheckedAssemblyData;");
        sb.AppendLine("        THROW 50000, N'" + n + ": stored values do not match the new assembly (wrong key or IV?). The previous assembly was restored; nothing changed.', 1;");
        sb.AppendLine("    END");
        sb.AppendLine("    PRINT N'" + n + " replaced and verified.';");
        sb.AppendLine("END");
        sb.AppendLine("GO");
        sb.AppendLine("DROP PROCEDURE IF EXISTS #VerifyUncheckedAssemblyData;");
        sb.AppendLine("GO");
        sb.Append(System.IO.File.ReadAllText(FunctionsFile));
        System.IO.File.WriteAllText(OutputFile, sb.ToString());
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="GenerateClrKeysFile" BeforeTargets="CoreCompile" Condition="'$(UsesClrKeys)' == 'true'">
    <PropertyGroup>
      <ClrKeysFile>$(IntermediateOutputPath)ClrKeys.g.cs</ClrKeysFile>
    </PropertyGroup>
    <GenerateClrKeys Key="$(ClrAesKey)" IV="$(ClrAesIV)" OutputFile="$(ClrKeysFile)" />
    <ItemGroup>
      <Compile Include="$(ClrKeysFile)" />
    </ItemGroup>
  </Target>

  <Target Name="GenerateClrDeploy" AfterTargets="Build" Condition="'$(IsClrAssembly)' == 'true'">
    <GenerateClrDeploySql AssemblyPath="@(IntermediateAssembly->'%(FullPath)')" AssemblyName="$(AssemblyName)"
                          FunctionsFile="$(MSBuildProjectDirectory)\functions.sql"
                          OutputFile="$(OutDir)deploy-$(AssemblyName).sql" />
    <Message Importance="high" Text="$(AssemblyName) -> $(OutDir)deploy-$(AssemblyName).sql" />
  </Target>
</Project>
