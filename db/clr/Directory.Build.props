<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <!-- The key and IV come from the environment, never from source. -->
    <ClrAesKey Condition="'$(ClrAesKey)' == ''">$(CLR_AES_KEY)</ClrAesKey>
    <ClrAesIV Condition="'$(ClrAesIV)' == ''">$(CLR_AES_IV)</ClrAesIV>
  </PropertyGroup>

</Project>
